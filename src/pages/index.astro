---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Home"
  description="MBS Medical: Veteran-owned telehealth providing primary care, weight loss, mental health, and more across Florida. Cash pay, same-week appointments."
>

  <!-- ============================================================
       HERO — full-bleed flag video with glass text panel on the right
       ============================================================ -->
  <section class="hero-fullbleed">
    <video
      id="hero-flag-video"
      class="hero-fullbleed__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/images/flag-intro.mp4" type="video/mp4" />
    </video>
    <div id="hero-flag-scrim" class="hero-fullbleed__scrim" aria-hidden="true"></div>

    <div class="hero-fullbleed__grid container">
      <div class="hero-fullbleed__text">
        <span class="hero-fullbleed__eyebrow">Veteran-owned &mdash; Florida telehealth</span>
        <h1 class="hero-fullbleed__title">
          Healthcare that treats<br />the whole person.
        </h1>
        <p class="hero-fullbleed__sub">
          One consistent provider. No insurance required. Same-week appointments across Florida, from wherever you are.
        </p>
        <div class="hero-fullbleed__actions">
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-hero-primary">
            book a visit
          </a>
          <a href="/services/" class="btn btn-hero-secondary">
            explore services
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Stop the flag animation after 10 seconds; deepen the scrim slightly so
    // text stays readable on the frozen frame.
    const heroVid = document.getElementById('hero-flag-video') as HTMLVideoElement | null;
    const heroScrim = document.getElementById('hero-flag-scrim');
    if (heroVid) {
      setTimeout(() => {
        try { heroVid.pause(); } catch {}
        if (heroScrim) heroScrim.classList.add('is-paused');
      }, 10000);
    }
  </script>


  <!-- ============================================================
       VALUE PROPS — cream surface, 3 columns
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal value-header">
        <span class="label">why mbs medical</span>
        <h2>Care built differently</h2>
      </div>

      <div class="value-grid">
        <div class="reveal value-card">
          <span class="value-accent value-accent--coral" aria-hidden="true"></span>
          <h3>Whole-person care</h3>
          <p>We treat you, not a symptom list. Mental, physical, and preventive health addressed by one provider who knows your full history.</p>
        </div>
        <div class="reveal reveal-delay-1 value-card value-card--filled">
          <span class="value-accent value-accent--sage" aria-hidden="true"></span>
          <h3>No insurance needed</h3>
          <p>Cash pay keeps it simple. No referrals, no prior authorizations, no surprise bills. Transparent pricing, real care.</p>
        </div>
        <div class="reveal reveal-delay-2 value-card">
          <span class="value-accent value-accent--sky" aria-hidden="true"></span>
          <h3>Telehealth, statewide</h3>
          <p>Secure video visits from your home, office, or anywhere in Florida. Evening appointments available. Same-week booking.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 1 — medical weight loss, full-bleed image hero variant
       ============================================================ -->
  <section class="section home-feature-fullwidth">
    <img
      src="/images/home-weight-loss-hero-v2.png"
      alt="Medical weight loss at MBS Medical"
      class="home-feature-fullwidth__bg"
    />
    <div class="home-feature-fullwidth__overlay" aria-hidden="true"></div>
    <div class="container home-feature-fullwidth__container">
      <div class="home-feature-fullwidth__text">
        <span class="editorial-eyebrow home-feature-fullwidth__eyebrow">medical weight loss</span>
        <h2 class="home-feature-fullwidth__title">Finally, a weight loss plan that sticks.</h2>
        <p class="home-feature-fullwidth__body">
          GLP-1 receptor agonists have changed what's medically possible for weight management. We evaluate whether they're right for you, with real labs, honest conversation, and a plan built around your life.
        </p>
        <div class="home-feature-fullwidth__actions">
          <a href="/weight-loss/" class="home-feature-fullwidth__cta">
            learn more
          </a>
          <a
            href="https://mbsmedical.practicebetter.io"
            target="_blank"
            rel="noopener noreferrer"
            class="home-feature-fullwidth__cta home-feature-fullwidth__cta--ghost"
          >
            book a visit
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 2 — men's health / TRT, sand surface, terracotta
       image RIGHT, text LEFT (flip)
       ============================================================ -->
  <section class="section bg-sand">
    <div class="container">
      <div class="feature-row feature-row--flip reveal">
        <div class="feature-row__media">
          <img src="/images/home-mens-health.jpg" alt="Active man in his prime" class="feature-img" loading="lazy" decoding="async" />
        </div>
        <div class="feature-row__text">
          <span class="accent-chip chip-terracotta">men's health</span>
          <h2>Get your edge back</h2>
          <p>Testosterone naturally declines after 30. Less energy, slower recovery, lower drive. Most men push through it and call it aging. You don't have to.</p>
          <p style="margin-top: 1rem; color: var(--ink-secondary);">We start with labs for a clear, honest picture. If TRT is right for you, we build a plan. If it's not, we'll tell you that too.</p>
          <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/mens-health/" class="btn btn-primary">learn more</a>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">book a visit</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 3 — mental health, shell surface, sky accent
       image LEFT, text RIGHT
       ============================================================ -->
  <section class="section bg-shell">
    <div class="container">
      <div class="feature-row reveal">
        <div class="feature-row__media">
          <img src="/images/home-mental-health.jpg" alt="Peaceful morning bedroom" class="feature-img" loading="lazy" decoding="async" />
        </div>
        <div class="feature-row__text">
          <span class="accent-chip chip-sky">mental health</span>
          <h2>Sleep, anxiety, and what's keeping you stuck</h2>
          <p>Restless nights. A mind that won't slow down. A fog that follows you into the day. These aren't just inconveniences. They're treatable.</p>
          <p style="margin-top: 1rem; color: var(--ink-secondary);">We take mental health seriously as a part of whole-person care, not a referral you never follow through on.</p>
          <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/mental-health/" class="btn btn-primary">learn more</a>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">book a visit</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       STATS — ink surface with subtle aerial backdrop
       ============================================================ -->
  <section class="section bg-ink stats-section">
    <img src="/images/sig-stats-bg.jpg" alt="" class="stats-section__bg" aria-hidden="true" />
    <div class="container" style="position: relative; z-index: 1;">
      <div class="reveal" style="text-align: center; margin-bottom: 3rem;">
        <h2 style="color: var(--ink-inverse);">Numbers that mean something</h2>
      </div>
      <div class="stats-row">
        <div class="reveal stat-item">
          <div class="stat-item__number" style="color: var(--ink-inverse);">64+</div>
          <div class="stat-item__label" style="color: rgba(250,246,240,0.55);">years combined experience</div>
        </div>
        <div class="reveal reveal-delay-1 stat-item">
          <div class="stat-item__number" style="color: var(--ink-inverse);">11</div>
          <div class="stat-item__label" style="color: rgba(250,246,240,0.55);">specialties offered</div>
        </div>
        <div class="reveal reveal-delay-2 stat-item">
          <div class="stat-item__number" style="color: var(--accent-terracotta);">FL</div>
          <div class="stat-item__label" style="color: rgba(250,246,240,0.55);">statewide telehealth</div>
        </div>
        <div class="reveal reveal-delay-3 stat-item">
          <div class="stat-item__number" style="color: var(--ink-inverse);">12</div>
          <div class="stat-item__label" style="color: rgba(250,246,240,0.55);">years U.S. Army, founder</div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       TESTIMONIALS — cream surface so dark serif quote cards stand out
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal" style="margin-bottom: 3rem; text-align: center;">
        <span class="editorial-eyebrow">Patient stories</span>
        <h2 style="margin-top: 0.75rem; font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4.5vw, 3rem);">What our patients are saying.</h2>
      </div>

      <div class="testimonials-grid">
        <div class="reveal testimonial-card">
          <p class="testimonial-quote">finally a provider who listened. not just to my symptoms, but to my actual life. i've never felt more cared for by a doctor.</p>
          <p class="testimonial-attr">Primary Care Patient &mdash; Sarasota, FL</p>
        </div>
        <div class="reveal reveal-delay-1 testimonial-card">
          <p class="testimonial-quote">i was skeptical about telehealth but the experience was better than any in-person visit i've had. same-week appointment, provider knew my chart.</p>
          <p class="testimonial-attr">Weight Loss Patient &mdash; Tampa, FL</p>
        </div>
        <div class="reveal reveal-delay-2 testimonial-card">
          <p class="testimonial-quote">david took my testosterone concerns seriously from the first call. within a month i felt like myself again. the lab-driven approach made all the difference.</p>
          <p class="testimonial-attr">Men's Health Patient &mdash; Bradenton, FL</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       HOW IT WORKS — cream surface
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal" style="text-align: center; margin-bottom: 3.5rem;">
        <span class="label">how it works</span>
        <h2 style="margin-top: 0.75rem;">Three steps to better care</h2>
      </div>

      <div class="steps-grid">
        <div class="reveal step-card">
          <h3 style="margin-bottom: 0.875rem;">Book online</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Pick a time through our secure portal. Same-week availability, with evening appointments included. No waiting rooms.</p>
        </div>
        <div class="reveal reveal-delay-1 step-card">
          <h3 style="margin-bottom: 0.875rem;">Meet your provider</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Secure video visit from anywhere in Florida. Real conversation with a provider who has time for you.</p>
        </div>
        <div class="reveal reveal-delay-2 step-card">
          <h3 style="margin-bottom: 0.875rem;">Get your plan</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">A personalized care plan with ongoing support, medication management, and follow-ups that evolve with you.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FAQ — shell surface
       ============================================================ -->
  <section class="section bg-shell">
    <div class="container">
      <div class="reveal faq-layout">
        <div class="faq-heading">
          <span class="editorial-eyebrow">Common questions</span>
          <h2 style="margin-top: 1rem; font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.1; letter-spacing: -0.015em;">Things people usually ask.</h2>
          <p style="color: var(--ink-secondary); margin-top: 1rem; font-size: var(--text-sm);">Don't see your question? <a href="/contact/" style="text-decoration: underline; text-underline-offset: 3px;">Contact us directly.</a></p>
          <div class="home-faq-frame" aria-hidden="true">
            <img src="/images/sig-leaf.jpg" alt="" />
          </div>
        </div>

        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-summary">do i need insurance to use MBS Medical?</summary>
            <p class="faq-body">No. We are a cash-pay practice. You pay directly, which keeps things simple, transparent, and without the delays that come with insurance. We can provide a superbill for FSA/HSA reimbursement if needed.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">what states do you serve?</summary>
            <p class="faq-body">We are licensed to provide telehealth services to patients located in Florida. You must be physically in Florida at the time of your visit.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">how quickly can i get an appointment?</summary>
            <p class="faq-body">We offer same-week appointments and often same-day or next-day availability. Evening slots are included. Book through our secure online portal anytime.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">will i see the same provider every time?</summary>
            <p class="faq-body">Yes. Continuity of care is one of the core values of this practice. You'll build a relationship with your provider who knows your history, your medications, and your goals.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">can you prescribe medications?</summary>
            <p class="faq-body">Yes. Our providers are licensed to evaluate, diagnose, and prescribe medications including controlled substances where appropriate and legal. Prescriptions are sent electronically to your preferred pharmacy.</p>
          </details>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       CLOSING CTA — rounded big-card on cream (MBS-Test signature)
       ============================================================ -->
  <section class="section bg-cream cta-section">
    <div class="container">
      <div class="reveal cta-card">
        <img src="/images/sig-cta-dark.jpg" alt="" class="cta-card__bg" aria-hidden="true" />
        <span class="cta-card__deco cta-card__deco--tr" aria-hidden="true"></span>
        <span class="cta-card__deco cta-card__deco--bl" aria-hidden="true"></span>
        <div class="cta-card__inner">
          <span class="cta-card__eyebrow">Ready when you are</span>
          <h2 class="cta-card__title">The care you've always deserved.</h2>
          <p class="cta-card__sub">
            Veteran-owned. Patient-first. No insurance required. Same-week telehealth across Florida, from a provider who shows up for you.
          </p>
          <div class="cta-card__actions">
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="cta-card__btn cta-card__btn--primary">
              book a free consultation
            </a>
            <a href="/contact/" class="cta-card__btn cta-card__btn--ghost">
              ask a question
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  /* ---- Full-bleed feature hero (medical weight loss section) ----
     Same shape and depth treatment as the service-page fullwidth heroes:
     image cover, dark gradient text overlay, hairline borders + vignette. */
  .home-feature-fullwidth {
    position: relative;
    padding: 0;
    /* Cinematic stage at a measured height: tall enough to read as a
       hero, short enough that the 2.33:1 image renders with minimal
       crop so the figure stays fully in frame. */
    min-height: 72vh;
    overflow: hidden;
    background-color: var(--color-primary);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -90px 130px -40px rgba(0, 0, 0, 0.55),
      inset 0 60px 130px -40px rgba(0, 0, 0, 0.32),
      inset 110px 0 130px -80px rgba(0, 0, 0, 0.38),
      inset -110px 0 130px -80px rgba(0, 0, 0, 0.38),
      0 24px 44px -28px rgba(0, 0, 0, 0.35);
  }
  .home-feature-fullwidth__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Cover so the image fills the cinematic 100vh frame without
       letterboxing. Object-position biased left so the woman stays in
       view as the right-side gradient takes over for the text overlay. */
    object-fit: cover;
    object-position: 30% center;
    z-index: 0;
  }
  @media (max-width: 767px) {
    .home-feature-fullwidth__bg {
      object-position: center center;
    }
  }
  .home-feature-fullwidth__overlay {
    position: absolute;
    inset: 0;
    /* Dark gradient on the right where the text sits, fading to
       transparent on the left so the image reads cleanly. */
    background: linear-gradient(
      260deg,
      rgba(60, 56, 54, 0.78) 0%,
      rgba(60, 56, 54, 0.50) 35%,
      rgba(60, 56, 54, 0.15) 65%,
      rgba(60, 56, 54, 0) 100%
    );
    z-index: 1;
  }
  .home-feature-fullwidth__container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 72vh;
    padding-top: 5rem;
    padding-bottom: 4rem;
  }
  .home-feature-fullwidth__text {
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .home-feature-fullwidth__eyebrow {
    color: var(--color-neutral);
  }
  .home-feature-fullwidth__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.018em;
    color: #ffffff;
    margin: 0;
    max-width: 22ch;
  }
  .home-feature-fullwidth__body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.85);
    max-width: 52ch;
    margin: 0;
  }
  .home-feature-fullwidth__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .home-feature-fullwidth__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px 34px;
    border-radius: 999px;
    border: 1.5px solid #ffffff;
    background-color: #ffffff;
    color: var(--color-primary);
    text-decoration: none;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
    white-space: nowrap;
  }
  .home-feature-fullwidth__cta:hover {
    background-color: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }
  .home-feature-fullwidth__cta--ghost {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.92);
    border-color: rgba(255, 255, 255, 0.55);
  }
  .home-feature-fullwidth__cta--ghost:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: #ffffff;
    border-color: #ffffff;
  }
  .home-feature-fullwidth__cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }
  @media (max-width: 767px) {
    .home-feature-fullwidth {
      min-height: 70vh;
    }
    .home-feature-fullwidth__container {
      min-height: 70vh;
      padding-top: 4rem;
      padding-bottom: 3rem;
    }
  }

  /* ---- Full-bleed flag hero with glass text panel on the right ---- */
  .hero-fullbleed {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background-color: var(--surface-ink);
    display: flex;
    align-items: center;
    padding-top: 68px;
  }
  .hero-fullbleed__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  /* Right-side scrim: text sits right over the flag, scrim darkens
     the right half so the copy reads cleanly while the flag breathes
     on the left. */
  .hero-fullbleed__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(26,26,24,0.10) 0%,
        rgba(26,26,24,0.20) 35%,
        rgba(26,26,24,0.60) 70%,
        rgba(26,26,24,0.80) 100%
      );
    pointer-events: none;
    transition: background 1200ms ease;
  }
  /* When the video pauses at 10s, slightly deepen the scrim */
  .hero-fullbleed__scrim.is-paused {
    background:
      linear-gradient(
        90deg,
        rgba(26,26,24,0.20) 0%,
        rgba(26,26,24,0.35) 35%,
        rgba(26,26,24,0.70) 70%,
        rgba(26,26,24,0.86) 100%
      );
  }

  .hero-fullbleed__grid {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    padding-block: 4rem;
  }
  @media (min-width: 900px) {
    .hero-fullbleed__grid {
      grid-template-columns: 1fr minmax(440px, 580px);
      gap: 3rem;
    }
  }

  /* Frame-less text block, anchored right on desktop */
  .hero-fullbleed__text {
    max-width: 580px;
    color: var(--color-neutral);
    grid-column: 1;
    text-shadow: 0 2px 10px rgba(0,0,0,0.35);
  }
  @media (min-width: 900px) {
    .hero-fullbleed__text {
      grid-column: 2;
      justify-self: end;
    }
  }

  .hero-fullbleed__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: 1.25rem;
    text-shadow: 0 1px 8px rgba(0,0,0,0.55);
  }
  .hero-fullbleed__title {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: var(--text-5xl);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--ink-inverse);
    margin-bottom: 1.5rem;
  }
  .hero-fullbleed__sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(250,246,240,0.92);
    margin-bottom: 2rem;
    max-width: 44ch;
    font-weight: var(--weight-regular);
  }
  .hero-fullbleed__actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  /* Hero buttons: frame-free, high-contrast without a card behind them */
  .btn-hero-primary,
  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1;
    text-transform: lowercase;
    padding: 14px 32px;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    text-decoration: none;
    transition: background-color var(--dur-base), color var(--dur-base),
                border-color var(--dur-base), transform var(--dur-fast);
    text-shadow: none;
    letter-spacing: 0;
  }
  .btn-hero-primary {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }
  .btn-hero-primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
  .btn-hero-secondary {
    background-color: rgba(250,246,240,0.12);
