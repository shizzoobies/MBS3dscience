---
/**
 * Shared service page template.
 * Follows design-system.md page anatomy:
 * hero → value props → zigzag features → testimonials → how it works → faq → cta
 */

import Layout from '../layouts/Layout.astro';
import MembershipPricing from './MembershipPricing.astro';
import HeroMembershipCard from './HeroMembershipCard.astro';
import TestosteroneGraph from './TestosteroneGraph.astro';
import FaqCaduceus from './react/FaqCaduceus.tsx';
import DnaHelix from './react/DnaHelix.tsx';
import LabVial from './react/LabVial.tsx';
import Molecule from './react/Molecule.tsx';
import TrtVial from './react/TrtVial.tsx';

interface MembershipPlan {
  name: string;
  price: string;
  period?: string;
  tagline: string;
  includes: string[];
  cta?: { label: string; href: string };
  featured?: boolean;
  note?: string;
}

interface Feature {
  heading: string;
  body: string;
  flip?: boolean;
  chipLabel?: string;
  chipClass?: string;
  imgAlt?: string;
  imgSurface?: string;
  image?: string;  // optional real image path, falls back to placeholder
  imgFocus?: string; // object-position for a fullwidth feature image, e.g. 'center 25%'
  scene?: 'dna' | 'vial' | 'molecule' | 'trt-vial'; // optional free-standing 3D form; replaces the framed image
  variant?: 'editorial' | 'fullwidth'; // default editorial split; 'fullwidth' renders the image as a full-bleed section with text overlaid
}

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heroTitle: string;
  heroSub: string;
  chipLabel: string;
  chipClass: string;           // e.g. 'chip-coral'
  heroSurface?: string;        // default 'var(--surface-peach)'
  heroImage?: string;          // optional real hero image
  values: { icon?: string; heading: string; body: string }[];
  features: Feature[];
  testimonials: { quote: string; attr: string }[];
  steps: { heading: string; body: string }[];
  faq: FaqItem[];
  // Optional: render a "what's covered" chip grid (sub-services / conditions treated)
  subServices?: {
    heading?: string;
    intro?: string;
    surface?: string;          // section bg, defaults to bg-shell
    items: string[];
    disclaimer?: string;       // small muted line below the list
  };
  // Optional: render a membership pricing section right below the hero.
  // Single-plan renders as a horizontal strip (HeroMembershipCard, which
  // uses `eyebrow`); 2+ plans render as side-by-side cards (MembershipPricing,
  // which ignores `eyebrow`).
  pricing?: {
    eyebrow?: string;
    plans: MembershipPlan[];
  };
  // Optional: render a subtle decorative graph behind the "how it works"
  // section. 'testosterone' shows an upward-trending curve representing
  // improving levels across the treatment timeline.
  stepsBackground?: 'testosterone';
  // Hero layout. Default 'editorial' is the asymmetric split with image
  // card on the right. 'fullwidth' renders the heroImage full-bleed with
  // a dark gradient and text overlaid in the left column.
  heroVariant?: 'editorial' | 'fullwidth';
  // object-position for the fullwidth hero image. Default 'center'.
  // Set e.g. 'center 25%' to bias the crop toward the top of the image
  // so a subject's head is not cut off.
  heroFocus?: string;
  // When true, the fullwidth hero text column sits on the right with
  // the dark gradient flipped to that side.
  heroFlip?: boolean;
  // When true, the "how it works" section gets a dark image backdrop and
  // absorbs the closing CTA copy (eyebrow + title + sub + pill buttons)
  // at the bottom, replacing the standalone CTA section at end of page.
  stepsAsHero?: boolean;
  // When true, the values 3-up section renders between the first and
  // second feature instead of immediately after the hero, so the
  // text-block values break up consecutive image-heavy feature rows.
  valuesAfterFirstFeature?: boolean;
  // When true, the subServices accordion renders between feature[0]
  // and feature[1] instead of as a standalone section after all
  // features. Useful when a page wants the "what we cover" detail
  // surfaced before the second feature's deeper narrative. Feature
  // backgrounds shift by 1 from feature[1] onward to preserve
  // shell/cream alternation around the injected section.
  subServicesAfterFirstFeature?: boolean;
  // Optional booking destination used by every page-level CTA on the
  // service page (hero "Begin consultation", in-feature "Get started",
  // closing "book a visit"). Defaults to the generic patient portal
  // landing. Single-plan pages can set this to the specific membership
  // booking; multi-plan pages typically leave it on the default and
  // route each pricing card to its own membership via plan.cta.
  bookingHref?: string;
  // Optional row of three round framed images with labels, rendered
  // after the feature rows. `backdrop` picks the ambient animation:
  // 'orbs' (drifting sage/rust/brass blobs) or 'data-grid' (a faint
  // twinkling field of data points, suited to lab/optimization pages).
  // Optional eyebrow/heading/body render centered above the row.
  roundImageTrio?: {
    eyebrow?: string;
    heading?: string;
    body?: string;
    items: { label: string; image: string }[];
    backdrop?: 'orbs' | 'data-grid';
  };
  // Optional editorial spotlight sections rendered after the trio
  // (or after the standalone subServices when no trio is present).
  // Each spotlight is its own sand-tinted fullwidth section with
  // eyebrow + heading + intro + optional accordion items + optional
  // CTA. Use for callouts that deserve breathing room (NAD+, in-person
  // stem cell, regional add-ons) without piling features into the
  // zigzag flow.
  spotlights?: {
    eyebrow?: string;
    heading: string;
    intro: string;
    // Optional short price/spec line shown under the intro, e.g.
    // "3 injections for $399".
    priceNote?: string;
    // When `image` is set, the content renders as a cinematic hero with
    // a text column over the image (pushed to the side opposite the
    // subject via `flip`); the accordion lives inside that column.
    // Without `image`, everything renders in a centered sand section.
    image?: string;
    imageAlt?: string;
    imageFocus?: string;
    flip?: boolean;
    accordion?: { q: string; a: string }[];
    // Primary action (filled button) and optional secondary action
    // (ghost button) rendered side by side below the accordion.
    cta?: { label: string; href: string };
    ctaSecondary?: { label: string; href: string };
  }[];
  // Optional overrides for the "how it works" steps heading.
  stepsEyebrow?: string;
  stepsTitle?: string;
  // Optional overrides for the closing CTA copy. Used by both the
  // standalone CTA card and the stepsAsHero variant that absorbs it.
  ctaEyebrow?: string;
  ctaTitle?: string;
  ctaSub?: string;
  ctaPrimaryLabel?: string;
}

const {
  title, description, eyebrow, heroTitle, heroSub,
  chipLabel, chipClass,
  heroSurface = 'var(--color-neutral)',
  heroImage,
  values, features, testimonials, steps, faq,
  subServices,
  pricing,
  stepsBackground,
  heroVariant = 'editorial',
  heroFocus,
  heroFlip = false,
  stepsAsHero = false,
  valuesAfterFirstFeature = false,
  subServicesAfterFirstFeature = false,
  bookingHref = 'https://mbsmedical.practicebetter.io',
  roundImageTrio,
  spotlights = [],
  stepsEyebrow = 'how it works',
  stepsTitle = 'Your path to better health',
  ctaEyebrow = 'Ready when you are',
  ctaTitle = 'Let’s build your plan.',
  ctaSub = 'Same-week telehealth across Florida. Cash pay, no insurance needed.',
  ctaPrimaryLabel = 'book a visit',
} = Astro.props;

// When the page has 2+ pricing plans, every page-level CTA (hero
// Begin consultation, in-feature Get started, closing book a visit)
// opens a small "pick your plan" modal instead of navigating to the
// generic portal landing. Pricing-card CTAs keep their direct plan
// URLs and do not trigger the modal.
const hasMultiplePlans = !!(pricing && pricing.plans && pricing.plans.length > 1);

// Strict bg alternation across every section after values (which is
// bg-cream). features start at bg-shell (i=0). Each downstream section
// continues the shell/cream pattern based on its running index, so
// we never end up with two same-color sections butting up against
// each other when a page has a different number of features or
// includes/omits subServices.
let _bgIdx = features.length + (subServices ? 1 : 0);
const testimonialsBg = _bgIdx++ % 2 === 0 ? 'bg-shell' : 'bg-cream';
const stepsBg        = _bgIdx++ % 2 === 0 ? 'bg-shell' : 'bg-cream';
const faqBg          = _bgIdx++ % 2 === 0 ? 'bg-shell' : 'bg-cream';
---

<Layout title={title} description={description}>

  <!-- ============================================================
       HERO — MBS-Test editorial split: rust eyebrow, big serif lowercase
       title on the left; rounded-2xl image card with badge on the right.
       Background tint comes from the heroSurface prop so each service
       page can pick its own accent (alternating across pages).
       ============================================================ -->
  {heroVariant === 'fullwidth' && heroImage ? (
    <section class={`section sp-hero sp-hero--fullwidth${heroFlip ? ' sp-hero--flip' : ''}`}>
      <img src={heroImage} alt={`${title} at MBS Medical`} class="sp-hero__bg" decoding="async" fetchpriority="high" style={heroFocus ? `object-position: ${heroFocus};` : undefined} />
      <div class="sp-hero__overlay" aria-hidden="true"></div>
      <div class="container sp-hero__fw-container">
        <div class="sp-hero__fw-text">
          <span class="editorial-eyebrow sp-hero__fw-eyebrow">{eyebrow}</span>
          <h1 class="sp-hero__fw-title">{heroTitle}</h1>
          <p class="sp-hero__fw-sub">{heroSub}</p>
          <div class="sp-hero__actions">
            <a
              href={bookingHref} data-booking-modal={hasMultiplePlans ? 'true' : undefined}
              target="_blank"
              rel="noopener noreferrer"
              class="sp-hero__cta sp-hero__fw-cta"
            >
              <span class="sp-hero__cta-rule" aria-hidden="true"></span>
              Begin consultation
            </a>
            <a href="/contact/" class="sp-hero__cta sp-hero__fw-cta sp-hero__cta--ghost">
              Ask a question
            </a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="section sp-hero" style={`background-color: ${heroSurface};`}>
      <div class="container">
        <div class="sp-hero__grid">
          <div class="sp-hero__text">
            <span class="editorial-eyebrow">{eyebrow}</span>
            <h1 class="sp-hero__title">{heroTitle}</h1>
            <p class="sp-hero__sub">{heroSub}</p>
            <div class="sp-hero__actions">
              <a href={bookingHref} data-booking-modal={hasMultiplePlans ? 'true' : undefined} target="_blank" rel="noopener noreferrer" class="sp-hero__cta">
                <span class="sp-hero__cta-rule" aria-hidden="true"></span>
                Begin consultation
              </a>
              <a href="/contact/" class="sp-hero__cta sp-hero__cta--ghost">
                Ask a question
              </a>
            </div>
          </div>
          <div class="sp-hero__media">
            {heroImage ? (
              <div class="sp-hero__frame">
                <img src={heroImage} alt={`${title} at MBS Medical`} decoding="async" fetchpriority="high" />
                <span class="sp-hero__badge">{chipLabel}</span>
              </div>
            ) : (
              <div class="sp-hero__frame sp-hero__frame--placeholder" role="img" aria-label={`${title} service`}>
                <span>{title.toLowerCase()} photo</span>
                <span class="sp-hero__badge">{chipLabel}</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}


  {pricing && pricing.plans.length === 1 && (
    <HeroMembershipCard eyebrow={pricing.eyebrow} plan={pricing.plans[0]} />
  )}

  {pricing && pricing.plans.length > 1 && (
    <MembershipPricing plans={pricing.plans} />
  )}


  <!-- ============================================================
       VALUE PROPS — cream surface (skipped here when
       valuesAfterFirstFeature is true; rendered between features
       [0] and [1] below instead)
       ============================================================ -->
  {!valuesAfterFirstFeature && values.length > 0 && (
    <section class="section bg-cream">
      <div class="container">
        <div class="reveal sp-values">
          {values.map((v, i) => (
            <div class={`reveal card sp-value-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
              <span class="sp-value-bar" aria-hidden="true"></span>
              <h3>{v.heading}</h3>
              <p>{v.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}



  <!-- ============================================================
       FEATURES — zigzag, alternating shell/sand. When
       valuesAfterFirstFeature is true, the values 3-up renders
       between features[0] and features[1].
       ============================================================ -->
  {features.map((f, i) => (
    <Fragment>
    {f.variant === 'fullwidth' && f.image ? (
      <section class={`section sp-feature sp-feature--fullwidth ${f.flip ? 'sp-feature--flip' : ''}`}>
        <img src={f.image} alt={f.imgAlt ?? f.heading} class="sp-feature__bg" loading="lazy" decoding="async" style={f.imgFocus ? `object-position: ${f.imgFocus};` : undefined} />
        <div class="sp-feature__overlay" aria-hidden="true"></div>
        <div class="container sp-feature__fw-container">
          <div class="sp-feature__fw-text">
            <span class="editorial-eyebrow sp-feature__fw-eyebrow">{f.chipLabel ?? chipLabel}</span>
            <h2 class="sp-feature__fw-heading">{f.heading}</h2>
            <p class="sp-feature__fw-body">{f.body}</p>
            <a
              href={bookingHref} data-booking-modal={hasMultiplePlans ? 'true' : undefined}
              target="_blank"
              rel="noopener noreferrer"
              class="sp-feature__fw-cta"
            >
              Get started
            </a>
          </div>
        </div>
      </section>
    ) : (
      <section class={`section sp-feature ${((subServicesAfterFirstFeature && i >= 1) ? i + 1 : i) % 2 === 0 ? 'bg-shell' : 'bg-cream'}`}>
        <div class="container">
          <div class={`feature-row reveal ${f.flip ? 'feature-row--flip' : ''}`}>
            <div class="feature-row__media">
              {f.scene === 'dna' ? (
                <div class="sp-feature-scene" aria-label={f.imgAlt ?? f.heading}>
                  <DnaHelix client:only="react" />
                </div>
              ) : f.scene === 'vial' ? (
                <div class="sp-feature-scene" aria-label={f.imgAlt ?? f.heading}>
                  <LabVial client:only="react" />
                </div>
              ) : f.scene === 'molecule' ? (
                <div class="sp-feature-scene" aria-label={f.imgAlt ?? f.heading}>
                  <Molecule client:only="react" />
                </div>
              ) : f.scene === 'trt-vial' ? (
                <div class="sp-feature-scene" aria-label={f.imgAlt ?? f.heading}>
                  <TrtVial client:only="react" />
                </div>
              ) : f.image ? (
                <div class="sp-feature-frame">
                  <img src={f.image} alt={f.imgAlt ?? f.heading} loading="lazy" decoding="async" />
                </div>
              ) : (
                <div
                  class="sp-feature-frame sp-feature-frame--placeholder"
                  style={f.imgSurface ? `background-color: ${f.imgSurface}` : ''}
                  role="img"
                  aria-label={f.imgAlt ?? f.heading}
                >
                  <span>{(f.imgAlt ?? f.heading).toLowerCase()}</span>
                </div>
              )}
            </div>
            <div class="feature-row__text">
              <span class="editorial-eyebrow">{f.chipLabel ?? chipLabel}</span>
              <h2 class="sp-feature-heading">{f.heading}</h2>
              <p class="sp-feature-body">{f.body}</p>
              <a href={bookingHref} data-booking-modal={hasMultiplePlans ? 'true' : undefined} target="_blank" rel="noopener noreferrer" class="sp-feature-cta">
                <span class="sp-feature-cta-rule" aria-hidden="true"></span>
                Get started
              </a>
            </div>
          </div>
        </div>
      </section>
    )}
    {valuesAfterFirstFeature && values.length > 0 && i === 0 && (
      <section class="section bg-cream">
        <div class="container">
          <div class="reveal sp-values">
            {values.map((v, vi) => (
              <div class={`reveal card sp-value-card ${vi > 0 ? `reveal-delay-${vi}` : ''}`}>
                <span class="sp-value-bar" aria-hidden="true"></span>
                <h3>{v.heading}</h3>
                <p>{v.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
    {subServicesAfterFirstFeature && subServices && i === 0 && (
      <section class={`section ${subServices.surface ?? 'bg-cream'}`}>
        <div class="container">
          <details class="reveal sp-sub-details">
            <summary class="sp-sub-summary">
              <span class="sp-sub-summary__label">
                <span class="sp-sub-summary__heading">{subServices.heading ?? 'what we cover'}</span>
              </span>
              <span class="sp-sub-summary__toggle" aria-hidden="true">+</span>
            </summary>
            {subServices.intro && <p class="sp-sub-intro">{subServices.intro}</p>}
            <ul class="sp-sub-list" role="list">
              {subServices.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
            {subServices.disclaimer && (
              <p class="sp-sub-disclaimer">{subServices.disclaimer}</p>
            )}
          </details>
        </div>
      </section>
    )}
    </Fragment>
  ))}


  <!-- ============================================================
       ROUND IMAGE TRIO — optional, rendered after the feature rows.
       Three round framed images with captions, centered, drifting
       orb ambient like the home mental health section.
       ============================================================ -->
  {roundImageTrio && roundImageTrio.items.length > 0 && (
    <section class="section bg-shell sp-trio">
      {roundImageTrio.backdrop === 'data-grid' ? (
        <div class="sp-trio__datagrid" aria-hidden="true">
          {Array.from({ length: 72 }).map((_, i) => {
            const col = i % 12;
            const row = Math.floor(i / 12);
            /* Delay scales with column so the twinkle sweeps left to
               right; small jitter keeps it from looking mechanical. */
            const delay = ((col / 12) * 4.5 + Math.random() * 0.9).toFixed(2);
            /* Cycle sage / rust / amber on a diagonal for color variety. */
            const colors = ['var(--color-accent)', 'var(--color-rust)', '#C8973F'];
            const color = colors[(col + row) % 3];
            return <span class="sp-trio__dot" style={`animation-delay:${delay}s;background:${color}`}></span>;
          })}
        </div>
      ) : (
        <div class="sp-trio__ambient" aria-hidden="true">
          <span class="sp-trio__orb sp-trio__orb--1"></span>
          <span class="sp-trio__orb sp-trio__orb--2"></span>
          <span class="sp-trio__orb sp-trio__orb--3"></span>
        </div>
      )}
      <div class="container sp-trio__container">
        {(roundImageTrio.eyebrow || roundImageTrio.heading || roundImageTrio.body) && (
          <div class="reveal sp-trio__header">
            {roundImageTrio.eyebrow && (
              <span class="editorial-eyebrow">{roundImageTrio.eyebrow}</span>
            )}
            {roundImageTrio.heading && (
              <h2 class="sp-trio__heading">{roundImageTrio.heading}</h2>
            )}
            {roundImageTrio.body && (
              <p class="sp-trio__body">{roundImageTrio.body}</p>
            )}
          </div>
        )}
        <div class="reveal sp-trio__row">
          {roundImageTrio.items.map((item, idx) => (
            <figure class={`sp-trio__item sp-trio__item--${idx + 1}`}>
              <div class="sp-trio__visual">
                <img src={item.image} alt={item.label} class="sp-trio__img" loading="lazy" decoding="async" />
              </div>
              <figcaption class="sp-trio__label">{item.label}</figcaption>
            </figure>
          ))}
        </div>

        {subServices && (
          <details class="reveal sp-sub-details sp-trio__sub">
            <summary class="sp-sub-summary">
              <span class="sp-sub-summary__label">
                <span class="sp-sub-summary__heading">{subServices.heading ?? 'what we cover'}</span>
              </span>
              <span class="sp-sub-summary__toggle" aria-hidden="true">+</span>
            </summary>
            {subServices.intro && <p class="sp-sub-intro">{subServices.intro}</p>}
            <ul class="sp-sub-list" role="list">
              {subServices.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
            {subServices.disclaimer && (
              <p class="sp-sub-disclaimer">{subServices.disclaimer}</p>
            )}
          </details>
        )}
      </div>
    </section>
  )}


  <!-- ============================================================
       SUB-SERVICES — chip grid of conditions / treatments covered.
       Only renders as its own section when there's no round image
       trio above it; otherwise it merges into the trio section.
       ============================================================ -->
  {subServices && !subServicesAfterFirstFeature && !(roundImageTrio && roundImageTrio.items.length > 0) && (
    <section class={`section ${subServices.surface ?? (features.length % 2 === 0 ? 'bg-shell' : 'bg-cream')}`}>
      <div class="container">
        <details class="reveal sp-sub-details">
          <summary class="sp-sub-summary">
            <span class="sp-sub-summary__label">
              <span class="sp-sub-summary__heading">{subServices.heading ?? 'what we cover'}</span>
            </span>
            <span class="sp-sub-summary__toggle" aria-hidden="true">+</span>
          </summary>
          {subServices.intro && <p class="sp-sub-intro">{subServices.intro}</p>}
          <ul class="sp-sub-list" role="list">
            {subServices.items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
          {subServices.disclaimer && (
            <p class="sp-sub-disclaimer">{subServices.disclaimer}</p>
          )}
        </details>
      </div>
    </section>
  )}


  <!-- ============================================================
       SPOTLIGHTS — standalone editorial callouts on sand surface.
       Each spotlight is its own fullwidth section that doesn't enter
       the shell/cream alternation, so testimonials/steps/faq below
       continue their own rhythm independent of how many spotlights
       were rendered.
       ============================================================ -->
  {spotlights.length > 0 && spotlights.map((spot) => (
    spot.image ? (
      <section class={`section sp-spotlight-hero ${spot.flip ? 'sp-spotlight-hero--flip' : ''}`}>
        <img src={spot.image} alt={spot.imageAlt ?? spot.heading} class="sp-spotlight-hero__bg" loading="lazy" decoding="async" style={spot.imageFocus ? `object-position: ${spot.imageFocus};` : undefined} />
        <div class="sp-spotlight-hero__overlay" aria-hidden="true"></div>
        <div class="container sp-spotlight-hero__container">
          <div class="reveal sp-spotlight-hero__text">
            {spot.eyebrow && <span class="editorial-eyebrow sp-spotlight-hero__eyebrow">{spot.eyebrow}</span>}
            <h2 class="sp-spotlight-hero__heading">{spot.heading}</h2>
            <p class="sp-spotlight-hero__intro">{spot.intro}</p>
            {spot.priceNote && <p class="sp-spotlight-hero__price">{spot.priceNote}</p>}
            {spot.accordion && spot.accordion.length > 0 && (
              <div class="sp-spotlight__accordion sp-spotlight-hero__accordion">
                {spot.accordion.map((item) => (
                  <details class="sp-spotlight__detail">
                    <summary class="sp-spotlight__summary">
                      <span class="sp-spotlight__summary-text">{item.q}</span>
                      <span class="sp-spotlight__chevron" aria-hidden="true">+</span>
                    </summary>
                    <div class="sp-spotlight__body">{item.a}</div>
                  </details>
                ))}
              </div>
            )}
            {(spot.cta || spot.ctaSecondary) && (
              <div class="sp-spotlight-hero__actions">
                {spot.cta && (
                  <a
                    href={spot.cta.href}
                    class="sp-spotlight-hero__cta"
                    {...(spot.cta.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {spot.cta.label}
                  </a>
                )}
                {spot.ctaSecondary && (
                  <a
                    href={spot.ctaSecondary.href}
                    class="sp-spotlight-hero__cta sp-spotlight-hero__cta--ghost"
                    {...(spot.ctaSecondary.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {spot.ctaSecondary.label}
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </section>
    ) : (
      <section class="section sp-spotlight">
        <div class="container sp-spotlight__container">
          <div class="reveal sp-spotlight__inner">
            {spot.eyebrow && (
              <span class="editorial-eyebrow sp-spotlight__eyebrow">{spot.eyebrow}</span>
            )}
            <h2 class="sp-spotlight__heading">{spot.heading}</h2>
            <p class="sp-spotlight__intro">{spot.intro}</p>
            {spot.priceNote && <p class="sp-spotlight__price">{spot.priceNote}</p>}
            {spot.accordion && spot.accordion.length > 0 && (
              <div class="sp-spotlight__accordion">
                {spot.accordion.map((item) => (
                  <details class="sp-spotlight__detail">
                    <summary class="sp-spotlight__summary">
                      <span class="sp-spotlight__summary-text">{item.q}</span>
                      <span class="sp-spotlight__chevron" aria-hidden="true">+</span>
                    </summary>
                    <div class="sp-spotlight__body">{item.a}</div>
                  </details>
                ))}
              </div>
            )}
            {(spot.cta || spot.ctaSecondary) && (
              <div class="sp-spotlight__actions">
                {spot.cta && (
                  <a
                    href={spot.cta.href}
                    class="sp-spotlight__cta"
                    {...(spot.cta.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {spot.cta.label}
                  </a>
                )}
                {spot.ctaSecondary && (
                  <a
                    href={spot.ctaSecondary.href}
                    class="sp-spotlight__cta sp-spotlight__cta--ghost"
                    {...(spot.ctaSecondary.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {spot.ctaSecondary.label}
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  ))}


  <!-- ============================================================
       TESTIMONIALS — bg auto-alternates with section above. Skipped
       entirely when the testimonials array is empty.
       ============================================================ -->
  {testimonials && testimonials.length > 0 && (
    <section class={`section ${testimonialsBg}`}>
      <div class="container">
        <div class="reveal" style="margin-bottom: 3rem; text-align: center;">
          <span class="sp-section-eyebrow">Patient stories</span>
          <h2 style="margin-top: 0.75rem; font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4.5vw, 3rem);">What patients say.</h2>
        </div>
        <div class="sp-testimonials">
          {testimonials.map((t, i) => (
            <div class={`reveal testimonial-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
              <p class="testimonial-quote">{t.quote}</p>
              <p class="testimonial-attr">{t.attr}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- ============================================================
       HOW IT WORKS — bg auto-alternates with section above
       (or, when stepsAsHero, becomes a dark image-backdrop hero
       that also absorbs the closing CTA at its bottom)
       ============================================================ -->
  {stepsAsHero ? (
    <section class={`section sp-steps-hero${stepsBackground ? ' has-bg-graph' : ''}`}>
      <img src="/images/sig-cta-dark.jpg" alt="" class="sp-steps-hero__bg" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="sp-steps-hero__overlay" aria-hidden="true"></div>
      {stepsBackground === 'testosterone' && <TestosteroneGraph />}
      <div class="container sp-steps-hero__container">
        <div class="reveal sp-steps-hero__header">
          <span class="label sp-steps-hero__label">{stepsEyebrow}</span>
          <h2 class="sp-steps-hero__title">{stepsTitle}</h2>
        </div>
        <div class="steps-grid sp-steps-hero__steps-grid">
          {steps.map((s, i) => (
            <div class={`reveal step-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
              <h3 style="margin-bottom:0.875rem;">{s.heading}</h3>
              <p style="color:var(--ink-secondary); font-size:var(--text-sm);">{s.body}</p>
            </div>
          ))}
        </div>
        <div class="reveal sp-steps-hero__cta">
          <span class="sp-cta-eyebrow">{ctaEyebrow}</span>
          <h2 class="sp-cta-title">{ctaTitle}</h2>
          <p class="sp-cta-sub">{ctaSub}</p>
          <div class="sp-cta-actions">
            <a
              href={bookingHref} data-booking-modal={hasMultiplePlans ? 'true' : undefined}
              target="_blank"
              rel="noopener noreferrer"
              class="sp-cta-btn sp-cta-btn--primary"
            >
              {ctaPrimaryLabel}
            </a>
            <a href="/contact/" class="sp-cta-btn sp-cta-btn--ghost">ask a question</a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section
      class={`section ${stepsBg}${stepsBackground ? ' has-bg-graph' : ''}`}
    >
      {stepsBackground === 'testosterone' && <TestosteroneGraph />}
      <div class="container" style={stepsBackground ? 'position: relative; z-index: 1;' : undefined}>
        <div class="reveal" style="text-align:center; margin-bottom:3.5rem;">
          <span class="label">{stepsEyebrow}</span>
          <h2 style="margin-top:0.75rem;">{stepsTitle}</h2>
        </div>
        <div class="steps-grid">
          {steps.map((s, i) => (
            <div class={`reveal step-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
              <h3 style="margin-bottom:0.875rem;">{s.heading}</h3>
              <p style="color:var(--ink-secondary); font-size:var(--text-sm);">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- ============================================================
       FAQ — bg auto-alternates with section above
       Two-column: title block + Caduceus 3D on the left, accordion
       list on the right. Caduceus container is overflow: visible so
       the model can spin in without being clipped.
       ============================================================ -->
  <section class={`section ${faqBg}`} style="padding-bottom: 2rem;">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-grid__left">
          <div class="reveal faq-grid__heading">
            <h2 class="faq-grid__title">FAQ</h2>
            <p class="faq-grid__sub">
              More questions? <a href="/contact/" style="text-decoration:underline; text-underline-offset:3px;">Contact us.</a>
            </p>
          </div>
          <div class="reveal faq-grid__caduceus" aria-hidden="true">
            <FaqCaduceus client:only="react" />
          </div>
        </div>

        <div class="reveal faq-list faq-grid__list">
          {faq.map(item => (
            <details class="faq-item">
              <summary class="faq-summary">{item.q}</summary>
              <p class="faq-body">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       CTA — rounded dark card (MBS-Test signature)
       Skipped when stepsAsHero is true: the steps section absorbs it.
       ============================================================ -->
  {!stepsAsHero && (
    <section class="section sp-cta-section">
      <div class="container">
        <div class="reveal sp-cta-card">
          <img src="/images/sig-cta-dark.jpg" alt="" class="sp-cta-bg" aria-hidden="true" loading="lazy" decoding="async" />
          <span class="sp-cta-deco sp-cta-deco--tr" aria-hidden="true"></span>
          <span class="sp-cta-deco sp-cta-deco--bl" aria-hidden="true"></span>
          <div class="sp-cta-inner">
            <span class="sp-cta-eyebrow">{ctaEyebrow}</span>
            <h2 class="sp-cta-title">{ctaTitle}</h2>
            <p class="sp-cta-sub">{ctaSub}</p>
            <div class="sp-cta-actions">
              <a href={bookingHref} data-booking-modal={hasMultiplePlans ? 'true' : undefined} target="_blank" rel="noopener noreferrer" class="sp-cta-btn sp-cta-btn--primary">
                {ctaPrimaryLabel}
              </a>
              <a href="/contact/" class="sp-cta-btn sp-cta-btn--ghost">ask a question</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}


  <!-- ============================================================
       BOOKING MODAL — multi-plan service pages only. Every page-level
       CTA marked data-booking-modal opens this dialog so the visitor
       picks a tier before being sent to PracticeBetter. Pricing-card
       CTAs route directly to their own plan URLs and skip this.
       ============================================================ -->
  {hasMultiplePlans && pricing && (
    <div class="sp-bm" id="sp-booking-modal" data-state="closed" aria-hidden="true">
      <div class="sp-bm__scrim" data-bm-close aria-hidden="true"></div>
      <div
        class="sp-bm__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="sp-bm-title"
        tabindex="-1"
      >
        <button class="sp-bm__close" data-bm-close type="button" aria-label="Close dialog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
        <span class="editorial-eyebrow sp-bm__eyebrow">Begin consultation</span>
        <h2 id="sp-bm-title" class="sp-bm__title">Pick the plan that fits</h2>
        <div class="sp-bm__plans">
          {pricing.plans.map((plan) => (
            <article class={`sp-bm__plan ${plan.featured ? 'sp-bm__plan--featured' : ''}`}>
              <header class="sp-bm__plan-head">
                <span class="sp-bm__plan-name">{plan.name}</span>
                <span class="sp-bm__plan-price">
                  {plan.price}<span class="sp-bm__plan-period">/ {plan.period ?? 'month'}</span>
                </span>
              </header>
              <p class="sp-bm__plan-tagline">{plan.tagline}</p>
              <a
                href={plan.cta?.href ?? bookingHref}
                target="_blank"
                rel="noopener noreferrer"
                class="sp-bm__plan-cta"
              >
                {plan.cta?.label ?? 'Start membership'}
              </a>
            </article>
          ))}
        </div>
        <a href="/contact/" class="sp-bm__ask">Have questions first? Contact us &rarr;</a>
      </div>
    </div>
  )}

</Layout>


<style>
  /* Section-level page-load cascade and edge-depth treatments live in
     global.css now so the same premium layering applies to every page,
     including the home page. The scoped overrides for has-bg-graph and
     hero variants below still live here. */

  /* Sections that host a decorative background graph need to be a
     positioning context so the absolutely positioned graph fills them. */
  .section.has-bg-graph {
    position: relative;
    overflow: hidden;
  }

  /* ---- Steps as Hero (merged with closing CTA) ----
     A single section that pairs the "how it works" content with the
     closing CTA. Dark image backdrop sits behind a dark gradient
     overlay, with the animated graph (when stepsBackground is set)
     layered over the overlay but under the content. */
  .sp-steps-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-primary);
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -60px 90px -40px rgba(0, 0, 0, 0.45),
      inset 0 50px 90px -40px rgba(0, 0, 0, 0.30);
  }
  .sp-steps-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.5;
    filter: grayscale(20%) contrast(1.02);
    z-index: 0;
  }
  .sp-steps-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(60, 56, 54, 0.85) 0%,
      rgba(60, 56, 54, 0.65) 45%,
      rgba(60, 56, 54, 0.85) 100%
    );
    z-index: 1;
  }
  .sp-steps-hero__container {
    position: relative;
    z-index: 3;
  }
  .sp-steps-hero__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .sp-steps-hero__label {
    color: rgba(255, 255, 255, 0.62);
  }
  .sp-steps-hero__title {
    color: #ffffff;
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .sp-steps-hero__steps-grid {
    /* Inherits steps-grid layout from global CSS — nothing to override */
  }
  /* Top-align card content so every heading starts at the same height,
     regardless of body copy length. */
  .sp-steps-hero .step-card {
    justify-content: flex-start;
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .sp-steps-hero .step-card:nth-child(2) {
    background-color: rgba(125, 140, 123, 0.86);
  }
  .sp-steps-hero .step-card:nth-child(3) {
    background-color: rgba(60, 56, 54, 0.82);
  }
  /* Dark 3rd card: flip text to light so it stays readable. */
  .sp-steps-hero .step-card:nth-child(3) h3 {
    color: #ffffff;
  }
  .sp-steps-hero .step-card:nth-child(3) p {
    color: rgba(255, 255, 255, 0.72) !important;
  }
  .sp-steps-hero .step-card:nth-child(4) {
    background-color: rgba(234, 231, 224, 0.86);
  }
  .sp-steps-hero__cta {
    margin-top: clamp(4rem, 7vw, 6rem);
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  /* The TestosteroneGraph component sits between the overlay and the
     content. `:global` because Astro scopes ServicePage's CSS to a
     different class hash than TestosteroneGraph's. */
  .sp-steps-hero :global(.t-graph) {
    z-index: 2;
    color: var(--color-neutral);
    /* Lift the graph upward so its arc starts and ends higher in the
       section instead of aligning to the vertical center. */
    align-items: flex-start;
    padding-top: clamp(1rem, 2vw, 2rem);
    transform: translateY(-10%);
  }
  .sp-steps-hero :global(.t-line) {
    opacity: 0.38;
  }
  .sp-steps-hero :global(.t-dots circle) {
    fill: #A78428;
    stroke: none;
  }

  /* ---- Round image trio with drifting orb ambient ---- */
  .sp-trio {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .sp-trio__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .sp-trio__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.38;
    will-change: transform;
  }
  .sp-trio__orb--1 {
    width: clamp(320px, 36vw, 520px);
    aspect-ratio: 1;
    background: var(--color-accent);
    top: 8%;
    left: 4%;
    animation: sp-trio-orb-1 16s ease-in-out infinite;
  }
  .sp-trio__orb--2 {
    width: clamp(360px, 40vw, 580px);
    aspect-ratio: 1;
    background: var(--color-rust);
    top: 28%;
    right: 4%;
    animation: sp-trio-orb-2 20s ease-in-out infinite;
  }
  .sp-trio__orb--3 {
    width: clamp(280px, 30vw, 440px);
    aspect-ratio: 1;
    background: #B8956A;
    bottom: 4%;
    left: 36%;
    animation: sp-trio-orb-3 18s ease-in-out infinite;
  }
  @keyframes sp-trio-orb-1 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(60px, 40px); }
  }
  @keyframes sp-trio-orb-2 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(-80px, 60px); }
  }
  @keyframes sp-trio-orb-3 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(40px, -50px); }
  }
  /* Data-grid backdrop: a faint field of dots laid out in a 12-column
     grid, each twinkling on its own random delay/duration. Reads as
     biomarker data without being a literal chart. */
  .sp-trio__datagrid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 1fr;
    padding: clamp(2rem, 5vw, 5rem);
  }
  .sp-trio__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    justify-self: center;
    align-self: center;
    opacity: 0;
    /* Fixed duration so the column-staggered delays read as one
       continuous left-to-right wave. */
    animation: sp-trio-twinkle 6s ease-in-out infinite;
  }
  @keyframes sp-trio-twinkle {
    0%, 100% { opacity: 0; transform: scale(0.55); }
    45%      { opacity: 0.62; transform: scale(1.05); }
    55%      { opacity: 0.62; transform: scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sp-trio__dot {
      animation: none;
      opacity: 0.18;
    }
  }
  .sp-trio__container {
    position: relative;
    z-index: 1;
  }
  .sp-trio__header {
    text-align: center;
    max-width: 56ch;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .sp-trio__heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    margin: 0;
    max-width: 22ch;
  }
  .sp-trio__body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--ink-secondary);
    margin: 0;
  }
  .sp-trio__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  .sp-trio__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    margin: 0;
  }
  .sp-trio__visual {
    position: relative;
    width: clamp(180px, 18vw, 240px);
    aspect-ratio: 1;
  }
  /* Middle image of the trio is slightly larger for visual emphasis. */
  .sp-trio__item--2 .sp-trio__visual {
    width: clamp(215px, 22vw, 290px);
  }
  /* Absolutely positioned so a portrait source image cannot push the
     visual's min-height past the aspect-ratio:1 (which produced ovals). */
  .sp-trio__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--color-primary);
    box-shadow:
      0 16px 28px -16px rgba(60, 56, 54, 0.28),
      0 6px 12px -8px rgba(60, 56, 54, 0.16);
  }
  .sp-trio__label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .sp-trio__sub {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  /* On phones the three circles otherwise flex-wrap into a lopsided 2 + 1
     (the middle one is intentionally larger on desktop). Stack them into a
     single centered column at a uniform size so the trio reads cleanly. */
  @media (max-width: 767px) {
    .sp-trio__row {
      flex-direction: column;
      gap: 2.25rem;
    }
    .sp-trio__visual,
    .sp-trio__item--2 .sp-trio__visual {
      width: clamp(150px, 44vw, 210px);
    }
  }
  /* Center the "what we cover" accordion within the trio section:
     heading + toggle as one centered unit, centered intro/disclaimer. */
  .sp-trio__sub .sp-sub-summary {
    justify-content: center;
    gap: 1rem;
  }
  .sp-trio__sub .sp-sub-summary__label {
    align-items: center;
  }
  .sp-trio__sub .sp-sub-intro,
  .sp-trio__sub .sp-sub-disclaimer {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  /* ---- Spotlight section ----
     Standalone editorial callout for a single service or treatment
     that deserves its own moment. Sand surface distinguishes it from
     the shell/cream feature flow without entering that alternation.
     Optional accordion list uses a hairline-separated <details>
     stack with a circular plus/X toggle for the open/closed state. */
  .sp-spotlight {
    background-color: var(--surface-sand);
  }
  .sp-spotlight + .sp-spotlight {
    /* Successive spotlights sit flush so the sand band reads as one
       continuous treatment; an inner hairline keeps them readable. */
    border-top: 1px solid var(--border-subtle);
  }
  /* ---- Spotlight hero: cinematic image with content + accordion ----
     Used when a spotlight has an image. Eyebrow + heading + intro +
     accordion + CTA all live in a text column over a dark gradient,
     pushed to the side opposite the photo's subject so it never sits
     on the people in the shot. Height is driven by content so the
     accordion can expand without clipping. */
  .sp-spotlight-hero {
    position: relative;
    overflow: hidden;
    padding: 0;
    background-color: var(--color-primary);
    min-height: clamp(420px, 58vh, 600px);
    display: flex;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -70px 100px -40px rgba(0, 0, 0, 0.5),
      inset 0 50px 100px -40px rgba(0, 0, 0, 0.3);
  }
  .sp-spotlight-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .sp-spotlight-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Default: dark anchored left (text-left layout). */
    background: linear-gradient(
      100deg,
      rgba(46, 43, 42, 0.93) 0%,
      rgba(46, 43, 42, 0.84) 34%,
      rgba(60, 56, 54, 0.42) 62%,
      rgba(60, 56, 54, 0) 100%
    );
  }
  .sp-spotlight-hero--flip .sp-spotlight-hero__overlay {
    /* Flip: dark anchored right where the text column sits. */
    background: linear-gradient(
      260deg,
      rgba(46, 43, 42, 0.93) 0%,
      rgba(46, 43, 42, 0.84) 34%,
      rgba(60, 56, 54, 0.42) 62%,
      rgba(60, 56, 54, 0) 100%
    );
  }
  .sp-spotlight-hero__container {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    max-width: none;
    align-items: center;
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  /* Push the text column toward the viewport edge, away from the photo
     subject, by breaking out of the centered container. */
  .sp-spotlight-hero--flip .sp-spotlight-hero__container {
    justify-content: flex-end;
    /* Re-constrain to a centered max-width so the text column sits
       inboard (just to the right of the photo subject) rather than
       pinned against the viewport edge. */
    max-width: 1500px;
    padding-right: clamp(1.5rem, 3vw, 3rem);
    padding-left: 1.5rem;
  }
