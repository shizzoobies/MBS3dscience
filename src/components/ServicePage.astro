  /* ---- Service hero (full-bleed image variant) ----
     Used when heroVariant === 'fullwidth'. The image fills the section,
     a left-weighted gradient gives the text room to breathe, and the
     existing text classes get overridden for white-on-dark display. */
  .sp-hero--fullwidth {
    padding: 0;
    min-height: 62vh;
    background-color: var(--color-primary);
  }
  .sp-hero--fullwidth::before,
  .sp-hero--fullwidth::after {
    display: none;
  }
  .sp-hero--fullwidth .sp-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .sp-hero--fullwidth .sp-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(60, 56, 54, 0.72) 0%,
      rgba(60, 56, 54, 0.45) 35%,
      rgba(60, 56, 54, 0.10) 65%,
      rgba(60, 56, 54, 0) 100%
    );
    z-index: 1;
  }
  .sp-hero__fw-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 62vh;
    padding-top: 7rem;
    padding-bottom: 4rem;
  }
  /* Flip variant: text column on the right, gradient dark on the right.
     The fw-text carries margin-right:auto for the default left layout,
     so the flip has to swap that to margin-left:auto or the column
     stays pinned left regardless of justify-content. */
  .sp-hero--fullwidth.sp-hero--flip .sp-hero__fw-container {
    justify-content: flex-end;
  }
  .sp-hero--fullwidth.sp-hero--flip .sp-hero__fw-text {
    margin-right: 0;
    margin-left: auto;
  }
  .sp-hero--fullwidth.sp-hero--flip .sp-hero__overlay {
    background: linear-gradient(
      260deg,
      rgba(60, 56, 54, 0.72) 0%,
      rgba(60, 56, 54, 0.45) 35%,
      rgba(60, 56, 54, 0.10) 65%,
      rgba(60, 56, 54, 0) 100%
    );
  }
  .sp-hero__fw-text {
    max-width: 42rem;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  /* Rust eyebrow against a dark photo overlay fails WCAG AA at small
     tracker sizes. Switch to a warm cream that hits ~14:1 contrast. */
  .sp-hero__fw-eyebrow {
    color: var(--color-neutral);
  }
  .sp-hero__fw-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.5rem, 5.4vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }
  .sp-hero__fw-sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.85);
    max-width: 52ch;
    margin: 0;
  }
  /* Convert the editorial-tracker CTAs into proper pill buttons for the
     full-bleed hero. Scoped under `.sp-hero--fullwidth` for specificity so
     these win over the base `.sp-hero__cta` defined below (which sets
     `padding: 0` and keeps the hairline rule visible). */
  .sp-hero--fullwidth .sp-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 17px 38px;
    border-radius: 999px;
    border: 1.5px solid transparent;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
    white-space: nowrap;
  }
  .sp-hero--fullwidth .sp-hero__cta-rule {
    display: none;
  }
  .sp-hero--fullwidth .sp-hero__cta:not(.sp-hero__cta--ghost) {
    background-color: #ffffff;
    color: var(--color-primary);
    border-color: #ffffff;
  }
  .sp-hero--fullwidth .sp-hero__cta:not(.sp-hero__cta--ghost):hover {
    background-color: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }
  .sp-hero--fullwidth .sp-hero__cta.sp-hero__cta--ghost {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.92);
    border-color: rgba(255, 255, 255, 0.55);
  }
  .sp-hero--fullwidth .sp-hero__cta.sp-hero__cta--ghost:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: #ffffff;
    border-color: #ffffff;
  }
  .sp-hero--fullwidth .sp-hero__cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }
  .sp-hero--fullwidth .sp-hero__actions {
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  @media (max-width: 767px) {
    .sp-hero--fullwidth {
      min-height: 60vh;
    }
    .sp-hero__fw-container {
      min-height: 60vh;
      padding-top: 6rem;
      padding-bottom: 3rem;
    }
    /* Full-width text column on phones: swap the side-anchored gradient for a
       uniform top-to-bottom darken so the white copy reads over any part of
       the cropped image (covers default + flip). */
    .sp-hero--fullwidth .sp-hero__overlay,
    .sp-hero--fullwidth.sp-hero--flip .sp-hero__overlay {
      background: linear-gradient(
        180deg,
        rgba(60, 56, 54, 0.42) 0%,
        rgba(60, 56, 54, 0.68) 100%
      );
    }
  }

  /* ---- Service hero (MBS-Test editorial split) ---- */
  .sp-hero {
    /* background-color set inline via heroSurface prop */
    padding-top: 6rem;
    padding-bottom: 1rem;
    /* No min-height — let content drive height. The 92vh that used to be
       here was forcing the hero to stretch the full viewport even when
       the title + intro + image were ~600px, creating dead padding
       below the content. */
    display: block;
    position: relative;
    overflow: hidden;
    /* Edge depth applied to every hero variant: drop shadow under, and
       a layered inset fade on top/bottom/sides so the section reads
       with dimension rather than as a flat band of color. Calibrated
       light here because the editorial hero usually sits on a tinted
       cream background; the fullwidth override below punches harder.
       Hairline borders top/bottom match the framed treatment used on
       the values, testimonials, and faq sections. */
    box-shadow:
      0 24px 48px -26px rgba(60, 56, 54, 0.28),
      inset 0 1px 0 rgba(60, 56, 54, 0.10),
      inset 0 -1px 0 rgba(60, 56, 54, 0.10),
      inset 0 -50px 80px -50px rgba(60, 56, 54, 0.14),
      inset 0 40px 70px -50px rgba(60, 56, 54, 0.08),
      inset 80px 0 80px -90px rgba(60, 56, 54, 0.10),
      inset -80px 0 80px -90px rgba(60, 56, 54, 0.10);
  }
  .sp-hero--fullwidth {
    /* Vignette + light hairline for the dark photo hero (white rgba so
       the hairline reads against the dark backdrop). */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -80px 110px -40px rgba(0, 0, 0, 0.55),
      inset 0 60px 110px -40px rgba(0, 0, 0, 0.35),
      inset 100px 0 120px -80px rgba(0, 0, 0, 0.4),
      inset -100px 0 120px -80px rgba(0, 0, 0, 0.4),
      0 24px 48px -28px rgba(0, 0, 0, 0.35);
  }
  .sp-feature--fullwidth {
    /* Same vignette + light hairline treatment so feature heroes feel
       cohesive with the main hero. */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -70px 100px -40px rgba(0, 0, 0, 0.5),
      inset 0 50px 100px -40px rgba(0, 0, 0, 0.3),
      inset 90px 0 110px -80px rgba(0, 0, 0, 0.35),
      inset -90px 0 110px -80px rgba(0, 0, 0, 0.35),
      0 22px 42px -28px rgba(0, 0, 0, 0.32);
  }
  .sp-hero::before,
  .sp-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(60,56,54,0.06);
    pointer-events: none;
  }
  .sp-hero::before {
    width: 360px; height: 360px;
    top: 50%; left: -120px;
    transform: translateY(-50%);
    border-style: dashed;
  }
  .sp-hero::after {
    width: 480px; height: 480px;
    bottom: -240px; right: -120px;
  }
  .sp-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    /* Text column wider (7) than image column (5) so the pricing card
       has room to breathe; image stays editorial but doesn't dominate. */
    .sp-hero__grid { grid-template-columns: 7fr 5fr; gap: 3.5rem; }
  }
  .sp-hero__text { display: flex; flex-direction: column; gap: 1.75rem; }
  .sp-hero__title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin: 0;
  }
  .sp-hero__sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
    max-width: 48ch;
    margin: 0;
  }
  .sp-hero__plan {
    margin-top: 0.75rem;
    /* Fill the text column so the card visually anchors to the title above
       instead of floating as a narrower object. */
    width: 100%;
  }
  .sp-hero__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .sp-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 200ms ease;
    background: transparent;
    border: none;
    padding: 0;
  }
  .sp-hero__cta:hover { color: var(--color-rust); }
  .sp-hero__cta-rule {
    display: inline-block;
    width: 48px;
    height: 1px;
    background-color: currentColor;
    transition: width 250ms ease;
  }
  .sp-hero__cta:hover .sp-hero__cta-rule { width: 80px; }
  .sp-hero__cta--ghost { color: var(--color-tertiary); }

  /* Image card with rounded-2xl + small uppercase badge bottom-left */
  .sp-hero__media { position: relative; }
  .sp-hero__frame {
    position: relative;
    width: 100%;
    /* 4:5 portrait was too tall — created big empty vertical space next to
       text+card. 5:6 is closer to square and feels balanced against the
       stacked text column. */
    aspect-ratio: 5/6;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
  }
  .sp-hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }
  .sp-hero__frame:hover img { transform: scale(1.04); }
  .sp-hero__frame--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .sp-hero__badge {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  @media (max-width: 767px) {
    .sp-hero { padding-top: 5rem; padding-bottom: 0.75rem; }
    .sp-hero__frame { aspect-ratio: 16/10; }
    .sp-hero__badge { bottom: 1rem; left: 1rem; }
  }

  /* ---- Feature row (full-bleed image variant) ----
     Used when feature.variant === 'fullwidth'. Same shape as the full-bleed
     hero: image fills the section, dark gradient overlay anchored opposite
     the text column, text in a max-width column with pill CTA. */
  .sp-feature--fullwidth {
    position: relative;
    padding: 0;
    min-height: 50vh;
    overflow: hidden;
    background-color: var(--color-primary);
  }
  .sp-feature--fullwidth .sp-feature__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .sp-feature--fullwidth .sp-feature__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(60, 56, 54, 0.72) 0%,
      rgba(60, 56, 54, 0.45) 35%,
      rgba(60, 56, 54, 0.10) 65%,
      rgba(60, 56, 54, 0) 100%
    );
    z-index: 1;
  }
  .sp-feature--fullwidth.sp-feature--flip .sp-feature__overlay {
    background: linear-gradient(
      260deg,
      rgba(60, 56, 54, 0.72) 0%,
      rgba(60, 56, 54, 0.45) 35%,
      rgba(60, 56, 54, 0.10) 65%,
      rgba(60, 56, 54, 0) 100%
    );
  }
  .sp-feature__fw-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 50vh;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }
  .sp-feature--flip .sp-feature__fw-container {
    justify-content: flex-end;
    padding-right: clamp(2rem, 4vw, 4rem);
  }
  /* Non-flip fullwidth feature: break out of the centered 1280px
     container so the left text column sits closer to the viewport
     edge instead of being pushed in by the centering gap. */
  .sp-feature--fullwidth:not(.sp-feature--flip) .sp-feature__fw-container {
    max-width: none;
    padding-left: clamp(2rem, 6vw, 7rem);
  }
  .sp-feature__fw-text {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  /* Flip variant: column sits to the right side of the section but with
     enough horizontal room that the heading and body don't have to
     squish into a narrow column. */
  .sp-feature--flip .sp-feature__fw-text {
    max-width: 34rem;
    margin-right: 0;
  }
  .sp-feature--flip .sp-feature__fw-heading {
    max-width: 20ch;
  }
  .sp-feature--flip .sp-feature__fw-body {
    max-width: 44ch;
  }
  .sp-feature__fw-eyebrow {
    color: var(--color-neutral);
  }
  .sp-feature__fw-heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.018em;
    color: #ffffff;
    margin: 0;
    max-width: 22ch;
  }
  .sp-feature__fw-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.85);
    max-width: 52ch;
    margin: 0;
  }
  .sp-feature__fw-cta {
    align-self: flex-start;
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px 34px;
    border-radius: 999px;
    border: 1.5px solid #ffffff;
    background-color: transparent;
    color: #ffffff;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    white-space: nowrap;
  }
  .sp-feature__fw-cta:hover {
    background-color: #ffffff;
    color: var(--color-primary);
  }
  .sp-feature__fw-cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }
  @media (max-width: 767px) {
    .sp-feature--fullwidth {
      min-height: 42vh;
    }
    .sp-feature__fw-container {
      min-height: 42vh;
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }
    /* Full-width text column on phones: uniform top-to-bottom darken so the
       white copy reads over the cropped image (covers default + flip). */
    .sp-feature--fullwidth .sp-feature__overlay,
    .sp-feature--fullwidth.sp-feature--flip .sp-feature__overlay {
      background: linear-gradient(
        180deg,
        rgba(60, 56, 54, 0.42) 0%,
        rgba(60, 56, 54, 0.68) 100%
      );
    }
  }

  /* ---- Feature row (MBS-Test editorial split with rounded-2xl frame) ---- */
  .sp-feature {
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }
  /* Free-standing 3D scene slot — same footprint as the image frame but no
     visible card, transparent background, rendered by an R3F island. */
  .sp-feature-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background-color: transparent;
    border: 0;
    overflow: visible;
    transform-origin: center center;
    will-change: transform, opacity;
  }
  @media (max-width: 767px) {
    .sp-feature-scene { aspect-ratio: 4/3; }
  }

  /* Wrapper handles only an opacity fade — cheap on the GPU since it
     doesn't force the canvas layer to re-rasterize. The "grow into
     frame" scale animation is owned by each R3F scene component
     (Cluster in Molecule.tsx, etc.), driven by useFrame in 3D space.
     This avoids the well-known choppiness of CSS-transforming a live
     canvas wrapper. */
  .sp-feature-scene {
    opacity: 0.4;
    transition: opacity 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sp-feature-scene.is-focused {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-feature-scene {
      opacity: 1;
      transition: none;
    }
  }
  .sp-feature-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
  }
  .sp-feature-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }
  .sp-feature-frame:hover img { transform: scale(1.04); }
  .sp-feature-frame--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  @media (max-width: 767px) {
    .sp-feature-frame { aspect-ratio: 4/3; }
  }

  .sp-feature-heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    margin: 1.25rem 0 1.25rem;
    max-width: 18ch;
  }
  .sp-feature-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
    max-width: 50ch;
    margin-bottom: 2.25rem;
  }
  .sp-feature-cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .sp-feature-cta:hover { color: var(--color-rust); }
  .sp-feature-cta-rule {
    display: inline-block;
    width: 48px;
    height: 1px;
    background-color: currentColor;
    transition: width 250ms ease;
  }
  .sp-feature-cta:hover .sp-feature-cta-rule { width: 80px; }

  .sp-feature-img {
    border-radius: var(--radius-xl);
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }

  /* ---- Sub-services collapsible (no chips, no boxes) ---- */
  .sp-sub-details {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: 0.5rem;
    max-width: 880px;
    margin-inline: auto;
  }
  .sp-sub-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
  }
  .sp-sub-summary::-webkit-details-marker { display: none; }
  .sp-sub-summary__label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sp-sub-summary__label .accent-chip { margin-bottom: 0; }
  .sp-sub-summary__heading {
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--ink-primary);
    letter-spacing: var(--tracking-tight);
  }
  .sp-sub-summary__toggle {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--ink-secondary);
    transition: transform var(--dur-base) var(--ease-standard),
                background-color var(--dur-base) var(--ease-standard);
  }
  details[open] .sp-sub-summary__toggle {
    transform: rotate(45deg);
    background-color: var(--surface-sand);
  }
  .sp-sub-intro {
    color: var(--ink-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    margin-bottom: 1.5rem;
    padding-bottom: 0.25rem;
  }
  .sp-sub-list {
    list-style: none;
    margin: 0;
    padding-bottom: 1.5rem;
    columns: 1;
    column-gap: 2.5rem;
  }
  @media (min-width: 600px) { .sp-sub-list { columns: 2; } }
  @media (min-width: 1024px) { .sp-sub-list { columns: 3; } }
  .sp-sub-list li {
    break-inside: avoid;
    padding: 0.5rem 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Values */
  .sp-values {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .sp-values { grid-template-columns: repeat(3, 1fr); }
  }
  .sp-value-card {
    padding: 2.25rem 2rem;
    transition: transform var(--dur-base), border-color var(--dur-base);
  }
  .sp-value-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
  }
  .sp-value-card h3 { font-size: var(--text-xl); margin-bottom: 0.75rem; }
  .sp-value-card p  { font-size: var(--text-sm); color: var(--ink-secondary); max-width: none; }
  .sp-value-bar {
    display: block;
    width: 48px;
    height: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--accent-terracotta);
    margin-bottom: 1.25rem;
  }

  /* Features */
  .feature-row__text h2 { margin-bottom: 1rem; }
  .feature-row__text p  { color: var(--ink-secondary); font-size: var(--text-base); max-width: 52ch; }

  /* Testimonials */
  .sp-testimonials {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .sp-testimonials { grid-template-columns: repeat(3, 1fr); }
  }

  /* FAQ — 2-column with Caduceus on the left under the title.
     Default `align-items: stretch` on the grid plus margin-top: auto on
     the caduceus pushes its bottom edge down so it aligns with the
     bottom of the accordion list on the right. */
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    overflow: visible;
  }
  @media (min-width: 900px) {
    .faq-grid {
      grid-template-columns: minmax(260px, 1fr) 1.7fr;
      gap: 2rem;
    }
  }
  .faq-grid__left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow: visible;
  }
  .faq-grid__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .faq-grid__sub {
    color: var(--ink-secondary);
    margin-top: 0.5rem;
    font-size: var(--text-sm);
  }
  .faq-grid__caduceus {
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1;
    overflow: visible;
  }
  .faq-grid__list {
    width: 100%;
  }

  /* ---- Steps (MBS-Test bento variant) ---- */
  .step-card {
    position: relative;
    padding: 2.5rem 2rem 2.25rem;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    overflow: hidden;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .step-card:hover { transform: translateY(-3px); }
  .step-card h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.875rem;
    line-height: 1.2;
    color: inherit;
  }
  /* nth-child variants: alternate cream → sage → primary → cream-bordered */
  .step-card:nth-child(2) {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }
  .step-card:nth-child(2) p { color: rgba(255,255,255,0.78) !important; }
  .step-card:nth-child(3) {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #FFFFFF;
  }
  .step-card:nth-child(3) p { color: rgba(255,255,255,0.72) !important; }
  .step-card:nth-child(4) {
    background-color: var(--color-surface-warm);
  }

  /* ---- Disclaimer line below the conditions list ---- */
  .sp-sub-disclaimer {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--ink-secondary);
    font-style: italic;
    margin: 1rem 0 0;
    max-width: 60ch;
  }

  /* (Closing CTA styles below) */
  /* ---- Closing CTA: rounded dark card ---- */
  .sp-cta-section {
    background-color: var(--color-neutral);
    padding-block: 6rem;
  }
  .sp-cta-card {
    position: relative;
    background-color: var(--color-primary);
    color: #FFFFFF;
    border-radius: var(--radius-xl);
    padding: 3.5rem 1.5rem;
    text-align: center;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .sp-cta-card { padding: 7rem 4rem; border-radius: var(--radius-2xl); }
  }
  .sp-cta-deco {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.08);
    pointer-events: none;
  }
  .sp-cta-deco--tr { width: 280px; height: 280px; top: 0; right: 0; transform: translate(40%, -40%); }
  .sp-cta-deco--bl { width: 220px; height: 220px; bottom: 0; left: 0; transform: translate(-40%, 40%); border-style: dashed; }
  .sp-cta-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    mix-blend-mode: lighten;
    pointer-events: none;
    filter: grayscale(40%) contrast(1.05);
  }
  .sp-cta-inner { position: relative; z-index: 1; max-width: 720px; margin-inline: auto; }
  .sp-cta-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: 2rem;
  }
  .sp-cta-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    margin: 0;
  }
  .sp-cta-sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(255,255,255,0.65);
    max-width: 52ch;
    margin: 1.75rem auto 0;
  }
  .sp-cta-actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 2.75rem;
  }
  .sp-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 16px 38px;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .sp-cta-btn--primary {
    background-color: var(--color-accent);
    color: #FFFFFF;
    border-color: var(--color-accent);
  }
  .sp-cta-btn--primary:hover {
    background-color: #FFFFFF;
    color: var(--color-accent);
    border-color: #FFFFFF;
  }
  .sp-cta-btn--ghost {
    background-color: transparent;
    color: rgba(255,255,255,0.85);
    border-color: rgba(255,255,255,0.30);
  }
  .sp-cta-btn--ghost:hover {
    background-color: rgba(255,255,255,0.08);
    color: #FFFFFF;
    border-color: rgba(255,255,255,0.6);
  }

  /* ---- Booking modal ----
     Multi-plan service pages render this dialog. Page-level CTAs
     intercept and open the modal; visitor picks a tier; each plan
     CTA inside the modal links to its own PracticeBetter URL. */
  .sp-bm {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }
  .sp-bm[data-state="open"] {
    opacity: 1;
    pointer-events: auto;
  }
  .sp-bm[data-state="open"] .sp-bm__panel {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
  .sp-bm__scrim {
    position: absolute;
    inset: 0;
    background: rgba(60, 56, 54, 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }
  .sp-bm__panel {
    position: relative;
    background: var(--color-neutral);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.35);
    max-width: 640px;
    width: 100%;
    max-height: 92vh;
    overflow-y: auto;
    padding: clamp(2rem, 5vw, 2.75rem);
    transform: scale(0.97) translateY(8px);
    opacity: 0;
    transition: transform 220ms ease, opacity 220ms ease;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }
  .sp-bm__close {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
  }
  .sp-bm__close:hover {
    background: var(--color-surface-warm);
    border-color: var(--color-border-strong);
    color: var(--color-rust);
  }
  .sp-bm__close:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 2px;
  }
  .sp-bm__close svg {
    width: 18px;
    height: 18px;
  }
  .sp-bm__eyebrow {
    align-self: center;
  }
  .sp-bm__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    margin: 0;
  }
  .sp-bm__plans {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    margin-top: 0.75rem;
    text-align: left;
  }
  @media (min-width: 600px) {
    .sp-bm__plans {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sp-bm__plan {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.125rem 1.25rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .sp-bm__plan:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }
  .sp-bm__plan--featured {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }
  .sp-bm__plan--featured:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
  .sp-bm__plan-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .sp-bm__plan-name {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-rust);
  }
  .sp-bm__plan--featured .sp-bm__plan-name {
    color: rgba(255, 255, 255, 0.85);
  }
  .sp-bm__plan-price {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-primary);
    white-space: nowrap;
  }
  .sp-bm__plan--featured .sp-bm__plan-price {
    color: #FFFFFF;
  }
  .sp-bm__plan-period {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-secondary);
    font-weight: var(--weight-medium);
    text-transform: lowercase;
    letter-spacing: 0;
    margin-left: 0.125rem;
  }
  .sp-bm__plan--featured .sp-bm__plan-period {
    color: rgba(255, 255, 255, 0.78);
  }
  .sp-bm__plan-tagline {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-secondary);
    margin: 0;
    flex-grow: 1;
  }
  .sp-bm__plan--featured .sp-bm__plan-tagline {
    color: rgba(255, 255, 255, 0.85);
  }
  .sp-bm__plan-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 15px 22px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-primary);
    background-color: var(--color-primary);
    color: #FFFFFF;
    text-decoration: none;
    text-align: center;
    margin-top: 0.25rem;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .sp-bm__plan-cta:hover {
    background-color: transparent;
    color: var(--color-primary);
  }
  .sp-bm__plan--featured .sp-bm__plan-cta {
    background-color: #FFFFFF;
    color: var(--color-accent);
    border-color: #FFFFFF;
  }
  .sp-bm__plan--featured .sp-bm__plan-cta:hover {
    background-color: transparent;
    color: #FFFFFF;
    border-color: #FFFFFF;
  }
  .sp-bm__ask {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-rust);
    text-decoration: none;
    margin-top: 0.5rem;
    transition: color 150ms ease, letter-spacing 150ms ease;
  }
  .sp-bm__ask:hover {
    color: var(--color-primary);
    letter-spacing: 0.24em;
  }
  @media (prefers-reduced-motion: reduce) {
    .sp-bm,
    .sp-bm__panel {
      transition: none;
    }
    .sp-bm__plan {
      transition: none;
    }
  }
</style>


<script>
  // Re-runs on first load AND after every view-transition navigation so the
  // scene observer and booking-modal triggers bind to the freshly-swapped
  // page. The document-level keydown handler (Esc + focus trap) is bound once
  // and re-queries the live modal, so it never stacks up across navigations.
  let spLastFocus: HTMLElement | null = null;
  let spKeydownBound = false;

  const closeBookingModal = () => {
    const m = document.getElementById('sp-booking-modal');
    if (!m) return;
    m.setAttribute('data-state', 'closed');
    m.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    spLastFocus?.focus();
  };

  function initServicePage() {
    // Trigger the .sp-feature-scene focus transition once each scene enters
    // the viewport. Time-based easing (in the scoped CSS) keeps it smooth
    // regardless of scroll velocity.
    const sceneObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-focused');
          sceneObserver.unobserve(entry.target);
        }
      }),
      { threshold: 0.25, rootMargin: '0px 0px -120px 0px' }
    );
    document.querySelectorAll('.sp-feature-scene').forEach((el) => {
      sceneObserver.observe(el);
    });

    // Booking-plan modal — opens when any page-level CTA marked
    // data-booking-modal is clicked on a multi-plan service page. Pricing
    // card CTAs route directly to plan-specific URLs and skip this dialog.
    const bookingModal = document.getElementById('sp-booking-modal');
    if (bookingModal) {
      const triggers = document.querySelectorAll<HTMLAnchorElement>('[data-booking-modal="true"]');
      const closers = bookingModal.querySelectorAll<HTMLElement>('[data-bm-close]');
      const panel = bookingModal.querySelector<HTMLElement>('.sp-bm__panel');

      const openBookingModal = () => {
        const active = document.activeElement;
        spLastFocus = active instanceof HTMLElement ? active : null;
        bookingModal.setAttribute('data-state', 'open');
        bookingModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => {
          const firstFocusable = panel?.querySelector<HTMLElement>('button, a[href]');
          firstFocusable?.focus();
        });
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          openBookingModal();
        });
      });

      closers.forEach((closer) => {
        closer.addEventListener('click', closeBookingModal);
      });
    }

    // Bound once on the persistent document.
    if (!spKeydownBound) {
      spKeydownBound = true;
      document.addEventListener('keydown', (e) => {
        const m = document.getElementById('sp-booking-modal');
        if (!m || m.getAttribute('data-state') !== 'open') return;
        if (e.key === 'Escape') {
          closeBookingModal();
          return;
        }
        // Focus trap on Tab so keyboard users stay inside the dialog
        if (e.key === 'Tab') {
          const panel = m.querySelector<HTMLElement>('.sp-bm__panel');
          if (!panel) return;
          const focusables = panel.querySelectorAll<HTMLElement>(
            'button, a[href], [tabindex]:not([tabindex="-1"])'
          );
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initServicePage);
</script>
