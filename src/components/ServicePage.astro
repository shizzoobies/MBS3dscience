---
/**
 * Shared service page template.
 * Follows design-system.md page anatomy:
 * hero → value props → zigzag features → testimonials → how it works → faq → cta
 */

import Layout from '../layouts/Layout.astro';
import MembershipPricing from './MembershipPricing.astro';

interface MembershipPlan {
  name: string;
  price: string;
  period?: string;
  tagline: string;
  includes: string[];
  cta?: { label: string; href: string };
  featured?: boolean;
  note?: string;
}

interface Feature {
  heading: string;
  body: string;
  flip?: boolean;
  chipLabel?: string;
  chipClass?: string;
  imgAlt?: string;
  imgSurface?: string;
  image?: string;  // optional real image path, falls back to placeholder
}

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heroTitle: string;
  heroSub: string;
  chipLabel: string;
  chipClass: string;           // e.g. 'chip-coral'
  heroSurface?: string;        // default 'var(--surface-peach)'
  heroImage?: string;          // optional real hero image
  values: { icon?: string; heading: string; body: string }[];
  features: Feature[];
  testimonials: { quote: string; attr: string }[];
  steps: { heading: string; body: string }[];
  faq: FaqItem[];
  // Optional: render a "what's covered" chip grid (sub-services / conditions treated)
  subServices?: {
    heading?: string;
    intro?: string;
    surface?: string;          // section bg, defaults to bg-shell
    items: string[];
  };
  // Optional: render a membership pricing section between values and features
  pricing?: {
    eyebrow?: string;
    heading: string;
    intro?: string;
    plans: MembershipPlan[];
  };
}

const {
  title, description, eyebrow, heroTitle, heroSub,
  chipLabel, chipClass,
  heroSurface = 'var(--surface-peach)',
  heroImage,
  values, features, testimonials, steps, faq,
  subServices,
  pricing,
} = Astro.props;
---

<Layout title={title} description={description}>

  <!-- ============================================================
       HERO — MBS-Test editorial split: rust eyebrow, big serif lowercase
       title on the left; rounded-2xl image card with badge on the right.
       ============================================================ -->
  <section class="section sp-hero">
    <div class="container">
      <div class="sp-hero__grid">
        <div class="sp-hero__text">
          <span class="editorial-eyebrow">{eyebrow}</span>
          <h1 class="sp-hero__title">{heroTitle}</h1>
          <p class="sp-hero__sub">{heroSub}</p>
          <div class="sp-hero__actions">
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="sp-hero__cta">
              <span class="sp-hero__cta-rule" aria-hidden="true"></span>
              Begin consultation
            </a>
            <a href="/contact/" class="sp-hero__cta sp-hero__cta--ghost">
              Ask a question
            </a>
          </div>
        </div>
        <div class="sp-hero__media">
          {heroImage ? (
            <div class="sp-hero__frame">
              <img src={heroImage} alt={`${title} at MBS Medical`} />
              <span class="sp-hero__badge">{chipLabel}</span>
            </div>
          ) : (
            <div class="sp-hero__frame sp-hero__frame--placeholder" role="img" aria-label={`${title} service`}>
              <span>{title.toLowerCase()} photo</span>
              <span class="sp-hero__badge">{chipLabel}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       VALUE PROPS — cream surface
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal sp-values">
        {values.map((v, i) => (
          <div class={`reveal card sp-value-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
            <span class="sp-value-bar" aria-hidden="true"></span>
            <h3>{v.heading}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  {pricing && (
    <MembershipPricing
      eyebrow={pricing.eyebrow}
      heading={pricing.heading}
      intro={pricing.intro}
      plans={pricing.plans}
    />
  )}


  <!-- ============================================================
       FEATURES — zigzag, alternating shell/sand
       ============================================================ -->
  {features.map((f, i) => (
    <section class={`section sp-feature ${i % 2 === 0 ? 'bg-cream' : 'bg-shell'}`}>
      <div class="container">
        <div class={`feature-row reveal ${f.flip ? 'feature-row--flip' : ''}`}>
          <div class="feature-row__media">
            {f.image ? (
              <div class="sp-feature-frame">
                <img src={f.image} alt={f.imgAlt ?? f.heading} />
              </div>
            ) : (
              <div
                class="sp-feature-frame sp-feature-frame--placeholder"
                style={f.imgSurface ? `background-color: ${f.imgSurface}` : ''}
                role="img"
                aria-label={f.imgAlt ?? f.heading}
              >
                <span>{(f.imgAlt ?? f.heading).toLowerCase()}</span>
              </div>
            )}
          </div>
          <div class="feature-row__text">
            <span class="editorial-eyebrow">{f.chipLabel ?? chipLabel}</span>
            <h2 class="sp-feature-heading">{f.heading}</h2>
            <p class="sp-feature-body">{f.body}</p>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="sp-feature-cta">
              <span class="sp-feature-cta-rule" aria-hidden="true"></span>
              Get started
            </a>
          </div>
        </div>
      </div>
    </section>
  ))}


  <!-- ============================================================
       SUB-SERVICES — chip grid of conditions / treatments covered
       (Optional, only renders when subServices is provided)
       ============================================================ -->
  {subServices && (
    <section class={`section ${subServices.surface ?? 'bg-shell'}`}>
      <div class="container">
        <details class="reveal sp-sub-details">
          <summary class="sp-sub-summary">
            <span class="sp-sub-summary__label">
              <span class={`accent-chip ${chipClass}`}>{chipLabel}</span>
              <span class="sp-sub-summary__heading">{subServices.heading ?? 'what we cover'}</span>
            </span>
            <span class="sp-sub-summary__toggle" aria-hidden="true">+</span>
          </summary>
          {subServices.intro && <p class="sp-sub-intro">{subServices.intro}</p>}
          <ul class="sp-sub-list" role="list">
            {subServices.items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </details>
      </div>
    </section>
  )}


  <!-- ============================================================
       TESTIMONIALS — cream surface, dark quote cards
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal" style="margin-bottom: 3rem; text-align: center;">
        <span class="sp-section-eyebrow">Patient stories</span>
        <h2 style="margin-top: 0.75rem; font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4.5vw, 3rem);">What patients say.</h2>
      </div>
      <div class="sp-testimonials">
        {testimonials.map((t, i) => (
          <div class={`reveal testimonial-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
            <p class="testimonial-quote">{t.quote}</p>
            <p class="testimonial-attr">{t.attr}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================================
       HOW IT WORKS — cream surface
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal" style="text-align:center; margin-bottom:3.5rem;">
        <span class="label">how it works</span>
        <h2 style="margin-top:0.75rem;">Your path to better health</h2>
      </div>
      <div class="steps-grid">
        {steps.map((s, i) => (
          <div class={`reveal step-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
            <h3 style="margin-bottom:0.875rem;">{s.heading}</h3>
            <p style="color:var(--ink-secondary); font-size:var(--text-sm);">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================================
       FAQ — shell surface
       ============================================================ -->
  <section class="section bg-shell">
    <div class="container">
      <div class="reveal faq-layout">
        <div class="faq-heading">
          <span class="editorial-eyebrow">Common questions</span>
          <h2 style="margin-top:1rem; font-family:var(--font-serif); font-weight:400; font-size:clamp(2rem,4.5vw,3rem); line-height:1.1; letter-spacing:-0.015em;">Things people ask.</h2>
          <p style="color:var(--ink-secondary); margin-top:1rem; font-size:var(--text-sm);">
            More questions? <a href="/contact/" style="text-decoration:underline; text-underline-offset:3px;">Contact us.</a>
          </p>
          <div class="faq-decorative-frame" aria-hidden="true">
            <img src="/images/sig-leaf.jpg" alt="" />
          </div>
        </div>
        <div class="faq-list">
          {faq.map(item => (
            <details class="faq-item">
              <summary class="faq-summary">{item.q}</summary>
              <p class="faq-body">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       CTA — rounded dark card (MBS-Test signature)
       ============================================================ -->
  <section class="section sp-cta-section">
    <div class="container">
      <div class="reveal sp-cta-card">
        <img src="/images/sig-cta-dark.jpg" alt="" class="sp-cta-bg" aria-hidden="true" />
        <span class="sp-cta-deco sp-cta-deco--tr" aria-hidden="true"></span>
        <span class="sp-cta-deco sp-cta-deco--bl" aria-hidden="true"></span>
        <div class="sp-cta-inner">
          <span class="sp-cta-eyebrow">Ready when you are</span>
          <h2 class="sp-cta-title">Let&rsquo;s build your plan.</h2>
          <p class="sp-cta-sub">Same-week telehealth across Florida. Cash pay, no insurance needed.</p>
          <div class="sp-cta-actions">
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="sp-cta-btn sp-cta-btn--primary">
              book a visit
            </a>
            <a href="/contact/" class="sp-cta-btn sp-cta-btn--ghost">ask a question</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  /* ---- Service hero (MBS-Test editorial split) ---- */
  .sp-hero {
    background-color: var(--color-neutral);
    padding-top: 9rem;
    padding-bottom: 6rem;
    min-height: 92vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .sp-hero::before,
  .sp-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(60,56,54,0.06);
    pointer-events: none;
  }
  .sp-hero::before {
    width: 360px; height: 360px;
    top: 50%; left: -120px;
    transform: translateY(-50%);
    border-style: dashed;
  }
  .sp-hero::after {
    width: 480px; height: 480px;
    bottom: -240px; right: -120px;
  }
  .sp-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .sp-hero__grid { grid-template-columns: 6fr 6fr; gap: 4rem; }
  }
  .sp-hero__text { display: flex; flex-direction: column; gap: 1.75rem; }
  .sp-hero__title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    text-transform: lowercase;
    margin: 0;
  }
  .sp-hero__sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
    max-width: 48ch;
    margin: 0;
  }
  .sp-hero__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .sp-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 200ms ease;
    background: transparent;
    border: none;
    padding: 0;
  }
  .sp-hero__cta:hover { color: var(--color-rust); }
  .sp-hero__cta-rule {
    display: inline-block;
    width: 48px;
    height: 1px;
    background-color: currentColor;
    transition: width 250ms ease;
  }
  .sp-hero__cta:hover .sp-hero__cta-rule { width: 80px; }
  .sp-hero__cta--ghost { color: var(--color-tertiary); }

  /* Image card with rounded-2xl + small uppercase badge bottom-left */
  .sp-hero__media { position: relative; }
  .sp-hero__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
  }
  .sp-hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }
  .sp-hero__frame:hover img { transform: scale(1.04); }
  .sp-hero__frame--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .sp-hero__badge {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  @media (max-width: 767px) {
    .sp-hero { min-height: auto; padding-top: 7rem; }
    .sp-hero__frame { aspect-ratio: 16/10; }
    .sp-hero__badge { bottom: 1rem; left: 1rem; }
  }

  /* ---- Feature row (MBS-Test editorial split with rounded-2xl frame) ---- */
  .sp-feature {
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  .sp-feature-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
  }
  .sp-feature-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }
  .sp-feature-frame:hover img { transform: scale(1.04); }
  .sp-feature-frame--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  @media (max-width: 767px) {
    .sp-feature-frame { aspect-ratio: 4/3; }
  }

  .sp-feature-heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    margin: 1.25rem 0 1.25rem;
    max-width: 18ch;
  }
  .sp-feature-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
    max-width: 50ch;
    margin-bottom: 2.25rem;
  }
  .sp-feature-cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .sp-feature-cta:hover { color: var(--color-rust); }
  .sp-feature-cta-rule {
    display: inline-block;
    width: 48px;
    height: 1px;
    background-color: currentColor;
    transition: width 250ms ease;
  }
  .sp-feature-cta:hover .sp-feature-cta-rule { width: 80px; }

  .sp-feature-img {
    border-radius: var(--radius-xl);
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }

  /* ---- Sub-services collapsible (no chips, no boxes) ---- */
  .sp-sub-details {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: 0.5rem;
    max-width: 960px;
  }
  .sp-sub-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
  }
  .sp-sub-summary::-webkit-details-marker { display: none; }
  .sp-sub-summary__label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sp-sub-summary__label .accent-chip { margin-bottom: 0; }
  .sp-sub-summary__heading {
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--ink-primary);
    letter-spacing: var(--tracking-tight);
  }
  .sp-sub-summary__toggle {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--ink-secondary);
    transition: transform var(--dur-base) var(--ease-standard),
                background-color var(--dur-base) var(--ease-standard);
  }
  details[open] .sp-sub-summary__toggle {
    transform: rotate(45deg);
    background-color: var(--surface-sand);
  }
  .sp-sub-intro {
    color: var(--ink-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    margin-bottom: 1.5rem;
    padding-bottom: 0.25rem;
  }
  .sp-sub-list {
    list-style: none;
    margin: 0;
    padding-bottom: 1.5rem;
    columns: 1;
    column-gap: 2.5rem;
  }
  @media (min-width: 600px) { .sp-sub-list { columns: 2; } }
  @media (min-width: 1024px) { .sp-sub-list { columns: 3; } }
  .sp-sub-list li {
    break-inside: avoid;
    padding: 0.5rem 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Values */
  .sp-values {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .sp-values { grid-template-columns: repeat(3, 1fr); }
  }
  .sp-value-card {
    padding: 2.25rem 2rem;
    transition: transform var(--dur-base), border-color var(--dur-base);
  }
  .sp-value-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
  }
  .sp-value-card h3 { font-size: var(--text-xl); margin-bottom: 0.75rem; }
  .sp-value-card p  { font-size: var(--text-sm); color: var(--ink-secondary); max-width: none; }
  .sp-value-bar {
    display: block;
    width: 48px;
    height: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--accent-terracotta);
    margin-bottom: 1.25rem;
  }

  /* Features */
  .feature-row__text h2 { margin-bottom: 1rem; }
  .feature-row__text p  { color: var(--ink-secondary); font-size: var(--text-base); max-width: 52ch; }

  /* Testimonials */
  .sp-testimonials {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .sp-testimonials { grid-template-columns: repeat(3, 1fr); }
  }

  /* FAQ */
  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .faq-layout { grid-template-columns: 1fr 2fr; gap: 5rem; align-items: start; }
  }
  .faq-heading { position: sticky; top: 6rem; }
  .faq-decorative-frame {
    display: none;
    margin-top: 2rem;
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1/1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
  }
  .faq-decorative-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 1024px) {
    .faq-decorative-frame { display: block; }
  }

  /* ---- Steps (MBS-Test bento variant) ---- */
  .step-card {
    position: relative;
    padding: 2.5rem 2rem 2.25rem;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    overflow: hidden;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .step-card:hover { transform: translateY(-3px); }
  .step-card h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.875rem;
    line-height: 1.2;
    color: inherit;
  }
  /* nth-child variants: alternate cream → sage → primary → cream-bordered */
  .step-card:nth-child(2) {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }
  .step-card:nth-child(2) p { color: rgba(255,255,255,0.78) !important; }
  .step-card:nth-child(3) {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #FFFFFF;
  }
  .step-card:nth-child(3) p { color: rgba(255,255,255,0.72) !important; }
  .step-card:nth-child(4) {
    background-color: var(--color-surface-warm);
  }

  /* ---- Sub-services list: arrow-out chips MBS-Test style ----
     Adds a circle arrow on each item when present */
  .sp-sub-list li {
    position: relative;
    padding-right: 2.5rem;
  }
  .sp-sub-list li::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
