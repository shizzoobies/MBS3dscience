---
/**
 * Shared service page template.
 * Follows design-system.md page anatomy:
 * hero → value props → zigzag features → testimonials → how it works → faq → cta
 */

import Layout from '../layouts/Layout.astro';

interface Feature {
  heading: string;
  body: string;
  flip?: boolean;
  chipLabel?: string;
  chipClass?: string;
  imgAlt?: string;
  imgSurface?: string;
  image?: string;  // optional real image path, falls back to placeholder
}

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heroTitle: string;
  heroSub: string;
  chipLabel: string;
  chipClass: string;           // e.g. 'chip-coral'
  heroSurface?: string;        // default 'var(--surface-peach)'
  heroImage?: string;          // optional real hero image
  values: { icon?: string; heading: string; body: string }[];
  features: Feature[];
  testimonials: { quote: string; attr: string }[];
  steps: { heading: string; body: string }[];
  faq: FaqItem[];
  // Optional: render a "what's covered" chip grid (sub-services / conditions treated)
  subServices?: {
    heading?: string;
    intro?: string;
    surface?: string;          // section bg, defaults to bg-shell
    items: string[];
  };
}

const {
  title, description, eyebrow, heroTitle, heroSub,
  chipLabel, chipClass,
  heroSurface = 'var(--surface-peach)',
  heroImage,
  values, features, testimonials, steps, faq,
  subServices,
} = Astro.props;
---

<Layout title={title} description={description}>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="section service-hero" style={`background-color: ${heroSurface}; padding-top: 7rem;`}>
    <div class="container">
      <div class="hero-split">
        <div>
          <span class="hero-eyebrow">{eyebrow}</span>
          <h1 class="hero-title">{heroTitle}</h1>
          <p class="hero-sub">{heroSub}</p>
          <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top: 0.5rem;">
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              book a visit
            </a>
            <a href="/contact/" class="btn btn-secondary">ask a question</a>
          </div>
        </div>
        <div class="hero-media">
          {heroImage ? (
            <img src={heroImage} alt={`${title} at MBS Medical`} class="sp-hero-img" />
          ) : (
            <div class="img-placeholder img-placeholder--tall" role="img" aria-label={`${title} service`}>
              <span>{title.toLowerCase()} photo</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       VALUE PROPS — cream surface
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal sp-values">
        {values.map((v, i) => (
          <div class={`reveal card sp-value-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
            <span class="sp-value-bar" aria-hidden="true"></span>
            <h3>{v.heading}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURES — zigzag, alternating shell/sand
       ============================================================ -->
  {features.map((f, i) => (
    <section class={`section ${i % 2 === 0 ? 'bg-shell' : 'bg-sand'}`}>
      <div class="container">
        <div class={`feature-row reveal ${f.flip ? 'feature-row--flip' : ''}`}>
          <div class="feature-row__media">
            {f.image ? (
              <img src={f.image} alt={f.imgAlt ?? f.heading} class="sp-feature-img" />
            ) : (
              <div
                class="img-placeholder"
                style={f.imgSurface ? `background-color: ${f.imgSurface}` : ''}
                role="img"
                aria-label={f.imgAlt ?? f.heading}
              >
                <span>{(f.imgAlt ?? f.heading).toLowerCase()}</span>
              </div>
            )}
          </div>
          <div class="feature-row__text">
            {(f.chipLabel || f.chipClass) && (
              <span class={`accent-chip ${f.chipClass ?? chipClass}`}>
                {f.chipLabel ?? chipLabel}
              </span>
            )}
            <h2>{f.heading}</h2>
            <p>{f.body}</p>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary" style="margin-top: 2rem;">
              get started
            </a>
          </div>
        </div>
      </div>
    </section>
  ))}


  <!-- ============================================================
       SUB-SERVICES — chip grid of conditions / treatments covered
       (Optional, only renders when subServices is provided)
       ============================================================ -->
  {subServices && (
    <section class={`section ${subServices.surface ?? 'bg-shell'}`}>
      <div class="container">
        <details class="reveal sp-sub-details">
          <summary class="sp-sub-summary">
            <span class="sp-sub-summary__label">
              <span class={`accent-chip ${chipClass}`}>{chipLabel}</span>
              <span class="sp-sub-summary__heading">{subServices.heading ?? 'what we cover'}</span>
            </span>
            <span class="sp-sub-summary__toggle" aria-hidden="true">+</span>
          </summary>
          {subServices.intro && <p class="sp-sub-intro">{subServices.intro}</p>}
          <ul class="sp-sub-list" role="list">
            {subServices.items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </details>
      </div>
    </section>
  )}


  <!-- ============================================================
       TESTIMONIALS — cream surface, dark quote cards
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal" style="margin-bottom: 3rem; text-align: center;">
        <span class="sp-section-eyebrow">Patient stories</span>
        <h2 style="margin-top: 0.75rem; font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4.5vw, 3rem);">What patients say.</h2>
      </div>
      <div class="sp-testimonials">
        {testimonials.map((t, i) => (
          <div class={`reveal testimonial-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
            <p class="testimonial-quote">{t.quote}</p>
            <p class="testimonial-attr">{t.attr}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================================
       HOW IT WORKS — cream surface
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal" style="text-align:center; margin-bottom:3.5rem;">
        <span class="label">how it works</span>
        <h2 style="margin-top:0.75rem;">Your path to better health</h2>
      </div>
      <div class="steps-grid">
        {steps.map((s, i) => (
          <div class={`reveal step-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
            <span class="step-number">0{i + 1}</span>
            <h3 style="margin-top:1rem; margin-bottom:0.75rem;">{s.heading}</h3>
            <p style="color:var(--ink-secondary); font-size:var(--text-sm);">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================================
       FAQ — shell surface
       ============================================================ -->
  <section class="section bg-shell">
    <div class="container">
      <div class="reveal faq-layout">
        <div class="faq-heading">
          <span class="label">questions</span>
          <h2 style="margin-top:0.75rem;">Common questions</h2>
          <p style="color:var(--ink-secondary); margin-top:1rem; font-size:var(--text-sm);">
            More questions? <a href="/contact/" style="text-decoration:underline; text-underline-offset:3px;">Contact us.</a>
          </p>
        </div>
        <div class="faq-list">
          {faq.map(item => (
            <details class="faq-item">
              <summary class="faq-summary">{item.q}</summary>
              <p class="faq-body">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       CTA — rounded dark card (MBS-Test signature)
       ============================================================ -->
  <section class="section sp-cta-section">
    <div class="container">
      <div class="reveal sp-cta-card">
        <span class="sp-cta-deco sp-cta-deco--tr" aria-hidden="true"></span>
        <span class="sp-cta-deco sp-cta-deco--bl" aria-hidden="true"></span>
        <div class="sp-cta-inner">
          <span class="sp-cta-eyebrow">Ready when you are</span>
          <h2 class="sp-cta-title">Let&rsquo;s build your plan.</h2>
          <p class="sp-cta-sub">Same-week telehealth across Florida. Cash pay, no insurance needed.</p>
          <div class="sp-cta-actions">
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="sp-cta-btn sp-cta-btn--primary">
              book a visit
            </a>
            <a href="/contact/" class="sp-cta-btn sp-cta-btn--ghost">ask a question</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  /* Hero */
  .service-hero { min-height: 85vh; display: flex; align-items: center; }

  .sp-hero-img {
    border-radius: var(--radius-xl);
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 767px) {
    .sp-hero-img { aspect-ratio: 16/9; }
  }

  .sp-feature-img {
    border-radius: var(--radius-xl);
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }

  /* ---- Sub-services collapsible (no chips, no boxes) ---- */
  .sp-sub-details {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: 0.5rem;
    max-width: 960px;
  }
  .sp-sub-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
  }
  .sp-sub-summary::-webkit-details-marker { display: none; }
  .sp-sub-summary__label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sp-sub-summary__label .accent-chip { margin-bottom: 0; }
  .sp-sub-summary__heading {
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--ink-primary);
    letter-spacing: var(--tracking-tight);
  }
  .sp-sub-summary__toggle {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--ink-secondary);
    transition: transform var(--dur-base) var(--ease-standard),
                background-color var(--dur-base) var(--ease-standard);
  }
  details[open] .sp-sub-summary__toggle {
    transform: rotate(45deg);
    background-color: var(--surface-sand);
  }
  .sp-sub-intro {
    color: var(--ink-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    margin-bottom: 1.5rem;
    padding-bottom: 0.25rem;
  }
  .sp-sub-list {
    list-style: none;
    margin: 0;
    padding-bottom: 1.5rem;
    columns: 1;
    column-gap: 2.5rem;
  }
  @media (min-width: 600px) { .sp-sub-list { columns: 2; } }
  @media (min-width: 1024px) { .sp-sub-list { columns: 3; } }
  .sp-sub-list li {
    break-inside: avoid;
    padding: 0.5rem 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Values */
  .sp-values {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .sp-values { grid-template-columns: repeat(3, 1fr); }
  }
  .sp-value-card {
    padding: 2.25rem 2rem;
    transition: transform var(--dur-base), border-color var(--dur-base);
  }
  .sp-value-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
  }
  .sp-value-card h3 { font-size: var(--text-xl); margin-bottom: 0.75rem; }
  .sp-value-card p  { font-size: var(--text-sm); color: var(--ink-secondary); max-width: none; }
  .sp-value-bar {
    display: block;
    width: 48px;
    height: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--accent-terracotta);
    margin-bottom: 1.25rem;
  }

  /* Features */
  .feature-row__text h2 { margin-bottom: 1rem; }
  .feature-row__text p  { color: var(--ink-secondary); font-size: var(--text-base); max-width: 52ch; }

  /* Testimonials */
  .sp-testimonials {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .sp-testimonials { grid-template-columns: repeat(3, 1fr); }
  }

  /* FAQ */
  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .faq-layout { grid-template-columns: 1fr 2fr; gap: 5rem; align-items: start; }
  }
  .faq-heading { position: sticky; top: 6rem; }

  /* Steps */
  .step-card h3 { font-size: var(--text-xl); }

  /* ---- Closing CTA: rounded dark card ---- */
  .sp-cta-section {
    background-color: var(--color-neutral);
    padding-block: 6rem;
  }
  .sp-cta-card {
    position: relative;
    background-color: var(--color-primary);
    color: #FFFFFF;
    border-radius: var(--radius-2xl);
    padding: 5rem 2rem;
    text-align: center;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .sp-cta-card { padding: 7rem 4rem; }
  }
  .sp-cta-deco {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.08);
    pointer-events: none;
  }
  .sp-cta-deco--tr { width: 280px; height: 280px; top: 0; right: 0; transform: translate(40%, -40%); }
  .sp-cta-deco--bl { width: 220px; height: 220px; bottom: 0; left: 0; transform: translate(-40%, 40%); border-style: dashed; }
  .sp-cta-inner { position: relative; z-index: 1; max-width: 720px; margin-inline: auto; }
  .sp-cta-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: 2rem;
  }
  .sp-cta-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    margin: 0;
  }
  .sp-cta-sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(255,255,255,0.65);
    max-width: 52ch;
    margin: 1.75rem auto 0;
  }
  .sp-cta-actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 2.75rem;
  }
  .sp-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 16px 38px;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .sp-cta-btn--primary {
    background-color: var(--color-accent);
    color: #FFFFFF;
    border-color: var(--color-accent);
  }
  .sp-cta-btn--primary:hover {
    background-color: #FFFFFF;
    color: var(--color-accent);
    border-color: #FFFFFF;
  }
  .sp-cta-btn--ghost {
    background-color: transparent;
    color: rgba(255,255,255,0.85);
    border-color: rgba(255,255,255,0.30);
  }
  .sp-cta-btn--ghost:hover {
    background-color: rgba(255,255,255,0.08);
    color: #FFFFFF;
    border-color: rgba(255,255,255,0.6);
  }
</style>
