  }
  @media (max-width: 767px) {
    /* On narrow screens the text column is full width, so darken the
       whole overlay uniformly for readability rather than relying on
       the side-anchored gradient. */
    .sp-spotlight-hero__overlay,
    .sp-spotlight-hero--flip .sp-spotlight-hero__overlay {
      background: linear-gradient(
        180deg,
        rgba(46, 43, 42, 0.72) 0%,
        rgba(46, 43, 42, 0.90) 100%
      );
    }
    .sp-spotlight-hero--flip .sp-spotlight-hero__container,
    .sp-spotlight-hero:not(.sp-spotlight-hero--flip) .sp-spotlight-hero__container {
