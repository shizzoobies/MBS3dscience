---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Home"
  description="MBS Medical: Veteran-owned telehealth providing primary care, weight loss, mental health, and more across Florida. Cash pay, same-week appointments."
>

  <!-- ============================================================
       HERO — full-bleed flag video with glass text panel on the right
       ============================================================ -->
  <section class="hero-fullbleed">
    <video
      id="hero-flag-video"
      class="hero-fullbleed__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/images/flag-intro.mp4" type="video/mp4" />
    </video>
    <div id="hero-flag-scrim" class="hero-fullbleed__scrim" aria-hidden="true"></div>

    <div class="hero-fullbleed__grid container">
      <div class="hero-fullbleed__text">
        <span class="hero-fullbleed__eyebrow">veteran-owned · florida telehealth</span>
        <h1 class="hero-fullbleed__title">
          healthcare that treats<br />the whole person
        </h1>
        <p class="hero-fullbleed__sub">
          One consistent provider. No insurance required. Same-week appointments across Florida, from wherever you are.
        </p>
        <div class="hero-fullbleed__actions">
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-hero-primary">
            book a visit
          </a>
          <a href="/services/" class="btn btn-hero-secondary">
            explore services
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Stop the flag animation after 10 seconds; deepen the scrim slightly so
    // text stays readable on the frozen frame.
    const heroVid = document.getElementById('hero-flag-video') as HTMLVideoElement | null;
    const heroScrim = document.getElementById('hero-flag-scrim');
    if (heroVid) {
      setTimeout(() => {
        try { heroVid.pause(); } catch {}
        if (heroScrim) heroScrim.classList.add('is-paused');
      }, 10000);
    }
  </script>


  <!-- ============================================================
       VALUE PROPS — cream surface, 3 columns
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal value-header">
        <span class="label">why mbs medical</span>
        <h2>Care built differently</h2>
      </div>

      <div class="value-grid">
        <div class="reveal value-card">
          <span class="value-accent value-accent--coral" aria-hidden="true"></span>
          <h3>Whole-person care</h3>
          <p>We treat you, not a symptom list. Mental, physical, and preventive health addressed by one provider who knows your full history.</p>
        </div>
        <div class="reveal reveal-delay-1 value-card">
          <span class="value-accent value-accent--sage" aria-hidden="true"></span>
          <h3>No insurance needed</h3>
          <p>Cash pay keeps it simple. No referrals, no prior authorizations, no surprise bills. Transparent pricing, real care.</p>
        </div>
        <div class="reveal reveal-delay-2 value-card">
          <span class="value-accent value-accent--sky" aria-hidden="true"></span>
          <h3>Telehealth, statewide</h3>
          <p>Secure video visits from your home, office, or anywhere in Florida. Evening appointments available. Same-week booking.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 1 — weight loss, shell surface, coral accent
       image LEFT, text RIGHT
       ============================================================ -->
  <section class="section bg-shell">
    <div class="container">
      <div class="feature-row reveal">
        <div class="feature-row__media">
          <div class="img-placeholder" role="img" aria-label="Person living an active healthy lifestyle">
            <span>weight loss photo</span>
          </div>
        </div>
        <div class="feature-row__text">
          <span class="accent-chip chip-coral">medical weight loss</span>
          <h2>Finally, a weight loss plan that sticks</h2>
          <p>GLP-1 receptor agonists have changed what's medically possible for weight management. We evaluate whether they're right for you, with real labs, honest conversation, and a plan built around your life.</p>
          <p style="margin-top: 1rem; color: var(--ink-secondary);">No gimmicks. No cookie-cutter programs. Just clinically supervised care from a provider who stays with you through the whole process.</p>
          <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/weight-loss/" class="btn btn-primary">learn more</a>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">book a visit</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 2 — men's health / TRT, sand surface, terracotta
       image RIGHT, text LEFT (flip)
       ============================================================ -->
  <section class="section bg-sand">
    <div class="container">
      <div class="feature-row feature-row--flip reveal">
        <div class="feature-row__media">
          <div class="img-placeholder img-placeholder--sand" role="img" aria-label="Active man in his prime">
            <span>men's health photo</span>
          </div>
        </div>
        <div class="feature-row__text">
          <span class="accent-chip chip-terracotta">men's health</span>
          <h2>Get your edge back</h2>
          <p>Testosterone naturally declines after 30. Less energy, slower recovery, lower drive. Most men push through it and call it aging. You don't have to.</p>
          <p style="margin-top: 1rem; color: var(--ink-secondary);">We start with labs for a clear, honest picture. If TRT is right for you, we build a plan. If it's not, we'll tell you that too.</p>
          <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/mens-health/" class="btn btn-primary">learn more</a>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">book a visit</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 3 — mental health, shell surface, sky accent
       image LEFT, text RIGHT
       ============================================================ -->
  <section class="section bg-shell">
    <div class="container">
      <div class="feature-row reveal">
        <div class="feature-row__media">
          <img src="/images/mental-health-tired.jpg" alt="Mental health and sleep care" class="feature-img" />
        </div>
        <div class="feature-row__text">
          <span class="accent-chip chip-sky">mental health</span>
          <h2>Sleep, anxiety, and what's keeping you stuck</h2>
          <p>Restless nights. A mind that won't slow down. A fog that follows you into the day. These aren't just inconveniences. They're treatable.</p>
          <p style="margin-top: 1rem; color: var(--ink-secondary);">We take mental health seriously as a part of whole-person care, not a referral you never follow through on.</p>
          <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/mental-health/" class="btn btn-primary">learn more</a>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">book a visit</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       STATS — ink surface
       ============================================================ -->
  <section class="section bg-ink">
    <div class="container">
      <div class="reveal" style="text-align: center; margin-bottom: 3rem;">
        <h2 style="color: var(--ink-inverse);">Numbers that mean something</h2>
      </div>
      <div class="stats-row">
        <div class="reveal stat-item">
          <div class="stat-item__number" style="color: var(--ink-inverse);">64+</div>
          <div class="stat-item__label" style="color: rgba(250,246,240,0.55);">years combined experience</div>
        </div>
        <div class="reveal reveal-delay-1 stat-item">
          <div class="stat-item__number" style="color: var(--ink-inverse);">11</div>
          <div class="stat-item__label" style="color: rgba(250,246,240,0.55);">specialties offered</div>
        </div>
        <div class="reveal reveal-delay-2 stat-item">
          <div class="stat-item__number" style="color: var(--accent-terracotta);">FL</div>
          <div class="stat-item__label" style="color: rgba(250,246,240,0.55);">statewide telehealth</div>
        </div>
        <div class="reveal reveal-delay-3 stat-item">
          <div class="stat-item__number" style="color: var(--ink-inverse);">12</div>
          <div class="stat-item__label" style="color: rgba(250,246,240,0.55);">years U.S. Army, founder</div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       TESTIMONIALS — ink surface, serif quotes
       ============================================================ -->
  <section class="section bg-ink">
    <div class="container">
      <div class="reveal" style="margin-bottom: 3rem;">
        <span class="label" style="color: rgba(250,246,240,0.45);">patient stories</span>
        <h2 style="color: var(--ink-inverse); margin-top: 0.75rem;">What our patients are saying</h2>
      </div>

      <div class="testimonials-grid">
        <div class="reveal testimonial-card">
          <p class="testimonial-quote">finally a provider who listened. not just to my symptoms, but to my actual life. i've never felt more cared for by a doctor.</p>
          <p class="testimonial-attr">Primary Care Patient &mdash; Sarasota, FL</p>
        </div>
        <div class="reveal reveal-delay-1 testimonial-card">
          <p class="testimonial-quote">i was skeptical about telehealth but the experience was better than any in-person visit i've had. same-week appointment, provider knew my chart.</p>
          <p class="testimonial-attr">Weight Loss Patient &mdash; Tampa, FL</p>
        </div>
        <div class="reveal reveal-delay-2 testimonial-card">
          <p class="testimonial-quote">david took my testosterone concerns seriously from the first call. within a month i felt like myself again. the lab-driven approach made all the difference.</p>
          <p class="testimonial-attr">Men's Health Patient &mdash; Bradenton, FL</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       HOW IT WORKS — cream surface
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal" style="text-align: center; margin-bottom: 3.5rem;">
        <span class="label">how it works</span>
        <h2 style="margin-top: 0.75rem;">Three steps to better care</h2>
      </div>

      <div class="steps-grid">
        <div class="reveal step-card">
          <span class="step-number">01</span>
          <h3 style="margin-bottom: 0.75rem; margin-top: 1rem;">Book online</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Pick a time through our secure portal. Same-week availability, with evening appointments included. No waiting rooms.</p>
        </div>
        <div class="reveal reveal-delay-1 step-card">
          <span class="step-number">02</span>
          <h3 style="margin-bottom: 0.75rem; margin-top: 1rem;">Meet your provider</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Secure video visit from anywhere in Florida. Real conversation with a provider who has time for you.</p>
        </div>
        <div class="reveal reveal-delay-2 step-card">
          <span class="step-number">03</span>
          <h3 style="margin-bottom: 0.75rem; margin-top: 1rem;">Get your plan</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">A personalized care plan with ongoing support, medication management, and follow-ups that evolve with you.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FAQ — shell surface
       ============================================================ -->
  <section class="section bg-shell">
    <div class="container">
      <div class="reveal faq-layout">
        <div class="faq-heading">
          <span class="label">common questions</span>
          <h2 style="margin-top: 0.75rem;">Things people usually ask</h2>
          <p style="color: var(--ink-secondary); margin-top: 1rem; font-size: var(--text-sm);">Don't see your question? <a href="/contact/" style="text-decoration: underline; text-underline-offset: 3px;">Contact us directly.</a></p>
        </div>

        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-summary">do i need insurance to use MBS Medical?</summary>
            <p class="faq-body">No. We are a cash-pay practice. You pay directly, which keeps things simple, transparent, and without the delays that come with insurance. We can provide a superbill for FSA/HSA reimbursement if needed.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">what states do you serve?</summary>
            <p class="faq-body">We are licensed to provide telehealth services to patients located in Florida. You must be physically in Florida at the time of your visit.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">how quickly can i get an appointment?</summary>
            <p class="faq-body">We offer same-week appointments and often same-day or next-day availability. Evening slots are included. Book through our secure online portal anytime.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">will i see the same provider every time?</summary>
            <p class="faq-body">Yes. Continuity of care is one of the core values of this practice. You'll build a relationship with your provider who knows your history, your medications, and your goals.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">can you prescribe medications?</summary>
            <p class="faq-body">Yes. Our providers are licensed to evaluate, diagnose, and prescribe medications including controlled substances where appropriate and legal. Prescriptions are sent electronically to your preferred pharmacy.</p>
          </details>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       CLOSING CTA — ink surface
       ============================================================ -->
  <section class="section bg-ink cta-section">
    <div class="container">
      <div class="reveal cta-inner">
        <h2 style="color: var(--ink-inverse); font-size: var(--text-5xl);">The care you've always deserved</h2>
        <p style="color: rgba(250,246,240,0.7); font-size: var(--text-lg); margin-top: 1.5rem; max-width: 52ch; margin-inline: auto;">
          Veteran-owned. Patient-first. No insurance required. Same-week telehealth across Florida from a provider who shows up for you.
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 2.5rem;">
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-inverse">
            book a free consultation
          </a>
          <a href="/contact/" class="btn btn-outline-inverse">
            ask a question
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  /* ---- Full-bleed flag hero with glass text panel on the right ---- */
  .hero-fullbleed {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background-color: var(--surface-ink);
    display: flex;
    align-items: center;
    padding-top: 68px;
  }
  .hero-fullbleed__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  /* Left-side scrim: editorial asymmetric — text sits left over the
     flag, scrim darkens the left half so the copy reads cleanly. */
  .hero-fullbleed__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(26,26,24,0.80) 0%,
        rgba(26,26,24,0.60) 30%,
        rgba(26,26,24,0.20) 65%,
        rgba(26,26,24,0.10) 100%
      );
    pointer-events: none;
    transition: background 1200ms ease;
  }
  /* When the video pauses at 10s, slightly deepen the scrim */
  .hero-fullbleed__scrim.is-paused {
    background:
      linear-gradient(
        90deg,
        rgba(26,26,24,0.86) 0%,
        rgba(26,26,24,0.70) 30%,
        rgba(26,26,24,0.35) 65%,
        rgba(26,26,24,0.20) 100%
      );
  }

  .hero-fullbleed__grid {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    padding-block: 4rem;
  }
  @media (min-width: 900px) {
    .hero-fullbleed__grid {
      grid-template-columns: minmax(440px, 580px) 1fr;
      gap: 3rem;
    }
  }

  /* Frame-less text block, anchored left on desktop (editorial asymmetric) */
  .hero-fullbleed__text {
    max-width: 580px;
    color: var(--color-neutral);
    grid-column: 1;
    text-shadow: 0 2px 10px rgba(0,0,0,0.35);
  }
  @media (min-width: 900px) {
    .hero-fullbleed__text {
      justify-self: start;
    }
  }

  .hero-fullbleed__eyebrow {
    display: inline-block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--weight-regular);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    color: var(--accent-butter);
    margin-bottom: 1.25rem;
    text-transform: lowercase;
  }
  .hero-fullbleed__title {
    font-family: var(--font-serif);
    font-weight: var(--weight-regular);
    font-size: var(--text-5xl);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-transform: lowercase;
    color: var(--ink-inverse);
    margin-bottom: 1.5rem;
  }
  .hero-fullbleed__sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(250,246,240,0.92);
    margin-bottom: 2rem;
    max-width: 44ch;
    font-weight: var(--weight-regular);
  }
  .hero-fullbleed__actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  /* Hero buttons: frame-free, high-contrast without a card behind them */
  .btn-hero-primary,
  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1;
    text-transform: lowercase;
    padding: 14px 32px;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    text-decoration: none;
    transition: background-color var(--dur-base), color var(--dur-base),
                border-color var(--dur-base), transform var(--dur-fast);
    text-shadow: none;
    letter-spacing: 0;
  }
  .btn-hero-primary {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }
  .btn-hero-primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
  .btn-hero-secondary {
    background-color: rgba(250,246,240,0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-color: rgba(250,246,240,0.4);
    color: var(--ink-inverse);
  }
  .btn-hero-secondary:hover {
    background-color: var(--ink-inverse);
    border-color: var(--ink-inverse);
    color: var(--ink-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fullbleed__video { display: none; }
    .hero-fullbleed { background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%); }
  }

  /* ---- Value cards: slim accent bar replaces emoji icons ---- */
  .value-accent {
    display: block;
    width: 48px;
    height: 4px;
    border-radius: var(--radius-pill);
    margin-bottom: 1.25rem;
  }
  .value-accent--coral,
  .value-accent--sage,
  .value-accent--sky { background-color: var(--color-accent); }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0;
  }

  .hero-trust {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero-badge {
    position: absolute;
    bottom: -1.5rem;
    left: -1rem;
    background-color: var(--surface-cream);
    border-radius: var(--radius-lg);
    padding: 1rem 1.5rem;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .hero-badge__number {
    font-size: 2.5rem;
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--accent-terracotta);
    text-transform: none;
  }
  .hero-badge__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  @media (max-width: 767px) {
    .hero-badge { display: none; }
  }

  /* Value props */
  .value-header {
    margin-bottom: 3rem;
  }
  .value-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .value-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .value-card {
    background-color: var(--surface-shell);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    border: 1px solid var(--color-border);
    transition: transform var(--dur-base) var(--ease-standard),
                border-color var(--dur-base) var(--ease-standard);
  }
  .value-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
  }
  .value-card h3 {
    font-size: var(--text-xl);
    margin-bottom: 0.75rem;
  }
  .value-card p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Feature rows */
  .feature-row__text h2 { margin-bottom: 1rem; }
  .feature-row__text p {
    font-size: var(--text-base);
    color: var(--ink-secondary);
    max-width: 52ch;
  }

  /* Testimonials */
  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .testimonials-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Steps */
  .step-card h3 { font-size: var(--text-xl); }

  /* FAQ */
  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .faq-layout { grid-template-columns: 1fr 2fr; gap: 5rem; align-items: start; }
  }
  .faq-heading { position: sticky; top: 6rem; }

  /* CTA */
  .cta-section { text-align: center; }
  .cta-inner { max-width: 720px; margin-inline: auto; }
</style>
