---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Contact MBS Medical. Telehealth serving all of Florida. Cash pay, same-week appointments. Reach us by phone, email, or book online."
>

  <!-- Hero — full-bleed cinematic banner -->
  <section class="contact-hero">
    <img src="/images/sig-leaf.jpg" alt="" class="contact-hero__bg" aria-hidden="true" />
    <div class="contact-hero__scrim" aria-hidden="true"></div>
    <div class="container contact-hero__inner">
      <span class="contact-hero__eyebrow">Get in touch</span>
      <h1 class="contact-hero__title">Let&rsquo;s talk about your health.</h1>
      <p class="contact-hero__sub">
        Have a question before booking? Want to know if we&rsquo;re the right fit? Reach out. We&rsquo;re real people and we&rsquo;ll respond promptly.
      </p>
    </div>
  </section>

  <style>
    .contact-hero {
      position: relative;
      min-height: 38vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 6.5rem 1.5rem 3rem;
      background-color: var(--color-primary);
    }
    @media (min-width: 768px) {
      .contact-hero {
        min-height: 42vh;
        padding: 8rem 1.5rem 4rem;
      }
    }
    .contact-hero__bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.55;
    }
    .contact-hero__scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(60,56,54,0.45) 0%, rgba(60,56,54,0.62) 60%, rgba(60,56,54,0.78) 100%);
      pointer-events: none;
    }
    .contact-hero__inner {
      position: relative;
      z-index: 1;
      max-width: 760px;
      color: #FFFFFF;
    }
    .contact-hero__eyebrow {
      display: inline-block;
      font-size: 11px;
      font-weight: var(--weight-bold);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--color-rust);
      margin-bottom: 1.25rem;
      text-shadow: 0 1px 8px rgba(0,0,0,0.5);
    }
    .contact-hero__title {
      font-family: var(--font-serif);
      font-weight: 300;
      font-size: clamp(2.5rem, 6vw, 4.25rem);
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: #FFFFFF;
      text-transform: lowercase;
      margin: 0 0 1.25rem;
      max-width: 18ch;
      text-shadow: 0 2px 12px rgba(0,0,0,0.4);
    }
    .contact-hero__sub {
      font-size: var(--text-lg);
      line-height: var(--leading-relaxed);
      color: rgba(255,255,255,0.88);
      max-width: 56ch;
      margin: 0;
      text-shadow: 0 1px 8px rgba(0,0,0,0.4);
    }
  </style>


  <!-- Contact layout -->
  <section class="section bg-cream">
    <div class="container">
      <div class="contact-layout">

        <!-- Info column -->
        <div class="contact-info">
          <div class="reveal contact-card">
            <span class="accent-chip chip-coral">ready to book</span>
            <h3>Book a visit</h3>
            <p>Same-week availability, evening appointments included. Book in minutes, no insurance needed.</p>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="margin-top: 1.5rem;">
              open booking portal
            </a>
          </div>

          <div class="reveal reveal-delay-1 contact-card">
            <span class="accent-chip chip-sage">availability</span>
            <h3>Response time</h3>
            <p>Use the form to send us a question, concern, or just say hello. We respond within one business day.</p>
          </div>

          <div class="reveal reveal-delay-2 contact-card contact-card--dark">
            <span class="accent-chip chip-butter">service area</span>
            <h3>All of Florida</h3>
            <p>We provide telehealth services to patients physically located anywhere in the state of Florida. You do not need to be near our primary location.</p>
          </div>
        </div>

        <!-- Contact form -->
        <div class="reveal contact-form-wrap">
          <h2 style="margin-bottom: 0.5rem;">Send us a message</h2>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm); margin-bottom: 2rem;">We'll get back to you within one business day.</p>

          <form class="contact-form" name="contact" method="POST" action="/contact/success/" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="first-name">first name</label>
                <input type="text" id="first-name" name="first-name" class="input" placeholder="Your first name" required />
              </div>
              <div class="form-group">
                <label for="last-name">last name</label>
                <input type="text" id="last-name" name="last-name" class="input" placeholder="Your last name" required />
              </div>
            </div>

            <div class="form-group">
              <label for="email">email address</label>
              <input type="email" id="email" name="email" class="input" placeholder="you@example.com" required />
            </div>

            <div class="form-group">
              <label for="phone">phone (optional)</label>
              <input type="tel" id="phone" name="phone" class="input" placeholder="(123) 456-7890" />
            </div>

            <div class="form-group">
              <label for="service">service of interest</label>
              <select id="service" name="service" class="input">
                <option value="">choose a service...</option>
                <option>Primary Care</option>
                <option>Medical Weight Loss</option>
                <option>Men's Health / TRT</option>
                <option>Women's Health</option>
                <option>Mental Health</option>
                <option>Longevity &amp; Performance</option>
                <option>Sexual Health</option>
                <option>Hair &amp; Dermatology</option>
                <option>Lab Testing</option>
                <option>Lifestyle Medicine</option>
                <option>Concierge Medicine</option>
                <option>Not sure yet</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">message</label>
              <textarea id="message" name="message" class="input" rows="5" placeholder="Tell us a little about what's on your mind. No pressure to share more than you're comfortable with." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
              send message
            </button>

            <p style="font-size: var(--text-xs); color: var(--ink-muted); margin-top: 1rem; text-align: center;">
              This form is not for medical emergencies. If you are experiencing a medical emergency, call 911.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .contact-layout { grid-template-columns: 1fr 1.6fr; gap: 5rem; align-items: start; }
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-card {
    background-color: var(--surface-shell);
    border-radius: var(--radius-lg);
    padding: 2rem;
    border: 1px solid var(--color-border);
    transition: transform var(--dur-base), border-color var(--dur-base);
  }
  .contact-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
  }
  .contact-card h3 {
    font-size: var(--text-xl);
    margin-top: 0.75rem;
    margin-bottom: 0.625rem;
  }
  .contact-card p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    max-width: none;
    line-height: var(--leading-relaxed);
  }
  .contact-card--dark {
    background-color: var(--surface-ink);
    border-color: rgba(250,246,240,0.08);
  }
  .contact-card--dark h3 { color: var(--ink-inverse); }
  .contact-card--dark p { color: rgba(250,246,240,0.72); }

  .contact-form-wrap {
    background-color: var(--surface-shell);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    border: 1px solid var(--border-subtle);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 600px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  textarea.input {
    resize: vertical;
    min-height: 120px;
    font-family: var(--font-sans);
    line-height: var(--leading-relaxed);
  }
</style>
