---
const serviceCategories = [
  {
    label: 'primary care',
    items: [
      { label: 'Primary Care',       href: '/primary-care/' },
      { label: 'Lab Testing',        href: '/labs/' },
      { label: 'Lifestyle Medicine', href: '/lifestyle-medicine/' }
    ]
  },
  {
    label: 'weight & performance',
    items: [
      { label: 'Medical Weight Loss',     href: '/weight-loss/' },
      { label: 'Everyday Vitality',       href: '/everyday-vitality/' },
      { label: 'Longevity & Performance', href: '/longevity/' }
    ]
  },
  {
    label: 'hormone & wellness',
    items: [
      { label: "Men's Health",        href: '/mens-health/' },
      { label: "Women's Health",      href: '/womens-health/' },
      { label: 'Sexual Health',       href: '/sexual-health/' },
      { label: 'Hair & Dermatology',  href: '/hair-dermatology/' }
    ]
  },
  {
    label: 'specialty & premium',
    items: [
      { label: 'Mental Health',      href: '/mental-health/' },
      { label: 'Concierge Medicine', href: '/concierge-medicine/' }
    ]
  }
];

const FULLSCRIPT_URL = 'https://us.fullscript.com/welcome/dhervig?utm_medium=webreferral&utm_source=other&utm_campaign=abmwebbuttons_light_500x500.svg&signup_source=website_buttons';

const simpleNavLinks: Array<{ label: string; href: string; external?: boolean }> = [
  { label: 'About', href: '/about/' },
  { label: 'Supplements', href: FULLSCRIPT_URL, external: true },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner container">
    <!-- Wordmark / logo -->
    <a href="/" class="wordmark" aria-label="MBS Medical home">
      <img src="/images/logo-light.svg" alt="MBS Medical" width="716" height="380" class="wordmark-img" />
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav" aria-label="Main navigation">
      <!-- Services: mega-menu dropdown -->
      <div class="nav-dropdown" id="services-dropdown">
        <button
          type="button"
          class:list={['nav-link', 'nav-dropdown__trigger', { active: currentPath.startsWith('/services/') || serviceCategories.some(c => c.items.some(i => currentPath.startsWith(i.href))) }]}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="services-mega"
        >
          Services
          <svg class="nav-dropdown__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div id="services-mega" class="nav-mega" role="menu">
          <div class="nav-mega__grid">
            {serviceCategories.map(cat => (
              <div class="nav-mega__col">
                <span class="nav-mega__heading">{cat.label}</span>
                <ul>
                  {cat.items.map(item => (
                    <li>
                      <a href={item.href} role="menuitem">{item.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="nav-mega__footer">
            <a href="/services/" class="nav-mega__all">View all services &rarr;</a>
          </div>
        </div>
      </div>

      {simpleNavLinks.map(link => (
        link.external ? (
          <a
            href={link.href}
            class="nav-link nav-link--external"
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label}
            <svg class="nav-link__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        ) : (
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath.startsWith(link.href) }]}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <!-- CTA -->
    <div class="header-cta">
      <a
        href="https://mindbodyspiritmedicine8154.practicebetter.io/#/signin"
        target="_blank"
        rel="noopener noreferrer"
        class="header-cta-btn"
      >
        patient portal
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      class="hamburger"
      id="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <!-- Services grouped in mobile drawer -->
      <div class="mobile-services">
        <a href="/services/" class="mobile-nav-link">Services</a>
        {serviceCategories.map(cat => (
          <div class="mobile-services__group">
            <span class="mobile-services__heading">{cat.label}</span>
            <ul>
              {cat.items.map(item => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {simpleNavLinks.map(link => (
        link.external ? (
          <a href={link.href} class="mobile-nav-link" target="_blank" rel="noopener noreferrer">
            {link.label} ↗
          </a>
        ) : (
          <a href={link.href} class="mobile-nav-link">
            {link.label}
          </a>
        )
      ))}
      <a
        href="https://mbsmedical.practicebetter.io"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary mobile-cta"
      >
        book a visit
      </a>
    </nav>
  </div>
</header>

<style>
  /* ---- Header shell (cream, MBS-Test natural style) ----
     Solid cream so dark video on the home hero never bleeds through and
     darkens the dark text. Subtle blur retained for modern feel. */
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background-color: rgba(249,247,242,0.96);
    backdrop-filter: blur(10px) saturate(1.05);
    -webkit-backdrop-filter: blur(10px) saturate(1.05);
    border-bottom: 1px solid rgba(60,56,54,0.10);
    transition: background-color 250ms ease, border-color 250ms ease;
  }
  .site-header.scrolled {
    background-color: var(--color-neutral);
    border-bottom-color: rgba(60,56,54,0.14);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 68px;
  }

  /* ---- Wordmark / logo image ---- */
  .wordmark {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    transition: opacity 200ms ease;
  }
  .wordmark:hover { opacity: 0.85; }
  .wordmark-img {
    height: 42px;
    width: auto;
    display: block;
    /* Logo already has transparent background so it sits cleanly on dark header */
  }

  /* ---- Desktop nav ---- */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .desktop-nav { display: flex; }
  }

  .nav-link {
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(60,56,54,0.55);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary);
    border-bottom-color: var(--color-rust);
  }
  .nav-link--external {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .nav-link__arrow {
    width: 10px;
    height: 10px;
    transition: transform 200ms ease;
  }
  .nav-link--external:hover .nav-link__arrow {
    transform: translate(1.5px, -1.5px);
  }

  /* ---- Mega-menu dropdown ---- */
  .nav-dropdown { position: relative; }
  .nav-dropdown__trigger {
    background: transparent;
    border: none;
    padding: 0 0 2px 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
  }
  .nav-dropdown__chevron {
    width: 12px;
    height: 12px;
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .nav-dropdown.is-open .nav-dropdown__chevron { transform: rotate(180deg); }

  .nav-mega {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: 14px;   /* visual offset from trigger */
    transform: translateX(-50%) translateY(-6px);
    min-width: 720px;
    max-width: 860px;
    background-color: var(--surface-cream);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px rgba(26,26,26,0.18);
    padding: 1.75rem 2rem 1.25rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }
  /* Invisible hover bridge: fills the gap between trigger and menu so
     moving the mouse down from "Services" into the menu never leaves
     the hover area. Only active while open. */
  .nav-mega::before {
    content: '';
    position: absolute;
    top: -20px;
    left: 0;
    right: 0;
    height: 20px;
    background: transparent;
  }
  .nav-dropdown.is-open .nav-mega {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .nav-mega__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
  }
  .nav-mega__heading {
    display: block;
    font-size: 10px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.75rem;
  }
  .nav-mega__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .nav-mega__col a {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--ink-primary);
    text-decoration: none;
    padding: 4px 0;
    transition: color var(--dur-fast);
  }
  .nav-mega__col a:hover { color: var(--accent-terracotta); }

  .nav-mega__footer {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }
  .nav-mega__all {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-terracotta);
    text-decoration: none;
    transition: letter-spacing 150ms;
  }
  .nav-mega__all:hover { letter-spacing: 0.12em; }

  /* ---- CTA ---- */
  .header-cta { display: none; }
  @media (min-width: 768px) { .header-cta { display: block; } }

  /* ---- Hamburger ---- */
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
  }
  @media (min-width: 768px) { .hamburger { display: none; } }

  /* Header CTA — bordered editorial pill, MBS-Test style */
  .header-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: transparent;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-pill);
    padding: 10px 22px;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .header-cta-btn:hover {
    background-color: var(--color-primary);
    color: var(--color-neutral);
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-primary);
    border-radius: 2px;
    transition: transform 250ms ease, opacity 150ms ease;
  }
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ---- Mobile drawer ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background-color: var(--color-neutral);
    padding: calc(var(--header-h, 68px) + 1.25rem) 1.5rem
             calc(env(safe-area-inset-bottom, 0px) + 2.5rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform 350ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 999;
  }
  .mobile-menu[aria-hidden="false"] {
    transform: translateX(0);
  }
  .mobile-menu nav {
    display: block;
    width: 100%;
  }

  .mobile-nav-link {
    display: block;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.875rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-transform: lowercase;
    color: var(--color-primary);
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .mobile-nav-link:hover { color: var(--color-rust); }

  /* ---- Mobile services group (rewrites the existing tight scope) ---- */
  .mobile-services { margin-bottom: 0.5rem; }
  .mobile-services__group {
    padding: 0.75rem 0 1rem 0;
    margin-bottom: 0;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-services__heading {
    display: block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: 0.625rem;
    margin-top: 0.25rem;
  }
  .mobile-services__group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .mobile-services__group a {
    display: block;
    padding: 0.5rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
  }
  .mobile-services__group a:hover { color: var(--color-rust); }

  .mobile-cta {
    margin-top: 1.75rem;
    margin-bottom: 1rem;
    width: 100%;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.18em;
    padding: 16px 28px;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu.setAttribute('aria-hidden', String(open));
    document.body.style.overflow = open ? '' : 'hidden';
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
  });

  // ---- Desktop services mega-menu ----
  const servicesDropdown = document.getElementById('services-dropdown') as HTMLElement | null;
  const servicesTrigger = servicesDropdown?.querySelector('.nav-dropdown__trigger') as HTMLButtonElement | null;

  function openServices() {
    if (!servicesDropdown || !servicesTrigger) return;
    servicesDropdown.classList.add('is-open');
    servicesTrigger.setAttribute('aria-expanded', 'true');
  }
  function closeServices() {
    if (!servicesDropdown || !servicesTrigger) return;
    servicesDropdown.classList.remove('is-open');
    servicesTrigger.setAttribute('aria-expanded', 'false');
  }

  if (servicesDropdown && servicesTrigger) {
    // Open on hover (desktop); also toggle on click for keyboard/touch
    servicesDropdown.addEventListener('mouseenter', openServices);
    servicesDropdown.addEventListener('mouseleave', closeServices);
    servicesTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      servicesDropdown.classList.contains('is-open') ? closeServices() : openServices();
    });
    // Click outside or Esc closes
    document.addEventListener('click', (e) => {
      if (servicesDropdown.classList.contains('is-open') && !servicesDropdown.contains(e.target as Node)) {
        closeServices();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && servicesDropdown.classList.contains('is-open')) {
        closeServices();
        servicesTrigger.focus();
      }
    });
    // Close when any menu link is activated
    servicesDropdown.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => closeServices());
    });
  }
</script>
