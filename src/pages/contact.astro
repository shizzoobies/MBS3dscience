---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Contact MBS Medical. Telehealth serving all of Florida. Cash pay, same-week appointments. Reach us by phone, email, or book online."
>

  <!-- Hero -->
  <section class="section bg-peach" style="padding-top: 7rem;">
    <div class="container">
      <div class="contact-hero">
        <div>
          <span class="hero-eyebrow">get in touch</span>
          <h1 class="hero-title">let's talk about your health</h1>
          <p class="hero-sub">Have a question before booking? Want to know if we're the right fit? Reach out. We're real people and we'll respond promptly.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- Contact layout -->
  <section class="section bg-cream">
    <div class="container">
      <div class="contact-layout">

        <!-- Info column -->
        <div class="contact-info">
          <div class="reveal contact-card">
            <div class="contact-card__icon" aria-hidden="true">&#9742;</div>
            <h3>call us</h3>
            <a href="tel:+19413157246" class="contact-card__value">(941) 315-7246</a>
            <p>Available during business hours. Leave a voicemail and we'll return your call promptly.</p>
          </div>

          <div class="reveal reveal-delay-1 contact-card">
            <div class="contact-card__icon" aria-hidden="true">&#9993;</div>
            <h3>email us</h3>
            <a href="mailto:david@mbsdoc.com" class="contact-card__value">david@mbsdoc.com</a>
            <p>For general inquiries, questions about services, or anything else on your mind.</p>
          </div>

          <div class="reveal reveal-delay-2 contact-card">
            <div class="contact-card__icon" aria-hidden="true">&#9200;</div>
            <h3>book online</h3>
            <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="contact-card__value">practicebetter.io</a>
            <p>Same-week availability. Evening appointments included. Book in minutes, no insurance needed.</p>
          </div>

          <div class="reveal reveal-delay-3 contact-card" style="background-color: var(--surface-ink); color: var(--ink-inverse);">
            <div class="contact-card__icon" aria-hidden="true" style="color: var(--accent-terracotta);">&#9679;</div>
            <h3 style="color: var(--ink-inverse);">service area</h3>
            <p class="contact-card__value" style="color: var(--ink-inverse);">All of Florida</p>
            <p style="color: rgba(250,246,240,0.65);">We provide telehealth services to patients physically located anywhere in the state of Florida. You do not need to be near our primary location.</p>
          </div>
        </div>

        <!-- Contact form -->
        <div class="reveal contact-form-wrap">
          <h2 style="margin-bottom: 0.5rem;">send us a message</h2>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm); margin-bottom: 2rem;">We'll get back to you within one business day.</p>

          <form class="contact-form" name="contact" method="POST" action="/contact/success/" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="first-name">first name</label>
                <input type="text" id="first-name" name="first-name" class="input" placeholder="Your first name" required />
              </div>
              <div class="form-group">
                <label for="last-name">last name</label>
                <input type="text" id="last-name" name="last-name" class="input" placeholder="Your last name" required />
              </div>
            </div>

            <div class="form-group">
              <label for="email">email address</label>
              <input type="email" id="email" name="email" class="input" placeholder="you@example.com" required />
            </div>

            <div class="form-group">
              <label for="phone">phone (optional)</label>
              <input type="tel" id="phone" name="phone" class="input" placeholder="(123) 456-7890" />
            </div>

            <div class="form-group">
              <label for="service">service of interest</label>
              <select id="service" name="service" class="input">
                <option value="">choose a service...</option>
                <option>Primary Care</option>
                <option>Medical Weight Loss</option>
                <option>Men's Health / TRT</option>
                <option>Women's Health</option>
                <option>Mental Health</option>
                <option>Longevity &amp; Performance</option>
                <option>Sexual Health</option>
                <option>Hair &amp; Dermatology</option>
                <option>Lab Testing</option>
                <option>Lifestyle Medicine</option>
                <option>Concierge Medicine</option>
                <option>Not sure yet</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">message</label>
              <textarea id="message" name="message" class="input" rows="5" placeholder="Tell us a little about what's on your mind. No pressure to share more than you're comfortable with." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
              send message
            </button>

            <p style="font-size: var(--text-xs); color: var(--ink-muted); margin-top: 1rem; text-align: center;">
              This form is not for medical emergencies. If you are experiencing a medical emergency, call 911.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  .contact-hero { max-width: 640px; }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .contact-layout { grid-template-columns: 1fr 1.6fr; gap: 5rem; align-items: start; }
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-card {
    background-color: var(--surface-shell);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    border: 1px solid var(--border-subtle);
  }
  .contact-card__icon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--accent-terracotta);
  }
  .contact-card h3 {
    font-size: var(--text-xl);
    margin-bottom: 0.5rem;
  }
  .contact-card__value {
    display: block;
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--ink-primary);
    text-decoration: none;
    margin-bottom: 0.5rem;
    transition: color 150ms ease;
  }
  a.contact-card__value:hover { color: var(--accent-terracotta); }
  .contact-card p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    max-width: none;
  }

  .contact-form-wrap {
    background-color: var(--surface-shell);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    border: 1px solid var(--border-subtle);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  textarea.input {
    resize: vertical;
    min-height: 120px;
    font-family: var(--font-sans);
    line-height: var(--leading-relaxed);
  }
</style>
