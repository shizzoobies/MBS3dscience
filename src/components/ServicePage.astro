  .sp-spotlight__inner {
    max-width: 56rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }
  .sp-spotlight__eyebrow {
    margin: 0;
