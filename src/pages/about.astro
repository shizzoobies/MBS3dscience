---
import Layout from '../layouts/Layout.astro';

type TeamMember = {
  name: string;
  role: string;
  credentials?: string;
  image: string;
  avatarPosition?: string;
  chipLabel: string;
  chipClass: string;
  shortBio: string;
  fullBio: string[];
  tags: string[];
  link?: { label: string; href: string; sub?: string };
};

const founders: TeamMember[] = [
  {
    name: 'David Hervig, PA-C',
    role: 'Owner & Founder',
    credentials: 'PA-C · 12 Years U.S. Army',
    image: '/images/david.jpg',
    chipLabel: 'founder',
    chipClass: 'chip-terracotta',
    shortBio: 'PA-C, U.S. Army veteran, national diving champion, and founder of MBS Medical. Emergency medicine trained with experience across every stage of life.',
    fullBio: [
      "David is a Physician Assistant and a man with many hats. Always a medical provider first, he also acts as one of our office managers and is currently the marketing director. David was trained in the U.S. Army and spent 12 years in service to our country, learning from the ground up. His career began as a combat medic and finished with a degree as a Physician Associate from the University of Oklahoma Health Sciences Center.",
      "David also completed medical school overseas in the Czech Republic but decided to concentrate on building this practice, never finishing a residency. Emergency medicine trained in the military and experienced across pediatrics to geriatrics, he brings a rare breadth of clinical knowledge to every patient encounter.",
      "David was also a national champion in springboard diving at the age of sixteen and earned championships in wrestling, sprinting, and pole vaulting. He has over 20 years of experience coaching gymnastics and diving. That background gives him a deep, hands-on understanding of athletic performance, injury, and recovery, and drives a strong interest in sports medicine.",
      "After years of watching great care reach only the patients who could get through a waiting room door, David made a deliberate decision to go further. Telehealth became his answer: a way to bring the same attentive, whole-person medicine he has always practiced to patients across Florida who deserve consistent access to a provider who actually knows them."
    ],
    tags: ['PA-C, Licensed FL', '12 Years U.S. Army', 'Emergency Medicine', 'Sports Medicine', 'Primary Care', 'Weight Loss', 'TRT Evaluation']
  },
  {
    name: 'Alex Anderson',
    role: 'Director of Growth & Digital Strategy',
    credentials: 'Digital Strategy · AI Development',
    image: '/images/alex.jpg',
    chipLabel: 'operations',
    chipClass: 'chip-butter',
    shortBio: 'Director of Growth and Digital Strategy, leading digital infrastructure, patient acquisition, and technology systems at MBS Medical.',
    fullBio: [
      "Alex Anderson is Director of Growth and Digital Strategy at MBS Medical. He leads the clinic's digital infrastructure, patient acquisition strategy, and technology systems, with a focus on building a seamless, accessible experience for patients from their very first interaction with the practice.",
      "Alex's connection to MBS Medical is personal. He first met Dr. David Hervig as his own patient, and the impact of David's holistic approach to care was meaningful enough that it stayed with him long after the appointment. When the opportunity came to help build something together, Alex did not hesitate. Their shared belief is simple: that the kind of thoughtful, whole-person care David has always practiced deserves to reach as many patients as possible.",
      "Alex brings a background in instructional design, AI application development, and digital strategy to that mission, applying those skills to create operational systems that are patient-centered and built to scale. His work at MBS Medical spans HIPAA-compliant web development and secure integrations to AI-powered workflows designed to support the clinic's telehealth-forward model of care."
    ],
    tags: ['Digital Strategy', 'AI Development', 'Instructional Design', 'HIPAA-Compliant Systems', 'Telehealth Infrastructure']
  }
];

const team: TeamMember[] = [
  {
    name: 'Julie Vera Rivas',
    role: 'Nurse Practitioner',
    credentials: 'MSN, APRN, FNP-C',
    image: '/images/Julie.jpg',
    avatarPosition: 'center 35%',
    chipLabel: 'nurse practitioner',
    chipClass: 'chip-sage',
    shortBio: 'Board-certified Family Nurse Practitioner with 27+ years of healthcare experience, specializing in primary care and weight management.',
    fullBio: [
      "Julie is a board-certified Family Nurse Practitioner specializing in primary care and weight management, with over 27 years of healthcare experience, including 10 years as a Registered Nurse. She takes a comprehensive, patient-centered approach, helping patients achieve sustainable health and metabolic balance.",
      "She believes lasting transformation begins with understanding the whole person: what works, what doesn't, and what can realistically be maintained. Health isn't built through extremes, but through consistent, intentional habits that fit seamlessly into everyday life.",
      "Combining primary care expertise with practical, evidence-based strategies, she partners with patients to create personalized care plans that support long-term success. Through education, accountability, and a compassionate, judgment-free approach, she empowers patients to take control of their health and achieve meaningful, lasting results."
    ],
    tags: ['MSN', 'APRN', 'FNP-C', '27+ Years Healthcare', 'Primary Care', 'Weight Management']
  },
  {
    name: 'Dr. Eric Folkens, MD',
    role: 'Physician & Consultant',
    credentials: 'ABFM Certified · 34+ Years',
    image: '/images/folkens.jpg',
    chipLabel: 'physician & consultant',
    chipClass: 'chip-coral',
    shortBio: 'ABFM Certified Diplomate, founder of multiple Florida urgent care centers, and Medical Director of the Bradenton Research Center.',
    fullBio: [
      "Dr. Eric Folkens, MD, is a family medicine physician and pharmaceutical medical researcher based in Bradenton, Florida, with over 34 years of experience in the medical field. He is the founder of Bradenton, Sarasota and Lakewood Ranch Urgent Cares and has also practiced in Pinellas Park and Tampa, Florida.",
      "Dr. Folkens earned his medical degree from Saba University School of Medicine in 2002 and completed his family medicine residency at Christus Spohn Memorial Hospital in Texas, where he served as Chief Resident. He is a member of the Society for Clinical Research Sites, the American Academy of Family Physicians, and the Manatee County Medical Society, and is an American Board of Family Medicine Certified Diplomate.",
      "As Medical Director of the Bradenton Research Center, Dr. Folkens works to find better ways to treat disease through clinical trials and medical studies. Since its foundation in 1992, the Center has conducted over 150 clinical research studies on conditions including Alzheimer's disease, Parkinson's disease, Multiple Sclerosis, influenza, migraines, COVID, gout, Myasthenia Gravis, Sjögren's syndrome, and many more."
    ],
    tags: ['ABFM Certified', '34+ Years', 'Family Medicine', 'Clinical Research', 'Manatee County Medical Society'],
    link: { label: 'Bradenton Research Center', href: 'https://bradentonresearch.com/', sub: 'bradentonresearch.com' }
  },
  {
    name: 'Dr. Mark Dawson, MD',
    role: 'Physician & Consultant',
    credentials: 'Gastroenterology · 30+ Years',
    image: '/images/dawson.jpg',
    chipLabel: 'physician & consultant',
    chipClass: 'chip-sky',
    shortBio: 'Gastroenterologist specializing in colon cancer prevention, biliary and pancreatic disease. Cook County Hospital trained.',
    fullBio: [
      "Dr. Mark Dawson earned his medical degree from the University of Illinois. He completed his internal medicine residency and gastroenterology fellowship at Cook County Hospital in Chicago. Dr. Dawson's special interests in GI are preventing colon cancer, treating biliary and pancreatic diseases and Barrett's esophagus to prevent cancer. He enjoys learning new techniques in the GI world.",
      "Dr. Dawson has participated in Manatee We Care, providing free healthcare for over 25 years. He loves what he does, especially sharing good news: \"I tell everyone, I don't get bored giving out good news.\" He individualizes each patient's care through discussion.",
      "When he's not treating patients, Dr. Dawson enjoys time with his family and friends. He also likes writing, telling jokes, playing music and watching sunsets. Dr. Dawson practices in Bradenton and Sun City Center."
    ],
    tags: ['Gastroenterology', 'Internal Medicine', 'Colon Cancer Prevention', 'Manatee We Care', 'Cook County Hospital']
  }
];
---

<Layout
  title="About"
  description="Meet the MBS Medical team. Veteran-owned telehealth with decades of combined clinical experience serving patients across Florida."
>

  <!-- HERO -->
  <section class="section bg-peach" style="padding-top: 7rem; min-height: 70vh; display: flex; align-items: center;">
    <div class="container">
      <div class="hero-split">
        <div>
          <span class="hero-eyebrow">about mbs medical</span>
          <h1 class="hero-title">mind, body, and spirit</h1>
          <p class="hero-sub">
            MBS Medical is a veteran-owned telehealth practice founded on a simple belief: healthcare works better when your provider actually knows you. We treat the whole person, not just the symptoms.
          </p>
          <a href="/contact/" class="btn btn-primary" style="margin-top: 0.5rem;">get in touch</a>
        </div>
        <div class="hero-media">
          <div class="img-placeholder img-placeholder--tall" role="img" aria-label="MBS Medical team">
            <span>team photo placeholder</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- PHILOSOPHY -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal" style="margin-bottom: 3rem;">
        <span class="label">our approach</span>
        <h2 style="margin-top: 0.75rem;">healthcare built on trust, not transactions</h2>
      </div>

      <div class="philosophy-grid">
        <div class="reveal card philosophy-card">
          <span class="philosophy-bar" style="background-color: var(--accent-coral);" aria-hidden="true"></span>
          <h3>veteran values</h3>
          <p>Founded by a U.S. Army veteran with 12 years of service. Discipline, accountability, and showing up for people aren't talking points. They're how we operate.</p>
        </div>
        <div class="reveal reveal-delay-1 card philosophy-card">
          <span class="philosophy-bar" style="background-color: var(--accent-sage);" aria-hidden="true"></span>
          <h3>continuity of care</h3>
          <p>You see the same provider every time. They know your history, your medications, and your goals. Not just what's in the chart.</p>
        </div>
        <div class="reveal reveal-delay-2 card philosophy-card">
          <span class="philosophy-bar" style="background-color: var(--accent-sky);" aria-hidden="true"></span>
          <h3>evolving care plans</h3>
          <p>Your care plan isn't static. It grows and adapts as your health changes, your goals shift, and new information comes in.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- TEAM: Founders row + team row, modal on click -->
  <section class="section bg-shell">
    <div class="container">
      <div class="reveal" style="margin-bottom: 3rem; text-align: center;">
        <span class="label">the team</span>
        <h2 style="margin-top: 0.75rem;">who's behind your care</h2>
        <p style="color: var(--ink-secondary); margin-top: 1rem; max-width: 52ch; margin-inline: auto;">Click any team member to read their full bio.</p>
      </div>

      <!-- Founders row (2 avatars, slightly larger) -->
      <div class="founders-row">
        {founders.map((m, i) => (
          <button
            class={`reveal team-avatar-card team-avatar-card--founder ${i > 0 ? 'reveal-delay-1' : ''}`}
            data-member={JSON.stringify(m)}
            type="button"
            aria-label={`View bio for ${m.name}`}
          >
            <span class="team-avatar team-avatar--lg">
              <img
                src={m.image}
                alt={m.name}
                loading="lazy"
                decoding="async"
                width="320"
                height="320"
                style={m.avatarPosition ? `object-position: ${m.avatarPosition}` : ''}
              />
            </span>
            <h3>{m.name}</h3>
            <p class="team-avatar-card__role">{m.role}</p>
            {m.credentials && <p class="team-avatar-card__creds">{m.credentials}</p>}
          </button>
        ))}
      </div>

      <!-- Team row (3 smaller avatars) -->
      <div class="team-row">
        {team.map((m, i) => (
          <button
            class={`reveal team-avatar-card ${i > 0 ? `reveal-delay-${i}` : ''}`}
            data-member={JSON.stringify(m)}
            type="button"
            aria-label={`View bio for ${m.name}`}
          >
            <span class="team-avatar">
              <img
                src={m.image}
                alt={m.name}
                loading="lazy"
                decoding="async"
                width="260"
                height="260"
                style={m.avatarPosition ? `object-position: ${m.avatarPosition}` : ''}
              />
            </span>
            <h3>{m.name}</h3>
            <p class="team-avatar-card__role">{m.role}</p>
            {m.credentials && <p class="team-avatar-card__creds">{m.credentials}</p>}
          </button>
        ))}
      </div>
    </div>
  </section>


  <!-- MODAL -->
  <div id="member-modal" class="member-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="member-modal-name">
    <div class="member-modal__backdrop" data-close-modal></div>
    <div class="member-modal__dialog">
      <button type="button" class="member-modal__close" aria-label="Close bio" data-close-modal>&times;</button>

      <div class="member-modal__header">
        <div class="member-modal__photo">
          <img id="member-modal-img" src="" alt="" />
        </div>
        <div>
          <span id="member-modal-chip" class="accent-chip"></span>
          <h2 id="member-modal-name" style="margin-top: 0.75rem;"></h2>
          <p id="member-modal-role" class="member-modal__role"></p>
          <p id="member-modal-creds" class="member-modal__creds"></p>
        </div>
      </div>

      <div id="member-modal-bio" class="member-modal__bio"></div>

      <p id="member-modal-link-wrap" class="member-modal__link-wrap">
        <a id="member-modal-link" class="member-modal__link" href="" target="_blank" rel="noopener noreferrer">
          <span class="member-modal__link-label"></span>
          <svg class="member-modal__link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </p>

      <div id="member-modal-tags" class="member-modal__tags"></div>
    </div>
  </div>


  <!-- CTA -->
  <section class="section bg-ink" style="text-align: center;">
    <div class="container">
      <div class="reveal" style="max-width: 600px; margin-inline: auto;">
        <h2 style="color: var(--ink-inverse);">ready to meet your provider?</h2>
        <p style="color: rgba(250,246,240,0.7); margin-top: 1rem; font-size: var(--text-lg);">Same-week telehealth across Florida. Book online in minutes.</p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 2rem;">
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-inverse">book a visit</a>
          <a href="/services/" class="btn btn-outline-inverse">explore services</a>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  .about-hero-img {
    border-radius: var(--radius-xl);
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 767px) { .about-hero-img { aspect-ratio: 16/9; } }

  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) { .philosophy-grid { grid-template-columns: repeat(3, 1fr); } }

  .philosophy-card {
    padding: 2.25rem 2rem;
    box-shadow: 0 1px 3px rgba(26,26,26,0.04);
    transition: transform var(--dur-base), box-shadow var(--dur-base);
  }
  .philosophy-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(26,26,26,0.1);
  }
  .philosophy-bar {
    display: block;
    width: 48px;
    height: 4px;
    border-radius: var(--radius-pill);
    margin-bottom: 1.25rem;
  }
  .philosophy-card h3 {
    font-size: var(--text-xl);
    margin-bottom: 0.625rem;
  }
  .philosophy-card p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: var(--leading-relaxed);
  }

  /* ---- Team grid: circular avatar cards ---- */
  .founders-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    max-width: 560px;
    margin: 0 auto 3rem;
    justify-items: center;
  }
  @media (max-width: 480px) {
    .founders-row { grid-template-columns: 1fr; max-width: 260px; }
  }

  .team-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 780px;
    margin: 0 auto;
    justify-items: center;
  }
  @media (max-width: 640px) {
    .team-row { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 400px; }
  }
  @media (max-width: 360px) {
    .team-row { grid-template-columns: 1fr; max-width: 200px; }
  }

  /* ---- Avatar card (button) ---- */
  .team-avatar-card {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: var(--font-sans);
    width: 100%;
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .team-avatar-card:hover { transform: translateY(-3px); }
  .team-avatar-card:focus-visible {
    outline: 2px solid var(--border-strong);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }

  /* Circular avatar */
  .team-avatar {
    display: block;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--surface-sand);
    border: 2px solid var(--border-subtle);
    margin-bottom: 1rem;
    transition: border-color var(--dur-base) var(--ease-standard),
                box-shadow var(--dur-base) var(--ease-standard),
                transform var(--dur-base) var(--ease-standard);
  }
  .team-avatar--lg {
    width: 150px;
    height: 150px;
  }
  .team-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%; /* keep faces in frame */
    display: block;
  }
  .team-avatar-card:hover .team-avatar {
    border-color: var(--accent-terracotta);
    box-shadow: 0 0 0 4px rgba(232,116,97,0.12);
  }

  .team-avatar-card h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    margin-bottom: 0.25rem;
  }
  .team-avatar-card--founder h3 {
    font-size: var(--text-lg);
  }

  .team-avatar-card__role {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: var(--leading-snug);
    max-width: 22ch;
  }
  .team-avatar-card__creds {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: 0.375rem;
  }


  /* ---- Modal ---- */
  .member-modal {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 2rem 1rem;
    overflow-y: auto;
  }
  .member-modal[aria-hidden="false"] { display: flex; }

  .member-modal__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(26,26,26,0.65);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  .member-modal__dialog {
    position: relative;
    width: 100%;
    max-width: 720px;
    background-color: var(--surface-cream);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    margin-top: 4rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-lg);
    animation: modalIn 300ms var(--ease-entrance);
  }
  @keyframes modalIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .member-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: var(--radius-pill);
    background-color: var(--surface-shell);
    font-size: 1.5rem;
    color: var(--ink-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 150ms;
  }
  .member-modal__close:hover { background-color: var(--surface-sand); }

  .member-modal__header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  @media (min-width: 600px) {
    .member-modal__header { grid-template-columns: 160px 1fr; align-items: center; }
  }

  .member-modal__photo {
    width: 160px;
    height: 160px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--surface-sand);
  }
  .member-modal__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .member-modal__role {
    font-size: var(--text-base);
    color: var(--ink-secondary);
    font-weight: var(--weight-medium);
    margin-top: 0.25rem;
  }
  .member-modal__creds {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: 0.375rem;
  }

  .member-modal__bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--ink-primary);
  }
  .member-modal__bio p {
    line-height: var(--leading-relaxed);
    max-width: none;
    color: var(--ink-secondary);
  }

  /* Clean inline link — opt-in display so it never leaks across members.
     Default: hidden. Only `.is-shown` reveals it. */
  .member-modal__link-wrap {
    display: none !important;
    margin-top: 1.75rem;
    max-width: none;
  }
  .member-modal__link-wrap.is-shown {
    display: block !important;
  }

  .member-modal__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    color: var(--accent-terracotta);
    text-decoration: none;
    border-bottom: 1px solid rgba(201,123,94,0.35);
    padding-bottom: 2px;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .member-modal__link:hover {
    color: #a0593a;
    border-bottom-color: #a0593a;
  }
  .member-modal__link-arrow {
    width: 14px;
    height: 14px;
    transition: transform 200ms ease;
  }
  .member-modal__link:hover .member-modal__link-arrow {
    transform: translate(2px, -2px);
  }

  .member-modal__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .member-modal__tags .tag {
    display: inline;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 0;
    background: transparent;
    border-radius: 0;
  }
  .member-modal__tags .tag + .tag::before {
    content: '·';
    margin: 0 0.625rem;
    color: var(--border-subtle);
  }
</style>


<script>
  const modal = document.getElementById('member-modal') as HTMLElement;
  const imgEl = document.getElementById('member-modal-img') as HTMLImageElement;
  const chipEl = document.getElementById('member-modal-chip') as HTMLElement;
  const nameEl = document.getElementById('member-modal-name') as HTMLElement;
  const roleEl = document.getElementById('member-modal-role') as HTMLElement;
  const credsEl = document.getElementById('member-modal-creds') as HTMLElement;
  const bioEl = document.getElementById('member-modal-bio') as HTMLElement;
  const linkWrapEl = document.getElementById('member-modal-link-wrap') as HTMLElement;
  const linkEl = document.getElementById('member-modal-link') as HTMLAnchorElement;
  const linkLabelEl = linkEl?.querySelector('.member-modal__link-label') as HTMLElement;
  const tagsEl = document.getElementById('member-modal-tags') as HTMLElement;

  function openMember(data: any) {
    imgEl.src = data.image;
    imgEl.alt = data.name;
    chipEl.textContent = data.chipLabel;
    chipEl.className = `accent-chip ${data.chipClass}`;
    nameEl.textContent = data.name;
    roleEl.textContent = data.role;
    credsEl.textContent = data.credentials ?? '';
    credsEl.style.display = data.credentials ? '' : 'none';

    bioEl.innerHTML = '';
    (data.fullBio ?? []).forEach((para: string) => {
      const p = document.createElement('p');
      p.textContent = para;
      bioEl.appendChild(p);
    });

    // Reset link state every open so a previously-shown link can never
    // bleed into a member that doesn't have one.
    linkWrapEl.classList.remove('is-shown');
    linkEl.removeAttribute('href');
    linkLabelEl.textContent = '';

    if (data.link && data.link.href && data.link.label) {
      linkEl.href = data.link.href;
      linkLabelEl.textContent = data.link.label;
      linkWrapEl.classList.add('is-shown');
    }

    tagsEl.innerHTML = '';
    (data.tags ?? []).forEach((tag: string) => {
      const span = document.createElement('span');
      span.className = 'tag';
      span.textContent = tag;
      tagsEl.appendChild(span);
    });

    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.team-avatar-card').forEach(card => {
    card.addEventListener('click', () => {
      const raw = card.getAttribute('data-member');
      if (!raw) return;
      try {
        openMember(JSON.parse(raw));
      } catch (e) {
        console.error('Bad member data', e);
      }
    });
  });

  document.querySelectorAll('[data-close-modal]').forEach(el => {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
      closeModal();
    }
  });
</script>
