---
import ServicePage from '../components/ServicePage.astro';
---

<ServicePage
  title="Concierge Medicine"
  description="Concierge telehealth medicine in Florida. Direct provider access, extended visits, priority scheduling, and a higher level of personalized care."
  eyebrow="concierge medicine"
  heroTitle="The provider with time for you."
  heroSub="Concierge medicine means your provider is truly available to you: direct access, unhurried visits, and a level of personalized attention that most healthcare simply does not offer."
  chipLabel="premium access"
  chipClass="chip-butter"
  heroSurface="rgba(239,207,143,0.15)"
  heroImage="/images/hero-concierge-medicine.jpg"
  pricing={{
    eyebrow: 'Membership',
    plans: [
      {
        name: 'Concierge Membership',
        price: '$299',
        tagline: '24/7 access to your provider, quarterly labs included.',
        includes: [
          'Direct messaging with your provider, 24/7',
          'Same-day or next-day appointments',
          'Quarterly comprehensive lab panels included',
          'Extended visits, full chart review every time',
          'Personalized care plan, refreshed quarterly',
        ],
      },
    ],
  }}
  values={[
    {
      icon: "▲",
      heading: "Direct provider access",
      body: "Contact your provider directly via secure message. Urgent questions answered promptly, not at your next scheduled visit."
    },
    {
      icon: "○",
      heading: "Extended visits",
      body: "Visits with no time pressure. We cover everything on your list without feeling rushed, because your time matters."
    },
    {
      icon: "⬡",
      heading: "Priority scheduling",
      body: "Same-day or next-day appointments guaranteed. No waiting weeks for an opening that works with your schedule."
    }
  ]}
  features={[
    {
      heading: "Healthcare the way it should be",
      body: "Standard medicine operates on volume. Short visits, long waits, providers stretched thin. Concierge medicine inverts that model. A smaller patient panel means your provider has the time and capacity to give your care the attention it deserves. We review your full chart before every visit. We follow up when we say we will. We are genuinely available when you need us.",
      chipLabel: "true availability",
      chipClass: "chip-butter",
      imgAlt: "Home office set up for a video call",
      image: "/images/feat-concierge-1.jpg"
    },
    {
      heading: "A relationship built over years, not minutes",
      body: "Concierge care is about depth. Your provider knows your history, your family situation, your health goals, and the tradeoffs that matter to you. Over time, that context produces dramatically better care. Subtle changes get noticed early. Treatment plans account for your real life. And when something changes, you have a provider who knows immediately why it matters.",
      chipLabel: "continuity",
      chipClass: "chip-terracotta",
      imgAlt: "Morning coffee at home",
      image: "/images/feat-concierge-2.jpg",
      flip: true
    }
  ]}
  testimonials={[
    {
      quote: "i messaged my provider at 7pm about a concerning symptom and had a response within the hour. that kind of access is worth everything.",
      attr: "Concierge Patient — Naples, FL"
    },
    {
      quote: "my previous concierge practice was in-person only, expensive, and still rushed. this is telehealth, fraction of the cost, and twice the attention.",
      attr: "Concierge Patient — Sarasota, FL"
    },
    {
      quote: "my provider reviewed my full chart before every single visit. every time. i cannot overstate how different that feels from standard care.",
      attr: "Concierge Patient — Tampa, FL"
    }
  ]}
  steps={[
    {
      heading: "Concierge intake",
      body: "A comprehensive first visit that covers your full health history, current concerns, and long-term goals. We take the time to actually know you from day one."
    },
    {
      heading: "Personalized care plan",
      body: "A written care plan covering your conditions, monitoring schedule, preventive goals, and how we will work together over the long term."
    },
    {
      heading: "Ongoing direct relationship",
      body: "Direct access via secure messaging, priority scheduling, and quarterly comprehensive reviews. Your provider is genuinely available to you."
    }
  ]}
  faq={[
    {
      q: "How is concierge medicine different from your standard care?",
      a: "Concierge patients get direct provider access via secure messaging, guaranteed same-day or next-day scheduling, extended visit times, and priority attention. The relationship is more intensive and more personal."
    },
    {
      q: "Is concierge medicine worth it?",
      a: "For patients who value genuine availability, unhurried visits, and a provider who truly knows them, absolutely. For those who prefer standard visit-based care, our regular services work very well too."
    },
    {
      q: "What does concierge medicine cost?",
      a: "Concierge membership is a monthly or annual fee in addition to standard visit costs. Contact us for current pricing. We are transparent about the full cost before you commit."
    },
    {
      q: "Can I use concierge medicine with insurance?",
      a: "We are a cash-pay practice. Concierge membership fees are not covered by insurance. We can provide documentation for FSA/HSA reimbursement where applicable."
    },
    {
      q: "How quickly can I reach my provider?",
      a: "Concierge patients can send secure messages directly to their provider and typically receive a response within a few hours during daytime hours. For urgent clinical questions, response time is prioritized."
    }
  ]}
/>
