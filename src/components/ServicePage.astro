    background-color: var(--color-rust);
    color: var(--color-neutral);
  }
  .sp-spotlight__body {
    padding-top: 0.875rem;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--ink-secondary);
