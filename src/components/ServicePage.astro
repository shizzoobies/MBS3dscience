  }
  /* Ghost secondary action: outline on the dark hero. */
  .sp-spotlight-hero__cta--ghost {
    background-color: transparent;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.55);
  }
  .sp-spotlight-hero__cta--ghost:hover {
