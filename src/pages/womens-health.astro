---
import ServicePage from '../components/ServicePage.astro';
---

<ServicePage
  title="Women's Health"
  description="Telehealth women's health care in Florida. Hormone balance, PCOS, perimenopause, menopause management, and preventive gynecological care. Cash pay."
  eyebrow="women's health"
  heroTitle="healthcare that meets you where you actually are"
  heroSub="Hormonal shifts, PCOS, perimenopause, and menopause are not things to push through. They are treatable conditions with real clinical solutions. Let's talk about yours."
  chipLabel="holistic care"
  chipClass="chip-coral"
  heroSurface="rgba(232,116,97,0.15)"
  values={[
    {
      icon: "○",
      heading: "Hormone health",
      body: "Hormonal imbalances affect mood, weight, energy, and sleep. We evaluate and manage with evidence-based approaches tailored to your life stage."
    },
    {
      icon: "▲",
      heading: "Perimenopause and menopause",
      body: "Hot flashes, disrupted sleep, mood changes, and weight shifts are real and manageable. Hormone replacement therapy options discussed openly."
    },
    {
      icon: "⬡",
      heading: "PCOS management",
      body: "Polycystic ovary syndrome is more than a fertility issue. We manage the metabolic, hormonal, and quality-of-life aspects together."
    }
  ]}
  features={[
    {
      heading: "Perimenopause and menopause: you deserve real support",
      body: "The years before and after menopause bring real physiological changes. Hot flashes, night sweats, mood shifts, weight gain, and disrupted sleep are not just 'part of aging.' Hormone replacement therapy (HRT), when appropriate, can significantly improve quality of life. We evaluate your full hormonal picture and discuss options, risks, and benefits openly.",
      chipLabel: "menopause support",
      chipClass: "chip-coral",
      imgAlt: "Woman living vibrantly"
    },
    {
      heading: "PCOS: more than what you've been told",
      body: "PCOS is one of the most common hormonal conditions in women and one of the most undertreated. Irregular cycles, unwanted hair growth, acne, weight resistance, and metabolic changes are all part of the picture. We manage it comprehensively: insulin sensitivity, hormonal balance, and the symptoms that actually affect your daily life.",
      chipLabel: "PCOS management",
      chipClass: "chip-sage",
      imgAlt: "Woman feeling healthy and energized",
      imgSurface: "rgba(168,184,155,0.2)",
      flip: true
    }
  ]}
  testimonials={[
    {
      quote: "for years i was told my symptoms were just stress. finally a provider who ran the right labs and found a real hormonal imbalance. everything changed.",
      attr: "Women's Health Patient — Sarasota, FL"
    },
    {
      quote: "perimenopause hit me hard at 44. within two months of starting HRT i slept through the night and felt like myself again.",
      attr: "Women's Health Patient — Tampa, FL"
    },
    {
      quote: "i was diagnosed with PCOS at 26 but never properly managed. finally have a real plan that addresses all of it, not just one symptom.",
      attr: "Women's Health Patient — Bradenton, FL"
    }
  ]}
  steps={[
    {
      heading: "Women's health intake",
      body: "A thorough conversation about your cycle history, symptoms, current medications, and what's affecting your quality of life most."
    },
    {
      heading: "Hormonal lab panel",
      body: "Comprehensive hormonal evaluation including estrogen, progesterone, testosterone, FSH, LH, thyroid, and metabolic markers."
    },
    {
      heading: "Personalized care plan",
      body: "Based on your labs and symptoms, we build a plan that may include hormone therapy, lifestyle interventions, or targeted treatments for specific conditions."
    }
  ]}
  faq={[
    {
      q: "Do you offer hormone replacement therapy for menopause?",
      a: "Yes. We evaluate women for HRT including estrogen, progesterone, and sometimes testosterone therapy. We discuss the current evidence on risks and benefits so you can make an informed decision."
    },
    {
      q: "Can you manage PCOS?",
      a: "Yes. We manage PCOS holistically: metabolic components (insulin resistance, weight), hormonal components (androgen excess, cycle regulation), and quality-of-life symptoms."
    },
    {
      q: "Do you handle birth control management?",
      a: "We can manage hormonal contraceptives as part of your overall care, particularly when connected to hormonal health management."
    },
    {
      q: "Can you replace my OB-GYN?",
      a: "We complement but do not replace gynecological care. We do not perform pelvic exams or procedures. We handle the medical and hormonal management side and coordinate with your OB-GYN when needed."
    },
    {
      q: "Do you treat thyroid conditions?",
      a: "Yes. Thyroid disorders disproportionately affect women and frequently overlap with other hormonal conditions we manage. We test and treat hypothyroidism and hyperthyroidism."
    }
  ]}
/>
