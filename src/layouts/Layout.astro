---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'MBS Medical: Veteran-owned telehealth providing primary care, weight loss, mental health, and more across Florida. Cash pay, same-week appointments.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Mark JS as available before first paint so the image-load reveal can
         start images hidden without a flash. No-JS keeps everything visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="google-site-verification" content="h062DuNKwPTlS7jj6WiTdRyciMhwyJyTOxgKa9RMsns" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | MBS Medical</title>

    <!-- Google Fonts: DM Sans (sans) + Fraunces (serif accent) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,700;1,9..144,300;1,9..144,400;1,9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">skip to main content</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <ChatWidget />

    <!-- Global scroll reveal -->
    <script>
      const obs = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            obs.unobserve(e.target);
          }
        }),
        { threshold: 0.07, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

      // Premium image-load reveal: content images fade in as they decode.
      // Cached images reveal instantly; the CSS carries a safety fallback so
      // an image is never left hidden if its load event never fires.
      document.querySelectorAll('main img').forEach((el) => {
        const img = el as HTMLImageElement;
        if (img.hasAttribute('data-no-reveal')) return;
        if (img.complete && img.naturalWidth > 0) {
          img.classList.add('is-loaded');
        } else {
          img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
          img.addEventListener('error', () => img.classList.add('is-loaded'), { once: true });
        }
      });

      // Nav solid-on-scroll + slim scroll-progress indicator, batched into a
      // single passive scroll listener via requestAnimationFrame.
      const header = document.querySelector('.site-header') as HTMLElement;
      const progress = document.querySelector('[data-scroll-progress]') as HTMLElement;
      let ticking = false;
      const update = () => {
        ticking = false;
        if (header) header.classList.toggle('scrolled', window.scrollY > 20);
        if (progress) {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
          progress.style.transform = `scaleX(${pct / 100})`;
        }
      };
      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    </script>
  </body>
</html>
