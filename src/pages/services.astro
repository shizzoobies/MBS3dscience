---
import Layout from '../layouts/Layout.astro';

type Service = {
  title: string;
  href: string;
  tagline: string;
};

type Category = {
  label: string;
  description: string;
  chipClass: string;
  accentVar: string;
  services: Service[];
};

const categories: Category[] = [
  {
    label: 'primary care & prevention',
    description: 'Everyday medicine. The provider who knows you, your history, and your labs.',
    chipClass: 'chip-sage',
    accentVar: 'var(--accent-sage)',
    services: [
      { title: 'Primary Care',        href: '/primary-care/',        tagline: 'Ongoing care from a provider who sticks with you.' },
      { title: 'Lab Testing',         href: '/labs/',                tagline: 'Comprehensive panels, reviewed with you.' },
      { title: 'Lifestyle Medicine',  href: '/lifestyle-medicine/',  tagline: 'Evidence-based lifestyle protocols for chronic disease.' }
    ]
  },
  {
    label: 'weight & performance',
    description: 'Medical weight management, recovery, and performance optimization.',
    chipClass: 'chip-coral',
    accentVar: 'var(--accent-coral)',
    services: [
      { title: 'Medical Weight Loss',     href: '/weight-loss/',       tagline: 'GLP-1 evaluation and clinically supervised care.' },
      { title: 'Everyday Vitality',       href: '/everyday-vitality/', tagline: 'Root-cause workup for low energy and fatigue.' },
      { title: 'Longevity & Performance', href: '/longevity/',         tagline: 'Biomarker-driven protocols for healthspan.' }
    ]
  },
  {
    label: "hormone & wellness",
    description: "Hormone health, sexual wellness, and condition-specific care for men and women.",
    chipClass: 'chip-terracotta',
    accentVar: 'var(--accent-terracotta)',
    services: [
      { title: "Men's Health",          href: '/mens-health/',        tagline: 'TRT, ED, and whole-picture men\'s health care.' },
      { title: "Women's Health",        href: '/womens-health/',      tagline: 'Hormones, PCOS, perimenopause, and menopause.' },
      { title: 'Sexual Health',         href: '/sexual-health/',      tagline: 'Confidential, judgment-free care for all adults.' },
      { title: 'Hair & Dermatology',    href: '/hair-dermatology/',   tagline: 'Finasteride, minoxidil, and common skin conditions.' }
    ]
  },
  {
    label: 'specialty & premium',
    description: "Mental health care and concierge-level access for those who want more.",
    chipClass: 'chip-butter',
    accentVar: 'var(--accent-butter)',
    services: [
      { title: 'Mental Health',      href: '/mental-health/',      tagline: 'Anxiety, depression, sleep, and ADHD, taken seriously.' },
      { title: 'Concierge Medicine', href: '/concierge-medicine/', tagline: 'Direct access and extended visits with your provider.' }
    ]
  }
];
---

<Layout
  title="Services"
  description="MBS Medical offers 11 telehealth specialties across Florida including primary care, weight loss, TRT, mental health, and more. Cash pay, same-week appointments."
>

  <!-- Hero -->
  <section class="services-hero">
    <img src="/images/sig-coast.jpg" alt="" class="services-hero__bg" aria-hidden="true" />
    <div class="services-hero__scrim" aria-hidden="true"></div>
    <div class="container services-hero__inner">
      <span class="services-hero__eyebrow">What we treat</span>
      <h1 class="services-hero__title">All of our services</h1>
      <p class="services-hero__sub">
        Eleven specialties, one consistent provider. No insurance needed. Telehealth across Florida, same week.
      </p>
    </div>
  </section>

  <style>
    .services-hero {
      position: relative;
      min-height: 50vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 8rem 1.5rem 4rem;
      text-align: center;
      background-color: var(--color-primary);
    }
    /* Mobile: the desktop 8rem/4rem split crams the content high under the
       fixed header. Give the hero real vertical presence (dynamic-viewport
       aware) and balanced padding so the eyebrow + title sit comfortably
       centered with breathing room above and below. */
    @media (max-width: 767px) {
      .services-hero {
        min-height: 60vh;
        min-height: 60dvh;
        padding: 6.5rem 1.5rem 3.5rem;
      }
    }
    .services-hero__bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 60%;
      opacity: 0.85;
    }
    .services-hero__scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(60,56,54,0.30) 0%, rgba(60,56,54,0.50) 60%, rgba(60,56,54,0.72) 100%);
      pointer-events: none;
    }
    .services-hero__inner {
      position: relative;
      z-index: 1;
      max-width: 760px;
      color: #FFFFFF;
    }
    .services-hero__eyebrow {
      display: inline-block;
      font-size: 11px;
      font-weight: var(--weight-bold);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--color-rust);
      margin-bottom: 1.5rem;
      text-shadow: 0 1px 8px rgba(0,0,0,0.5);
    }
    .services-hero__title {
      font-family: var(--font-serif);
      font-weight: 300;
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 1.02;
      letter-spacing: -0.02em;
      color: #FFFFFF;
      margin: 0 auto 1.5rem;
      max-width: 14ch;
      text-shadow: 0 2px 12px rgba(0,0,0,0.4);
    }
    .services-hero__sub {
      font-size: var(--text-lg);
      line-height: var(--leading-relaxed);
      color: rgba(255,255,255,0.86);
      max-width: 52ch;
      margin: 0 auto;
      text-shadow: 0 1px 8px rgba(0,0,0,0.4);
    }
  </style>


  <!-- Categorized services -->
  {categories.map((cat, idx) => (
    <section class={`section ${idx % 2 === 0 ? 'bg-cream' : 'bg-shell'}`}>
      <div class="container">
        <div class="reveal cat-header">
          <span class={`accent-chip ${cat.chipClass}`}>{cat.label}</span>
          <div class="cat-header__text">
            <h2>{cat.label}</h2>
            <p>{cat.description}</p>
          </div>
        </div>

        <div class="cat-grid">
          {cat.services.map((s, i) => (
            <a
              href={s.href}
              class={`reveal cat-service ${i > 0 ? `reveal-delay-${Math.min(i, 3)}` : ''}`}
              style={`--accent: ${cat.accentVar};`}
            >
              <div class="cat-service__body">
                <h3>{s.title}</h3>
                <p>{s.tagline}</p>
              </div>
              <span class="cat-service__arrow" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}


  <!-- CTA -->
  <section class="section bg-ink" style="text-align: center;">
    <div class="container">
      <div class="reveal" style="max-width: 600px; margin-inline: auto;">
        <h2 style="color: var(--ink-inverse);">Not sure where to start?</h2>
        <p style="color: rgba(250,246,240,0.7); margin-top: 1rem;">Book a consultation and let's figure out the right path together. No commitment required.</p>
        <div style="margin-top: 2rem;">
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-inverse">book a free consultation</a>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  /* ---- Category header (chip + text) ---- */
  .cat-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .cat-header {
      grid-template-columns: auto 1fr;
      gap: 2.5rem;
      align-items: center;
    }
  }
  .cat-header__text h2 {
    font-size: var(--text-3xl);
    margin-bottom: 0.5rem;
  }
  .cat-header__text p {
    color: var(--ink-secondary);
    font-size: var(--text-base);
    max-width: 60ch;
  }

  /* ---- Service sub-cards: compact, arrow-right pattern ---- */
  .cat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }
  @media (min-width: 640px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cat-grid { grid-template-columns: repeat(3, 1fr); } }

  .cat-service {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.75rem;
    background-color: var(--surface-shell);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-primary);
    transition: transform var(--dur-base) var(--ease-standard),
                border-left-width var(--dur-base) var(--ease-standard),
                border-color var(--dur-base) var(--ease-standard);
  }
  .section.bg-shell .cat-service { background-color: var(--color-neutral); }

  .cat-service:hover {
    transform: translateX(3px);
    border-left-width: 6px;
    border-color: var(--color-border-strong);
    border-left-color: var(--color-accent);
  }

  .cat-service__body h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin-bottom: 0.25rem;
  }
  .cat-service__body p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: var(--leading-snug);
    max-width: none;
  }
  .cat-service__arrow {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--accent, var(--accent-terracotta));
    color: var(--ink-inverse);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .cat-service:hover .cat-service__arrow { transform: translateX(4px); }
</style>
