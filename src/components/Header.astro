---
const navLinks = [
  { label: 'Services', href: '/services/' },
  { label: 'About', href: '/about/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner container">
    <!-- Wordmark -->
    <a href="/" class="wordmark" aria-label="MBS Medical home">
      mbs medical
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: currentPath.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="header-cta">
      <a
        href="https://mbsmedical.practicebetter.io"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-inverse header-cta-btn"
      >
        book a visit
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      class="hamburger"
      id="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      {navLinks.map(link => (
        <a href={link.href} class="mobile-nav-link">
          {link.label}
        </a>
      ))}
      <a
        href="https://mbsmedical.practicebetter.io"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary mobile-cta"
      >
        book a visit
      </a>
    </nav>
  </div>
</header>

<style>
  /* ---- Header shell (dark, always) ---- */
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background-color: rgba(26,26,26,0.72);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid rgba(250,246,240,0.08);
    transition: background-color 250ms ease, border-color 250ms ease;
  }
  .site-header.scrolled {
    background-color: rgba(18,18,18,0.92);
    border-bottom-color: rgba(250,246,240,0.1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 68px;
  }

  /* ---- Wordmark ---- */
  .wordmark {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    color: var(--ink-inverse);
    text-decoration: none;
    text-transform: lowercase;
    flex-shrink: 0;
    transition: color 200ms ease;
  }
  .wordmark:hover { color: var(--accent-butter); }

  /* ---- Desktop nav ---- */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .desktop-nav { display: flex; }
  }

  .nav-link {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(250,246,240,0.72);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--ink-inverse);
    border-bottom-color: var(--accent-terracotta);
  }

  /* ---- CTA ---- */
  .header-cta { display: none; }
  @media (min-width: 768px) { .header-cta { display: block; } }

  /* ---- Hamburger ---- */
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
  }
  @media (min-width: 768px) { .hamburger { display: none; } }

  /* Header CTA sizing */
  .header-cta-btn {
    padding: 10px 22px;
    font-size: 0.8125rem;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--ink-inverse);
    border-radius: 2px;
    transition: transform 250ms ease, opacity 150ms ease;
  }
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ---- Mobile drawer ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background-color: var(--surface-cream);
    padding: 6rem 2rem 3rem;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 350ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 999;
  }
  .mobile-menu[aria-hidden="false"] {
    transform: translateX(0);
  }

  .mobile-nav-link {
    display: block;
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    text-transform: lowercase;
    color: var(--ink-primary);
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .mobile-nav-link:hover { color: var(--accent-terracotta); }

  .mobile-cta {
    margin-top: 2rem;
    width: 100%;
    text-align: center;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu.setAttribute('aria-hidden', String(open));
    document.body.style.overflow = open ? '' : 'hidden';
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
  });
</script>
