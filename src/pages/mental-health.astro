---
import ServicePage from '../components/ServicePage.astro';
---

<ServicePage
  title="Mental & Behavioral Health"
  description="Telehealth mental and behavioral health care in Florida. Anxiety, depression, sleep, addiction management with buprenorphine telehealth refills, and pain management consulting."
  eyebrow="mental & behavioral health"
  heroTitle="Your mind and body are not separate problems."
  heroSub="Mood, anxiety, depression, sleep, addiction, and pain are all treatable. We take mental and behavioral health seriously as part of whole-person care, not a referral you never follow through on."
  chipLabel="mind-body care"
  chipClass="chip-sky"
  heroSurface="rgba(239,207,143,0.18)"
  heroImage="/images/hero-mental-health.png"
  heroFocus="center 35%"
  heroVariant="fullwidth"
  stepsAsHero={true}
  values={[
    {
      heading: "Mood, anxiety & depression",
      body: "Evaluation and treatment for mood disorders, generalized and social anxiety, depression, and stress-related conditions. Medication management when appropriate, lifestyle and referrals when not."
    },
    {
      heading: "Sleep optimization",
      body: "Insomnia, disrupted sleep, and sleep-related fatigue addressed with evidence-based protocols. Not a sleep hygiene pamphlet, an actual plan."
    },
    {
      heading: "Addiction & buprenorphine care",
      body: "Telehealth refills and ongoing buprenorphine treatment for opioid use disorder. Induction is handled in-office. GLP-1 protocols available for alcohol use management."
    }
  ]}
  features={[
    {
      heading: "Anxiety, depression, and the symptoms running your day",
      body: "Real clinical conditions with effective treatments. We evaluate them in context of your hormones, sleep, and physical health, then choose the right combination of medication, lifestyle changes, and therapy referrals.",
      chipLabel: "mood & anxiety",
      chipClass: "chip-sky",
      imgAlt: "A man overwhelmed at his desk",
      image: "/images/feat-mental-health-1.png",
      variant: "fullwidth",
      flip: true,
      imgFocus: "center 25%"
    }
  ]}
  roundImageTrio={{
    eyebrow: "sleep & behavioral care",
    heading: "Sleep, addiction, and pain, handled with care",
    body: "Beyond mood and anxiety, sleep problems, addiction, and chronic pain all respond to real treatment. We find what is actually driving your insomnia and address the root, not just the symptom. We provide ongoing buprenorphine management and telehealth refills, plus pain consulting and GLP-1 protocols for alcohol use.",
    items: [
      { label: "Insomnia", image: "/images/mh-1.png" },
      { label: "Addiction", image: "/images/mh-2.png" },
      { label: "Pain", image: "/images/mh-3.png" },
    ],
  }}
  subServices={{
    heading: "What we cover under mental & behavioral health",
    intro: "We focus on mild-to-moderate cases for safety and continuity of care. Acute psychiatric crises are referred to emergency services or specialized inpatient care. Buprenorphine inductions require an office visit; refills can be handled by telehealth.",
    items: [
      "Mood Disorders",
      "Anxiety Treatment",
      "Depression Treatment",
      "Stress & Burnout Management",
      "Sleep Optimization",
      "Insomnia Treatment",
      "Performance Anxiety",
      "Stage Fright",
      "Emotional Resilience Coaching",
      "SSRI / SNRI Management",
      "Buspirone & Other Non-Controlled Medications",
      "Buprenorphine Telehealth Refills",
      "Buprenorphine Office Induction",
      "Addiction Management",
      "Alcohol Use Disorder (GLP-1 Protocols)",
      "Pain Management Consulting"
    ]
  }}
  testimonials={[]}
  steps={[
    {
      heading: "Mental health intake",
      body: "A focused intake covering your symptoms, timeline, sleep patterns, medications, and how mental health is affecting your daily life."
    },
    {
      heading: "Evaluation and labs if needed",
      body: "We rule out underlying physical contributors like thyroid dysfunction, hormonal imbalances, or nutritional deficiencies that can present as mental health symptoms."
    },
    {
      heading: "Treatment plan and follow-up",
      body: "Your plan may include medication, lifestyle adjustments, sleep protocols, addiction support, and coordination with therapists. Follow-ups every 4-8 weeks."
    }
  ]}
  faq={[
    {
      q: "Do you prescribe antidepressants and anti-anxiety medications?",
      a: "Yes. We can prescribe SSRIs, SNRIs, buspirone, and other non-controlled mental health medications. We evaluate carefully and follow up regularly."
    },
    {
      q: "Do you prescribe buprenorphine for opioid use disorder?",
      a: "Yes. We provide telehealth refills and ongoing management for patients already established on buprenorphine. New patient inductions are handled in-office to allow appropriate clinical observation."
    },
    {
      q: "Do you handle ADHD?",
      a: "Adult ADHD evaluation and treatment, including stimulant medications where clinically appropriate, is available. We follow current DEA telehealth prescribing guidelines."
    },
    {
      q: "Do you provide therapy?",
      a: "We do not provide psychotherapy directly. We manage psychiatric medication, addiction care, and sleep/pain consulting, and can coordinate with your therapist or help connect you with one."
    },
    {
      q: "What conditions are out of scope?",
      a: "We focus on mild-to-moderate conditions for safety and continuity. Acute psychiatric emergencies, severe psychosis, active suicidal ideation, or conditions requiring inpatient care should go to a hospital or specialized service. If you are in crisis, call 988 or go to your nearest emergency room."
    }
  ]}
/>
