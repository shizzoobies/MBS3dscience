---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
  // Home page sets this to make the header transparent over the hero video until scroll.
  transparentHeader?: boolean;
}

const {
  title,
  description = 'MBS Medical: Veteran-owned telehealth providing primary care, weight loss, mental health, and more across Florida. Cash pay, same-week appointments.',
  transparentHeader = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Mark JS as available before first paint so the image-load reveal can
         start images hidden without a flash. No-JS keeps everything visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="google-site-verification" content="h062DuNKwPTlS7jj6WiTdRyciMhwyJyTOxgKa9RMsns" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | MBS Medical</title>

    <!-- Google Fonts: DM Sans (sans) + Lora (serif accent) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <!-- Smooth client-side navigation. Default crossfade; every per-page
         script re-inits on astro:page-load, and prefers-reduced-motion is
         honored automatically. -->
    <ViewTransitions />
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">skip to main content</a>

    <Header transparentTop={transparentHeader} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <ChatWidget />

    <!-- Global scroll reveal + image-load fade + scroll progress -->
    <script>
      // ---- Registered once. The window survives view-transition swaps, so
      // we attach the scroll/resize listener a single time and re-query the
      // (possibly re-rendered) header + progress bar on each tick. ----
      let ticking = false;
      const updateScrollUi = () => {
        ticking = false;
        const header = document.querySelector('.site-header');
        const progress = document.querySelector('[data-scroll-progress]') as HTMLElement | null;
        if (header) header.classList.toggle('scrolled', window.scrollY > 20);
        if (progress) {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const pct = max > 0 ? window.scrollY / max : 0;
          progress.style.transform = `scaleX(${pct})`;
        }
      };
      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(updateScrollUi); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      // Once the visitor navigates, suppress the heavy first-load section
      // cascade so subsequent pages feel instant (the view-transition
      // crossfade becomes the entrance). The class lives on <html>, which
      // persists across swaps. Fires once.
      document.addEventListener('astro:before-preparation', () => {
        document.documentElement.classList.add('vtr-active');
      }, { once: true });

      // ---- Runs on first load AND after every view-transition navigation,
      // so freshly-swapped content gets observed. ----
      let navigated = false;
      const setupPage = () => {
        if (navigated) {
          // On navigations the view-transition crossfade is the entrance, so
          // reveal all content immediately. This guarantees nothing is ever
          // left hidden behind the transition.
          document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
        } else {
          // First load: classic staggered scroll reveal.
          const obs = new IntersectionObserver(
            (entries) => entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                obs.unobserve(e.target);
              }
            }),
            { threshold: 0.07, rootMargin: '0px 0px -40px 0px' }
          );
          document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
        }

        // Premium image-load reveal: content images fade in as they decode.
        // Cached images reveal instantly; the CSS carries a safety fallback so
        // an image is never left hidden if its load event never fires.
        document.querySelectorAll('main img').forEach((el) => {
          const img = el as HTMLImageElement;
          if (img.hasAttribute('data-no-reveal') || img.classList.contains('is-loaded')) return;
          if (img.complete && img.naturalWidth > 0) {
            img.classList.add('is-loaded');
          } else {
            img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
            img.addEventListener('error', () => img.classList.add('is-loaded'), { once: true });
          }
        });

        navigated = true;
        updateScrollUi();
      };
      document.addEventListener('astro:page-load', setupPage);
    </script>
  </body>
</html>
