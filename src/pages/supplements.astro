---
import Layout from '../layouts/Layout.astro';

/* =====================================================================
   Fullscript: official "Order Supplements" button
   ---------------------------------------------------------------------
   We use Fullscript's hosted SVG button (their officially-branded asset)
   linked to the practitioner storefront. This always works regardless
   of any iframe/X-Frame-Options policy on Fullscript's side.
   ===================================================================== */
const FULLSCRIPT_URL = 'https://us.fullscript.com/welcome/dhervig?utm_medium=webreferral&utm_source=other&utm_campaign=abmwebbuttons_light_500x500.svg&signup_source=website_buttons';
const FULLSCRIPT_BTN_SRC = 'https://assets.fullscript.com/buttons/light_500x500.svg';
---

<Layout
  title="Supplements"
  description="Provider-curated supplements through Fullscript. Pharmaceutical-grade products selected and reviewed by your MBS Medical provider, shipped direct."
>

  <!-- Hero -->
  <section class="section bg-shell" style="padding-top: 7rem; background: radial-gradient(ellipse at top right, rgba(168,184,155,0.28) 0%, rgba(168,184,155,0) 60%), var(--surface-shell);">
    <div class="container">
      <div class="supp-hero">
        <span class="hero-eyebrow">supplements · powered by Fullscript</span>
        <h1 class="hero-title">Provider-curated supplements</h1>
        <p class="hero-sub">
          Pharmaceutical-grade products selected with your care plan in mind. Browse our full Fullscript catalog, get provider recommendations, and have orders shipped direct.
        </p>
        <div class="supp-hero-actions">
          <a href={FULLSCRIPT_URL} target="_blank" rel="noopener noreferrer" class="supp-fs-button supp-fs-button--md" aria-label="Order supplements through our Fullscript store">
            <img src={FULLSCRIPT_BTN_SRC} alt="Order supplements through our Fullscript store" loading="eager" width="500" height="500" />
          </a>
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            book a consult
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Featured catalog button -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal supp-feature">
        <div class="supp-feature__copy">
          <span class="accent-chip chip-sage">browse the catalog</span>
          <h2>Order through our Fullscript store</h2>
          <p>
            Click the button to open our practitioner-curated catalog on Fullscript. Search by brand, product, or category. Provider-recommended treatment plans appear at the top when you log in. One-time orders and subscriptions both supported.
          </p>
          <p class="supp-feature__note">
            Fullscript handles ordering, payment, shipping, and refills. Most orders ship within 1-2 business days. Your provider sees your orders so they can support your plan.
          </p>
        </div>
        <a href={FULLSCRIPT_URL} target="_blank" rel="noopener noreferrer" class="supp-fs-button supp-fs-button--lg" aria-label="Order supplements through our Fullscript store">
          <img src={FULLSCRIPT_BTN_SRC} alt="Order supplements through our Fullscript store" loading="lazy" width="500" height="500" />
        </a>
      </div>
    </div>
  </section>


  <!-- How it works -->
  <section class="section bg-sand">
    <div class="container">
      <div class="reveal" style="text-align: center; margin-bottom: 3.5rem;">
        <span class="label">how it works</span>
        <h2 style="margin-top: 0.75rem;">Three steps from consult to doorstep</h2>
      </div>
      <div class="steps-grid">
        <div class="reveal step-card">
          <span class="step-number">01</span>
          <h3 style="margin-top: 1rem; margin-bottom: 0.75rem;">Talk with your provider</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Recommendations are tied to your visit. We choose what's evidence-supported for your goals, not whatever's trending.</p>
        </div>
        <div class="reveal reveal-delay-1 step-card">
          <span class="step-number">02</span>
          <h3 style="margin-top: 1rem; margin-bottom: 0.75rem;">Order through Fullscript</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Open our catalog and add products to your cart. Provider-recommended treatment plans appear when you log in.</p>
        </div>
        <div class="reveal reveal-delay-2 step-card">
          <span class="step-number">03</span>
          <h3 style="margin-top: 1rem; margin-bottom: 0.75rem;">Shipped to your door</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Direct from Fullscript with optional subscription delivery. Your provider gets visibility into orders so they can support your plan.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="section bg-shell">
    <div class="container">
      <div class="reveal faq-layout">
        <div class="faq-heading">
          <span class="label">questions</span>
          <h2 style="margin-top: 0.75rem;">Common questions</h2>
          <p style="color: var(--ink-secondary); margin-top: 1rem; font-size: var(--text-sm);">
            More to ask? <a href="/contact/" style="text-decoration: underline; text-underline-offset: 3px;">Contact us.</a>
          </p>
        </div>
        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-summary">Do I need a visit before ordering?</summary>
            <p class="faq-body">Anyone can browse and order from our Fullscript catalog. Recommendations specific to your health goals are tied to a visit, where your provider can build a personalized treatment plan you'll see at checkout.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">What is Fullscript?</summary>
            <p class="faq-body">Fullscript is a practitioner-only dispensary that connects MBS Medical with the supplement brands we trust. It handles ordering, shipping, refills, and patient accounts so we can focus on the clinical recommendations.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">Are these products different from what I'd buy at a store?</summary>
            <p class="faq-body">Most professional-line products on Fullscript are pharmaceutical-grade and only sold through licensed providers. They use higher-quality raw ingredients, third-party testing, and tighter manufacturing standards than typical retail supplements.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">Does insurance cover supplements?</summary>
            <p class="faq-body">No. Supplements are not covered by insurance. Some patients use HSA or FSA funds where eligible. Fullscript provides itemized receipts at checkout.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">Can I cancel a Fullscript subscription?</summary>
            <p class="faq-body">Yes. Fullscript's account portal lets you pause, change, or cancel any subscription order at any time. There's no minimum commitment.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">Does my provider see what I order?</summary>
            <p class="faq-body">Yes, that's part of the point. Visibility into your supplement plan helps us coordinate with your medications and labs, especially for protocols where dosing matters.</p>
          </details>
        </div>
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="section bg-ink" style="text-align: center;">
    <div class="container">
      <div class="reveal" style="max-width: 600px; margin-inline: auto;">
        <h2 style="color: var(--ink-inverse);">Get personalized recommendations</h2>
        <p style="color: rgba(250,246,240,0.7); margin-top: 1rem; font-size: var(--text-lg);">
          Book a visit to get supplement guidance tied to your labs, medications, and goals.
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 2.5rem;">
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-inverse">book a visit</a>
          <a href="/contact/" class="btn btn-outline-inverse">ask a question</a>
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  .supp-hero { max-width: 720px; }

  .supp-hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* Fullscript SVG button — sized down from 500x500 to fit the page.
     Square aspect preserved. */
  .supp-fs-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease-standard),
                box-shadow var(--dur-base) var(--ease-standard);
    cursor: pointer;
    line-height: 0;
  }
  .supp-fs-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(26,26,26,0.12);
  }
  .supp-fs-button:focus-visible {
    outline: 2px solid var(--border-strong);
    outline-offset: 4px;
  }
  .supp-fs-button img {
    display: block;
    width: 100%;
    height: auto;
  }
  .supp-fs-button--md { width: 180px; }
  .supp-fs-button--lg { width: 260px; }
  @media (min-width: 768px) {
    .supp-fs-button--lg { width: 320px; }
  }

  /* Featured catalog section */
  .supp-feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .supp-feature {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
    }
  }
  .supp-feature__copy h2 {
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }
  .supp-feature__copy p {
    font-size: var(--text-base);
    color: var(--ink-secondary);
    line-height: var(--leading-relaxed);
    max-width: 56ch;
  }
  .supp-feature__note {
    margin-top: 1rem;
    font-size: var(--text-sm) !important;
    color: var(--ink-muted) !important;
  }
  .supp-feature .supp-fs-button { justify-self: center; }

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .faq-layout { grid-template-columns: 1fr 2fr; gap: 5rem; align-items: start; }
  }
  .faq-heading { position: sticky; top: 6rem; }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .steps-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
