---
const FULLSCRIPT_URL = 'https://us.fullscript.com/welcome/dhervig?utm_medium=webreferral&utm_source=other&utm_campaign=abmwebbuttons_light_500x500.svg&signup_source=website_buttons';

/* Curated single-column nav per DESIGN.md (anti-pattern: three-column
   link lists). The full 11-service menu lives in the header mega-menu;
   the footer just surfaces top-level destinations. */
const navLinks: Array<{ label: string; href: string; external?: boolean }> = [
  { label: 'Services',     href: '/services/' },
  { label: 'About',        href: '/about/' },
  { label: 'Supplements',  href: FULLSCRIPT_URL, external: true },
  { label: 'Contact',      href: '/contact/' },
];
---

<footer class="site-footer" aria-label="Site footer">
  <div class="container">

    <!-- Editorial 2-col: brand left, curated nav right -->
    <div class="footer-grid">

      <div class="footer-brand">
        <a href="/" class="footer-logo-link" aria-label="MBS Medical home">
          <img src="/images/logo.png" alt="MBS Medical" width="464" height="240" class="footer-logo-img" />
        </a>
        <p class="footer-tagline">
          Veteran-owned telehealth serving patients across Florida. Cash pay, same-week appointments, one consistent provider who knows you.
        </p>
        <a
          href="https://mbsmedical.practicebetter.io"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-accent footer-cta"
        >
          book a visit
        </a>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <ul class="footer-links">
          {navLinks.map(link => (
            <li>
              {link.external ? (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <a href={link.href}>{link.label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>

    </div>

    <!-- Bottom legal row -->
    <div class="footer-bottom">
      <p class="footer-legal">
        &copy; {new Date().getFullYear()} MBS Medical. All rights reserved. Telehealth services available to Florida residents only. Content is for informational purposes and does not constitute medical advice.
      </p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background-color: #000000;
    color: rgba(255, 255, 255, 0.86);
    padding-top: 6rem;
    padding-bottom: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Editorial 2-col layout: brand wider on the left, nav anchored right */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  /* Brand */
  .footer-logo-link {
    display: inline-block;
    margin-bottom: 1.25rem;
    padding: 10px 16px;
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.06);
    transition: background-color 200ms ease;
  }
  .footer-logo-link:hover {
    background-color: rgba(255, 255, 255, 0.10);
  }
  .footer-logo-img {
    display: block;
    height: 44px;
    width: auto;
    /* Force the logo to render in white so it stays legible on black
       regardless of the source PNG's colors. */
    filter: brightness(0) invert(1);
  }
  .footer-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
    max-width: 36ch;
    letter-spacing: -0.005em;
  }
  .footer-cta {
    margin-top: 2rem;
    font-size: 0.9rem;
    padding: 14px 30px;
  }

  /* Nav */
  .footer-nav { padding-top: 0.5rem; }
  @media (min-width: 768px) {
    .footer-nav { justify-self: end; }
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .footer-links a {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .footer-links a:hover {
    color: var(--color-rust);
  }
  .footer-links a span {
    font-size: 0.75em;
    opacity: 0.75;
    margin-left: 0.15em;
  }

  /* Bottom legal */
  .footer-bottom { padding-top: 2rem; }
  .footer-legal {
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.45);
    max-width: 80ch;
  }
</style>
