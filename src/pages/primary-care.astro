---
import ServicePage from '../components/ServicePage.astro';
---

<ServicePage
  title="Primary & Urgent Care"
  description="Virtual primary care and same-day urgent care telehealth across Florida. Acute conditions, chronic disease management, lab and imaging reviews from a provider who knows you."
  eyebrow="primary & urgent care"
  heroTitle="The provider who actually picks up"
  heroSub="Same-day acute visits when you're sick. Long-term chronic care from a provider who knows your history. One relationship that handles both."
  chipLabel="ongoing care"
  chipClass="chip-terracotta"
  heroSurface="var(--surface-sand)"
  heroImage="/images/hero-primary-care-v2.png"
  heroVariant="fullwidth"
  stepsAsHero={true}
  bookingHref="https://mindbodyspiritmedicine8154.practicebetter.io/#/69921feabb1d145ba51735b7/bookings?p=6a0b5a719f56f04e4db561a4"
  values={[
    {
      heading: "Virtual primary care",
      body: "A consistent provider for ongoing health, preventive screenings, and the chronic conditions that need real management, not just refilled prescriptions."
    },
    {
      heading: "Same-day acute care",
      body: "Cold, flu, COVID, UTI, sinus, rashes, GI issues. Treated by telehealth in hours, not after a week-long wait for an appointment."
    },
    {
      heading: "Chronic disease management",
      body: "Hypertension, cholesterol, diabetes, thyroid, and difficult diagnoses managed long-term with regular labs, imaging reviews, and follow-up that actually happens."
    }
  ]}
  roundImageTrio={{
    items: [
      { label: "No Waiting Rooms", image: "/images/no-waiting-room.png" },
      { label: "Medication Refills", image: "/images/medication-maintenance.png" },
      { label: "Available Where You Are", image: "/images/where-you-are.png" },
    ],
  }}
  features={[
    {
      heading: "Primary care that goes beyond the appointment",
      body: "Most primary care is reactive. We built this differently. Same-week routine visits, same-day acute care, a provider who knows your chart and has time to actually talk.",
      chipLabel: "whole-person care",
      chipClass: "chip-sage",
      imgAlt: "Whole-person primary care at MBS Medical",
      image: "/images/feat-primary-care-whole-person-v2.png",
      variant: "fullwidth",
      flip: true
    }
  ]}
  pricing={{
    eyebrow: 'Membership',
    plans: [
      {
        name: 'Direct Primary Care',
        price: '$99',
        tagline: 'Two visits per month, one consistent provider.',
        cta: {
          label: 'Start membership',
          href: 'https://mindbodyspiritmedicine8154.practicebetter.io/#/69921feabb1d145ba51735b7/bookings?p=6a0b5a719f56f04e4db561a4',
        },
        includes: [
          'Two telehealth visits per month, included',
          'Same-day acute care when you are sick',
          'Late-night appointments available',
          'Direct messaging with your provider',
          'Chronic-condition management & monitoring',
          'Prescription management included',
        ],
      },
    ],
  }}
  subServices={{
    heading: "What we cover under primary & urgent care",
    intro: "Some of the conditions that can be treated via telehealth are listed below.",
    disclaimer: "If you're unsure whether your condition is covered, feel free to reach out and we'll check for you.",
    items: [
      "Cold, Flu & COVID",
      "Respiratory Illness",
      "Allergies",
      "Cold Sores",
      "Sleep Issues",
      "UTI Treatment",
      "Skin Infections",
      "Rashes",
      "GERD",
      "Nausea & Diarrhea",
      "Irritable Bowel Syndrome",
      "Medication Refills",
      "Preventive Care & Screenings",
      "Hypertension Management",
      "Cholesterol Management",
      "Diabetes Management",
      "Thyroid Imbalance",
      "Difficult Diagnoses",
      "Lab & Imaging Reviews"
    ]
  }}
  testimonials={[]}
  steps={[
    {
      heading: "New patient visit",
      body: "A thorough first visit to review your full health history, current medications, and care goals. We establish a baseline and decide what to address first."
    },
    {
      heading: "Lab work and baseline",
      body: "Depending on your history, we may order baseline labs to understand where things stand. Results reviewed with you at a follow-up. Outside labs and imaging can be uploaded for review."
    },
    {
      heading: "Ongoing care relationship",
      body: "Acute visits available same-day. Chronic care managed at intervals appropriate for your needs. Your provider knows you and your history every time."
    }
  ]}
  faq={[
    {
      q: "What acute conditions can you treat by telehealth?",
      a: "Most common ones: respiratory infections, UTIs, sinusitis, allergies, GI symptoms, mild skin issues, cold sores, and medication concerns. Conditions that require physical examination or in-person testing get an honest answer that telehealth isn't appropriate, with help finding the right care."
    },
    {
      q: "Can you be my regular primary care provider?",
      a: "Yes. We provide ongoing primary care including chronic condition management, preventive care, acute visits, and medication management. Many of our patients see us as their primary care provider."
    },
    {
      q: "Can you order labs and imaging?",
      a: "Yes. Labs are ordered through major national labs at locations near you. Imaging orders (X-rays, MRIs, etc.) can be placed at facilities near you. We review all results with you, including outside results from other providers."
    },
    {
      q: "What chronic conditions do you manage?",
      a: "Hypertension, type 2 diabetes, hypothyroidism, high cholesterol, GERD, IBS, and many others. We also help with difficult or unclear diagnoses and review outside lab and imaging results."
    },
    {
      q: "What if I need emergency care?",
      a: "Telehealth is not appropriate for emergencies. If you are experiencing a medical emergency, call 911 or go to your nearest emergency room. We handle non-emergency acute care and chronic care."
    }
  ]}
/>
