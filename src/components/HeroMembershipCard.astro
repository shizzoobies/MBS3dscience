---
/**
 * Membership pricing strip — a horizontal full-width band that sits
 * BETWEEN the hero and the value-props section. Renders only on
 * service pages with a single membership plan (multi-plan services
 * use the full <MembershipPricing /> comparison block instead).
 *
 * Three-column layout on desktop:
 *  | eyebrow + name + price | includes credit-roll | CTA + note |
 * Stacks vertically on mobile.
 */

interface Plan {
  name: string;
  price: string;
  period?: string;
  tagline: string;
  includes: string[];
  cta?: { label: string; href: string };
  note?: string;
}

interface Props {
  eyebrow?: string;
  plan: Plan;
}

const { eyebrow = 'Membership', plan } = Astro.props as Props;

const DEFAULT_CTA = {
  label: 'Start membership',
  href: 'https://mbsmedical.practicebetter.io',
};
const DEFAULT_NOTE = 'Cancel anytime · 10% off annual';

const cta = plan.cta ?? DEFAULT_CTA;
const note = plan.note ?? DEFAULT_NOTE;
---

<section class="hero-strip">
  <div class="container">
    <div class="hero-strip__grid">

      <div class="hero-strip__lead">
        <span class="hero-strip__eyebrow">{eyebrow}</span>
        <div class="hero-strip__name-row">
          <span class="hero-strip__name">{plan.name}</span>
          <span class="hero-strip__price">
            {plan.price}<span class="hero-strip__period">/ {plan.period ?? 'month'}</span>
          </span>
        </div>
      </div>

      <div class="hero-strip__includes">
        {plan.includes.map((item, i) => (
          <>
            {i > 0 && <span class="hero-strip__dot" aria-hidden="true">·</span>}
            <span>{item}</span>
          </>
        ))}
      </div>

      <div class="hero-strip__action">
        <a
          href={cta.href}
          target={cta.href.startsWith('http') ? '_blank' : undefined}
          rel={cta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="hero-strip__cta"
        >
          {cta.label}
        </a>
        <span class="hero-strip__note">{note}</span>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-strip {
    background-color: var(--color-surface-soft);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: 2rem;
  }

  .hero-strip__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-strip__grid {
      grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
      gap: 3rem;
    }
  }

  /* --- Lead block: eyebrow + name/price --- */
  .hero-strip__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: 0.5rem;
  }
  .hero-strip__name-row {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    flex-wrap: wrap;
  }
  .hero-strip__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    line-height: 1.1;
    color: var(--color-primary);
  }
  .hero-strip__price {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.625rem, 3vw, 2rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    white-space: nowrap;
  }
  .hero-strip__period {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-secondary);
    font-weight: var(--weight-medium);
    text-transform: lowercase;
    margin-left: 0.25rem;
    letter-spacing: 0;
  }

  /* --- Middle: includes credit-roll --- */
  .hero-strip__includes {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    line-height: 1.8;
    margin: 0;
    text-align: left;
  }
  @media (min-width: 900px) {
    .hero-strip__includes { text-align: center; }
  }
  .hero-strip__includes > span:not(.hero-strip__dot) {
    display: inline-block;
    white-space: nowrap;
  }
  .hero-strip__dot {
    display: inline;
    margin: 0 0.5rem;
    color: var(--color-rust);
    font-weight: var(--weight-bold);
    opacity: 0.7;
  }

  /* --- Action block: CTA + cancel note --- */
  .hero-strip__action {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  @media (min-width: 900px) {
    .hero-strip__action { align-items: flex-end; }
  }
  .hero-strip__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 13px 28px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-primary);
    background-color: var(--color-primary);
    color: #FFFFFF;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
    white-space: nowrap;
  }
  .hero-strip__cta:hover {
    background-color: transparent;
    color: var(--color-primary);
  }
  .hero-strip__note {
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-tertiary);
  }
</style>
