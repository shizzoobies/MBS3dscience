---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/react/ContactForm.tsx';
---

<Layout
  title="Contact"
  description="Contact MBS Medical. Telehealth serving all of Florida. Cash pay, same-week appointments. Reach us by phone, email, or book online."
>

  <!-- Hero — full-bleed cinematic banner -->
  <section class="contact-hero">
    <img src="/images/sig-leaf.jpg" alt="" class="contact-hero__bg" aria-hidden="true" />
    <div class="contact-hero__scrim" aria-hidden="true"></div>
    <div class="container contact-hero__inner">
      <span class="contact-hero__eyebrow">Get in touch</span>
      <h1 class="contact-hero__title">Let&rsquo;s talk about your health</h1>
      <p class="contact-hero__sub">
        Have a question before booking? Want to know if we&rsquo;re the right fit? Reach out. We&rsquo;re real people and we&rsquo;ll respond promptly.
      </p>
    </div>
  </section>

  <style>
    .contact-hero {
      position: relative;
      min-height: 46vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 7rem 1.5rem 3.5rem;
      background-color: var(--color-primary);
    }
    @media (min-width: 768px) {
      .contact-hero {
        min-height: 52vh;
        padding: 9rem 1.5rem 5rem;
      }
    }
    .contact-hero__bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.55;
    }
    .contact-hero__scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(60,56,54,0.45) 0%, rgba(60,56,54,0.62) 60%, rgba(60,56,54,0.78) 100%);
      pointer-events: none;
    }
    .contact-hero__inner {
      position: relative;
      z-index: 1;
      max-width: 760px;
      color: #FFFFFF;
    }
    .contact-hero__eyebrow {
      display: inline-block;
      font-size: 11px;
      font-weight: var(--weight-bold);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--color-rust);
      margin-bottom: 1.25rem;
      text-shadow: 0 1px 8px rgba(0,0,0,0.5);
    }
    .contact-hero__title {
      font-family: var(--font-serif);
      font-weight: 300;
      font-size: clamp(2.5rem, 6vw, 4.25rem);
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: #FFFFFF;
      margin: 0 0 1.25rem;
      max-width: 18ch;
      text-shadow: 0 2px 12px rgba(0,0,0,0.4);
    }
    .contact-hero__sub {
      font-size: var(--text-lg);
      line-height: var(--leading-relaxed);
      color: rgba(255,255,255,0.88);
      max-width: 56ch;
      margin: 0;
      text-shadow: 0 1px 8px rgba(0,0,0,0.4);
    }
  </style>


  <!-- Contact layout -->
  <section class="section bg-cream">
    <div class="container">
      <div class="contact-layout">

        <!-- Info column — editorial -->
        <div class="reveal contact-info">
          <span class="editorial-eyebrow">reach us</span>
          <h2 class="contact-info__title">Good to know</h2>

          <ul class="contact-points">
            <li class="contact-point">
              <span class="contact-point__bar" aria-hidden="true"></span>
              <h3>Book a visit</h3>
              <p>Same-week availability, evening appointments included. Book in minutes, no insurance needed.</p>
              <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="contact-point__link">
                Open the booking portal &rarr;
              </a>
            </li>
            <li class="contact-point">
              <span class="contact-point__bar" aria-hidden="true"></span>
              <h3>Response time</h3>
              <p>Use the form to send a question, a concern, or just to say hello. We respond within one business day.</p>
            </li>
            <li class="contact-point">
              <span class="contact-point__bar" aria-hidden="true"></span>
              <h3>All of Florida</h3>
              <p>Telehealth for patients physically located anywhere in the state. You don&rsquo;t need to be near our primary location.</p>
            </li>
          </ul>
        </div>

        <!-- Contact form -->
        <div class="reveal reveal-delay-1 contact-form-wrap">
          <h2 class="contact-form-wrap__title">Send us a message</h2>
          <p class="contact-form-wrap__sub">We&rsquo;ll get back to you within one business day.</p>
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>

</Layout>


<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 5rem;
      align-items: start;
    }
  }

  /* Info column — editorial, borderless, accent-bar items */
  .contact-info__title {
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    margin-top: 0.75rem;
    margin-bottom: 2.25rem;
  }
  .contact-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .contact-point__bar {
    display: block;
    width: 48px;
    height: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--accent-terracotta);
    margin-bottom: 1rem;
  }
  .contact-point h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.4rem;
  }
  .contact-point p {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: var(--leading-relaxed);
    max-width: 44ch;
  }
  .contact-point__link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-rust);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .contact-point__link:hover { color: var(--color-rust-hover); }

  /* Form — clean elevated card */
  .contact-form-wrap {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 24px 60px rgba(60,56,54,0.07);
  }
  @media (min-width: 768px) {
    .contact-form-wrap { padding: 3rem; }
  }
  .contact-form-wrap__title { margin-bottom: 0.4rem; }
  .contact-form-wrap__sub {
    color: var(--ink-secondary);
    font-size: var(--text-sm);
    margin-bottom: 2rem;
  }

  /* Form internals (used by the React ContactForm) */
  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 600px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }
  textarea.input {
    resize: vertical;
    min-height: 120px;
    font-family: var(--font-sans);
    line-height: var(--leading-relaxed);
  }
</style>
