---
import Layout from '../layouts/Layout.astro';
import FaqCaduceus from '../components/react/FaqCaduceus.tsx';
---

<Layout
  title="Home"
  description="MBS Medical: Veteran-owned telehealth providing primary care, weight loss, mental health, and more across Florida. Cash pay, same-week appointments."
  transparentHeader={true}
>

  <!-- ============================================================
       HERO — full-bleed flag video with glass text panel on the right
       ============================================================ -->
  <section class="hero-fullbleed">
    <video
      id="hero-flag-video"
      class="hero-fullbleed__video"
      autoplay
      muted
      playsinline
      preload="metadata"
      poster="/videos/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div id="hero-flag-scrim" class="hero-fullbleed__scrim" aria-hidden="true"></div>

    <div class="hero-fullbleed__grid container">
      <div class="hero-fullbleed__text">
        <span class="hero-fullbleed__eyebrow">Veteran-owned &middot; Florida telehealth</span>
        <h1 class="hero-fullbleed__title">
          Healthcare that treats<br />the whole person
        </h1>
        <p class="hero-fullbleed__sub">
          One consistent provider. No insurance required. Same-week appointments across Florida, from wherever you are.
        </p>
        <div class="hero-fullbleed__actions">
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-hero-primary">
            book a visit
          </a>
          <a href="/services/" class="btn btn-hero-secondary">
            explore services
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Hero video plays only at the very top of the page. The moment you
    // scroll, it freezes on the current frame; scrolling back to the top
    // resumes it. The scrim deepens slightly while frozen so the copy stays
    // readable on a still frame. Re-armed on each view-transition navigation.
    function heroFreezeTick() {
      const v = document.getElementById('hero-flag-video') as HTMLVideoElement | null;
      const s = document.getElementById('hero-flag-scrim');
      if (!v) return;
      // Once the montage has played through it rests on the final
      // particle-flag frame as a static backdrop. Never restart it.
      if (v.ended) {
        if (s) s.classList.add('is-paused');
        return;
      }
      if (window.scrollY <= 4) {
        const p = v.play();
        if (p && typeof p.catch === 'function') p.catch(() => {});
        if (s) s.classList.remove('is-paused');
      } else {
        try { v.pause(); } catch {}
        if (s) s.classList.add('is-paused');
      }
    }
    function initHeroVideo() {
      const v = document.getElementById('hero-flag-video') as HTMLVideoElement | null;
      if (!v) return;
      // Hold on the closing frame when the montage finishes instead of looping.
      // Bound per fresh video element (it is re-created on view-transition nav).
      if (!(v as any).__endBound) {
        (v as any).__endBound = true;
        v.addEventListener('ended', () => heroFreezeTick());
      }
      // Bind the scroll listener once for the whole session; it re-queries the
      // (possibly re-rendered) hero element on each tick.
      if (!(window as any).__heroFreezeBound) {
        (window as any).__heroFreezeBound = true;
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; heroFreezeTick(); }); }
        }, { passive: true });
      }
      heroFreezeTick();
    }
    document.addEventListener('astro:page-load', initHeroVideo);
  </script>


  <!-- ============================================================
       VALUE PROPS — cream surface, 3 columns
       ============================================================ -->
  <section class="section bg-cream">
    <div class="container">
      <div class="reveal value-header">
        <span class="label">why mbs medical</span>
        <h2>Care built differently</h2>
      </div>

      <div class="value-grid">
        <div class="reveal value-card">
          <span class="value-accent value-accent--coral" aria-hidden="true"></span>
          <h3>Whole-person care</h3>
          <p>We treat you, not a symptom list. Mental, physical, and preventive health addressed by one provider who knows your full history.</p>
        </div>
        <div class="reveal reveal-delay-1 value-card value-card--filled">
          <span class="value-accent value-accent--sage" aria-hidden="true"></span>
          <h3>No insurance needed</h3>
          <p>Cash pay keeps it simple. No referrals, no prior authorizations, no surprise bills. Transparent pricing, real care.</p>
        </div>
        <div class="reveal reveal-delay-2 value-card">
          <span class="value-accent value-accent--sky" aria-hidden="true"></span>
          <h3>Telehealth, statewide</h3>
          <p>Secure video visits from your home, office, or anywhere in Florida. Evening appointments available. Same-week booking.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 1 — medical weight loss, full-bleed image hero variant
       ============================================================ -->
  <section class="section home-feature-fullwidth">
    <img
      src="/images/home-weight-loss-hero-v3.png"
      alt="Medical weight loss at MBS Medical"
      class="home-feature-fullwidth__bg"
      loading="lazy"
      decoding="async"
    />
    <div class="home-feature-fullwidth__overlay" aria-hidden="true"></div>
    <div class="container home-feature-fullwidth__container">
      <div class="home-feature-fullwidth__text">
        <span class="editorial-eyebrow home-feature-fullwidth__eyebrow">medical weight loss</span>
        <h2 class="home-feature-fullwidth__title">Finally, a weight loss plan that sticks</h2>
        <p class="home-feature-fullwidth__body">
          GLP-1 receptor agonists have changed what's medically possible for weight management. We evaluate whether they're right for you, with real labs, honest conversation, and a plan built around your life.
        </p>
        <div class="home-feature-fullwidth__actions">
          <a href="/weight-loss/" class="home-feature-fullwidth__cta">
            learn more
          </a>
          <a
            href="https://mbsmedical.practicebetter.io"
            target="_blank"
            rel="noopener noreferrer"
            class="home-feature-fullwidth__cta home-feature-fullwidth__cta--ghost"
          >
            book a visit
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 2 — mental health, centered with breathing rings
       around the portrait image
       ============================================================ -->
  <section class="section bg-shell home-mental">
    <div class="home-mental__ambient" aria-hidden="true">
      <span class="home-mental__orb home-mental__orb--1"></span>
      <span class="home-mental__orb home-mental__orb--2"></span>
      <span class="home-mental__orb home-mental__orb--3"></span>
    </div>
    <div class="container home-mental__container">
      <div class="reveal home-mental__visuals">
        <div class="home-mental__visual">
          <img src="/images/mental-sleep.png" alt="Sleep" class="home-mental__img" loading="lazy" decoding="async" />
        </div>
        <div class="home-mental__visual">
          <img src="/images/mental-anxiety.png" alt="Anxiety" class="home-mental__img" loading="lazy" decoding="async" />
        </div>
        <div class="home-mental__visual">
          <img src="/images/mental-burnout.png" alt="Burnout" class="home-mental__img" loading="lazy" decoding="async" />
        </div>
        <div class="home-mental__visual">
          <img src="/images/mental-depression.png" alt="Depression" class="home-mental__img" loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="reveal home-mental__header">
        <span class="accent-chip chip-sky">mental health</span>
        <h2 class="home-mental__title">Sleep, anxiety, and what&rsquo;s keeping you stuck</h2>
        <p class="home-mental__body">
          Restless nights. A mind that won&rsquo;t slow down. A fog that follows you into the day. These aren&rsquo;t just inconveniences. They&rsquo;re treatable.
        </p>
      </div>

      <div class="reveal home-mental__actions">
        <a href="/mental-health/" class="btn btn-primary">learn more</a>
        <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">book a visit</a>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEATURE 3 — men's health / TRT, full-bleed cinematic
       ============================================================ -->
  <section class="section home-feature-fullwidth home-feature-fullwidth--mens">
    <img
      src="/images/home-mens-health-hero.png"
      alt="Men's health and TRT at MBS Medical"
      class="home-feature-fullwidth__bg"
      loading="lazy"
      decoding="async"
    />
    <div class="home-feature-fullwidth__overlay" aria-hidden="true"></div>
    <div class="container home-feature-fullwidth__container">
      <div class="home-feature-fullwidth__text">
        <span class="editorial-eyebrow home-feature-fullwidth__eyebrow">men's health</span>
        <h2 class="home-feature-fullwidth__title">Get your edge back</h2>
        <p class="home-feature-fullwidth__body">
          Testosterone naturally declines after 30. Less energy, slower recovery, lower drive. We start with labs for a clear, honest picture. If TRT is right for you, we build a plan. If it isn't, we'll tell you that too.
        </p>
        <div class="home-feature-fullwidth__actions">
          <a href="/mens-health/" class="home-feature-fullwidth__cta">
            learn more
          </a>
          <a
            href="https://mbsmedical.practicebetter.io"
            target="_blank"
            rel="noopener noreferrer"
            class="home-feature-fullwidth__cta home-feature-fullwidth__cta--ghost"
          >
            book a visit
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FAQ — shell surface. Two-column: title + Caduceus on the left,
       accordion list on the right.
       ============================================================ -->
  <section class="section bg-shell" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-grid__left">
          <div class="reveal faq-grid__heading">
            <h2 class="faq-grid__title">FAQ</h2>
            <p class="faq-grid__sub">Don't see your question? <a href="/contact/" style="text-decoration: underline; text-underline-offset: 3px;">Contact us directly.</a></p>
          </div>
          <div class="reveal faq-grid__caduceus" aria-hidden="true">
            <FaqCaduceus client:only="react" />
          </div>
        </div>

        <div class="reveal faq-list faq-grid__list">
          <details class="faq-item">
            <summary class="faq-summary">Do I need insurance to use MBS Medical?</summary>
            <p class="faq-body">No. We are a cash-pay practice. You pay directly, which keeps things simple, transparent, and without the delays that come with insurance. We can provide a superbill for FSA/HSA reimbursement if needed.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">What states do you serve?</summary>
            <p class="faq-body">We are licensed to provide telehealth services to patients located in Florida. You must be physically in Florida at the time of your visit.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">How quickly can I get an appointment?</summary>
            <p class="faq-body">We offer same-week appointments and often same-day or next-day availability. Evening slots are included. Book through our secure online portal anytime.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">Will I see the same provider every time?</summary>
            <p class="faq-body">Yes. Continuity of care is one of the core values of this practice. You'll build a relationship with your provider who knows your history, your medications, and your goals.</p>
          </details>
          <details class="faq-item">
            <summary class="faq-summary">Can you prescribe medications?</summary>
            <p class="faq-body">Yes. Our providers are licensed to evaluate, diagnose, and prescribe medications including controlled substances where appropriate and legal. Prescriptions are sent electronically to your preferred pharmacy.</p>
          </details>
        </div>
      </div>
    </div>
  </section>



  <!-- ============================================================
       HOW IT WORKS + READY WHEN YOU ARE — merged on the sig-cta-dark
       backdrop, step cards on top, closing CTA copy at the bottom
       ============================================================ -->
  <section class="section home-steps-hero">
    <img src="/images/sig-cta-dark.jpg" alt="" class="home-steps-hero__bg" aria-hidden="true" loading="lazy" decoding="async" />
    <div class="home-steps-hero__overlay" aria-hidden="true"></div>
    <div class="container home-steps-hero__container">
      <div class="reveal home-steps-hero__header">
        <span class="label home-steps-hero__label">how it works</span>
        <h2 class="home-steps-hero__title">Three steps to better care</h2>
      </div>

      <div class="steps-grid">
        <div class="reveal step-card">
          <h3 style="margin-bottom: 0.875rem;">Book online</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Pick a time through our secure portal. Same-week availability, with evening appointments included. No waiting rooms.</p>
        </div>
        <div class="reveal reveal-delay-1 step-card">
          <h3 style="margin-bottom: 0.875rem;">Meet your provider</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">Secure video visit from anywhere in Florida. Real conversation with a provider who has time for you.</p>
        </div>
        <div class="reveal reveal-delay-2 step-card">
          <h3 style="margin-bottom: 0.875rem;">Get your plan</h3>
          <p style="color: var(--ink-secondary); font-size: var(--text-sm);">A personalized care plan with ongoing support, medication management, and follow-ups that evolve with you.</p>
        </div>
      </div>

      <div class="reveal home-steps-hero__cta">
        <span class="cta-card__eyebrow">Ready when you are</span>
        <h2 class="cta-card__title">The care you&rsquo;ve always deserved.</h2>
        <p class="cta-card__sub">
          Veteran-owned. Patient-first. No insurance required. Same-week telehealth across Florida, from a provider who shows up for you.
        </p>
        <div class="cta-card__actions">
          <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="cta-card__btn cta-card__btn--primary">
            book a free consultation
          </a>
          <a href="/contact/" class="cta-card__btn cta-card__btn--ghost">
            ask a question
          </a>
        </div>
      </div>
    </div>
  </section>


</Layout>


<style>
  /* ---- Mental health centered with breathing rings ----
     Centered portrait inside a circular crop with three sage rings
     rippling outward on a continuous 4.5s loop, staggered so the
     section reads as a calm breathing rhythm. */
  .home-mental__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 3rem;
    padding-block: 2rem;
  }
  .home-mental__header {
    max-width: 38rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .home-mental__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    margin: 0;
    max-width: 22ch;
  }
  .home-mental__body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--ink-secondary);
    max-width: 52ch;
    margin: 0;
  }
  .section.home-mental {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Match the depth treatment used on the other heroes site-wide:
       hairline borders top/bottom, four-direction inset fade, soft
       drop shadow under the section. */
    box-shadow:
      0 24px 48px -26px rgba(60, 56, 54, 0.28),
      inset 0 1px 0 rgba(60, 56, 54, 0.10),
      inset 0 -1px 0 rgba(60, 56, 54, 0.10),
      inset 0 -50px 80px -50px rgba(60, 56, 54, 0.14),
      inset 0 40px 70px -50px rgba(60, 56, 54, 0.08),
      inset 80px 0 80px -90px rgba(60, 56, 54, 0.10),
      inset -80px 0 80px -90px rgba(60, 56, 54, 0.10);
  }
  /* Three large soft gradient orbs drift slowly across the section, giving
     it ambient atmospheric depth without competing with the portraits. */
  .home-mental__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .home-mental__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.38;
    will-change: transform;
  }
  .home-mental__orb--1 {
    width: clamp(320px, 36vw, 520px);
    aspect-ratio: 1;
    background: var(--color-accent);
    top: 8%;
    left: 4%;
    animation: home-mental-orb-1 16s ease-in-out infinite;
  }
  .home-mental__orb--2 {
    width: clamp(360px, 40vw, 580px);
    aspect-ratio: 1;
    background: var(--color-rust);
    top: 28%;
    right: 4%;
    animation: home-mental-orb-2 20s ease-in-out infinite;
  }
  .home-mental__orb--3 {
    width: clamp(280px, 30vw, 440px);
    aspect-ratio: 1;
    background: #B8956A;
    bottom: 4%;
    left: 36%;
    animation: home-mental-orb-3 18s ease-in-out infinite;
  }
  @keyframes home-mental-orb-1 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(60px, 40px); }
  }
  @keyframes home-mental-orb-2 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(-80px, 60px); }
  }
  @keyframes home-mental-orb-3 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(40px, -50px); }
  }
  .home-mental__container {
    position: relative;
    z-index: 1;
  }
  .home-mental__visuals {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 4.5vw, 4rem);
  }
  .home-mental__visual {
    position: relative;
    width: clamp(140px, 15vw, 200px);
    aspect-ratio: 1;
  }
  /* Absolutely positioned so a portrait source image cannot stretch
     the circle into an oval via flex min-height. */
  .home-mental__img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--color-primary);
    box-shadow:
      0 16px 28px -16px rgba(60, 56, 54, 0.28),
      0 6px 12px -8px rgba(60, 56, 54, 0.16);
  }
  .home-mental__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .home-mental__orb {
      animation: none;
    }
  }

  /* ---- How It Works + Ready When You Are (merged on dark backdrop) ----
     Same shape as the mens-health stepsAsHero on the service page:
     sig-cta-dark image as backdrop, dark gradient overlay, step cards
     on top with translucent fills, closing CTA copy at the bottom. */
  .home-steps-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-primary);
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -60px 90px -40px rgba(0, 0, 0, 0.45),
      inset 0 50px 90px -40px rgba(0, 0, 0, 0.30);
  }
  .home-steps-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.5;
    filter: grayscale(20%) contrast(1.02);
    z-index: 0;
  }
  .home-steps-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(60, 56, 54, 0.85) 0%,
      rgba(60, 56, 54, 0.65) 45%,
      rgba(60, 56, 54, 0.85) 100%
    );
    z-index: 1;
  }
  .home-steps-hero__container {
    position: relative;
    z-index: 2;
  }
  .home-steps-hero__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .home-steps-hero__label {
    color: rgba(255, 255, 255, 0.62);
  }
  .home-steps-hero__title {
    color: #ffffff;
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .home-steps-hero__cta {
    margin-top: clamp(4rem, 7vw, 6rem);
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  /* All three step cards use the same light translucent panel so the
     row reads uniformly against the dark backdrop. */
  .home-steps-hero .step-card,
  .home-steps-hero .step-card:nth-child(2),
  .home-steps-hero .step-card:nth-child(3),
  .home-steps-hero .step-card:nth-child(4) {
    background-color: rgba(255, 255, 255, 0.92);
    color: var(--color-primary);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .home-steps-hero .step-card p {
    color: var(--ink-secondary) !important;
  }

  /* ---- "Get your edge back" framed image (men's health feature) ----
     Asymmetric rounded image with an offset decorative outline behind
     it. Both pieces animate in on page load: image fades up, outline
     follows a beat later from its offset position. */
  .home-mens-frame {
    position: relative;
    isolation: isolate;
    padding: 1rem 1.5rem 1.5rem 0;
  }
  .home-mens-frame__deco {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border: 1.5px solid rgba(194, 122, 99, 0.35);
    border-radius: 180px 40px 180px 40px;
    pointer-events: none;
    z-index: 0;
    animation: home-mens-deco-enter 1.3s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;
  }
  .home-mens-frame__img {
    position: relative;
    z-index: 1;
    border-radius: 40px 180px 40px 180px;
    box-shadow:
      0 26px 44px -22px rgba(60, 56, 54, 0.28),
      0 8px 16px -10px rgba(60, 56, 54, 0.18);
    animation: home-mens-img-enter 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }
  @keyframes home-mens-img-enter {
    0% {
      opacity: 0;
      transform: translateY(28px) scale(0.94);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @keyframes home-mens-deco-enter {
    0% {
      opacity: 0;
      transform: translate(-14px, 14px) scale(0.92);
    }
    100% {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-mens-frame__img,
    .home-mens-frame__deco {
      animation: none;
    }
  }

  /* ---- Full-bleed feature hero (medical weight loss section) ----
     Same shape and depth treatment as the service-page fullwidth heroes:
     image cover, dark gradient text overlay, hairline borders + vignette. */
  .home-feature-fullwidth {
    position: relative;
    padding: 0;
    /* Cinematic stage at a measured height: tall enough to read as a
       hero, short enough that the 2.33:1 image renders with minimal
       crop so the figure stays fully in frame. */
    min-height: 72vh;
    overflow: hidden;
    background-color: var(--color-primary);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -90px 130px -40px rgba(0, 0, 0, 0.55),
      inset 0 60px 130px -40px rgba(0, 0, 0, 0.32),
      inset 110px 0 130px -80px rgba(0, 0, 0, 0.38),
      inset -110px 0 130px -80px rgba(0, 0, 0, 0.38),
