---
import ServicePage from '../components/ServicePage.astro';
---

<ServicePage
  title="Lab Testing"
  description="Comprehensive lab testing ordered and reviewed by your MBS Medical provider. Hormone panels, metabolic labs, thyroid, and more. Telehealth across Florida."
  eyebrow="lab testing"
  heroTitle="Your numbers, in plain language."
  heroSub="We order comprehensive panels, send you to a lab near you, and review every result with you. Not a summary. Not a portal message. An actual conversation about what your numbers mean."
  chipLabel="data-driven"
  chipClass="chip-sage"
  heroSurface="var(--surface-sand)"
  heroImage="/images/hero-labs.jpg"
  heroVariant="fullwidth"
  stepsAsHero={true}
  values={[
    {
      icon: "⬡",
      heading: "Comprehensive panels",
      body: "We go beyond the basic annual physical panel. Hormones, advanced lipids, inflammatory markers, thyroid, and more based on your goals and symptoms."
    },
    {
      icon: "○",
      heading: "Results explained",
      body: "Every result reviewed with your provider in the context of your full health picture. Not just 'normal' or 'abnormal' but what it actually means for you."
    },
    {
      icon: "▲",
      heading: "Convenient draw locations",
      body: "We work with major national labs. Most patients can complete their draw within a few miles of home. Results typically available within 48-72 hours."
    }
  ]}
  features={[
    {
      heading: "The labs your doctor wasn't ordering",
      body: "Standard annual physicals often include a basic metabolic panel and CBC. But if you are investigating fatigue, weight resistance, hormonal symptoms, or performance concerns, you need more. We order advanced hormonal panels, inflammatory markers (hs-CRP, homocysteine), thyroid including free T3 and reverse T3, vitamin D, ferritin, and other markers relevant to your situation.",
      chipLabel: "advanced panels",
      chipClass: "chip-sage",
      imgAlt: "Pipette and test tubes in a laboratory",
      scene: "vial"
    },
    {
      heading: "Labs as a baseline for optimization",
      body: "Whether you are starting a new treatment, monitoring a chronic condition, or optimizing for longevity and performance, regular lab reviews are how we know what's working. We establish your baseline on day one and track changes over time. The numbers tell a story if you know how to read them.",
      chipLabel: "ongoing monitoring",
      chipClass: "chip-butter",
      imgAlt: "Tracking biomarker trends over time",
      image: "/images/feat-labs-2.jpg",
      flip: true
    }
  ]}
  testimonials={[
    {
      quote: "my previous doctor just emailed 'all normal' for my labs. here, my provider walked through every value and explained what each one meant for my goals.",
      attr: "Lab Testing Patient — Sarasota, FL"
    },
    {
      quote: "the advanced thyroid panel found a reverse T3 issue that explained years of fatigue. standard TSH had always been 'normal.'",
      attr: "Lab Testing Patient — Tampa, FL"
    },
    {
      quote: "quarterly labs make it easy to see the trend. i can watch my inflammation markers improve as we adjust my protocol.",
      attr: "Longevity Patient — Naples, FL"
    }
  ]}
  steps={[
    {
      heading: "Lab order",
      body: "Your provider orders the appropriate panel based on your symptoms, goals, and health history. The order is sent electronically to a major national lab."
    },
    {
      heading: "Blood draw",
      body: "You go to a lab location near you at your convenience. Most draws take 10-15 minutes. No fasting required for most panels unless specified."
    },
    {
      heading: "Results review visit",
      body: "Results are reviewed with your provider at a scheduled follow-up. We explain every value, discuss implications, and adjust your care plan accordingly."
    }
  ]}
  faq={[
    {
      q: "Which labs do you work with?",
      a: "We work with major national labs including Quest Diagnostics and LabCorp. Most patients can find a draw location within a few miles of their home."
    },
    {
      q: "How much do labs cost?",
      a: "Lab costs are separate from your visit fee and vary based on panels ordered and your specific lab's pricing. We can provide an estimate before ordering. Many panels are surprisingly affordable when ordered directly."
    },
    {
      q: "Can I request specific tests?",
      a: "Yes. If there are specific markers you want included, mention them at your visit. We will order them if they are clinically appropriate and explain their relevance."
    },
    {
      q: "How often should I get labs done?",
      a: "It depends on your situation. Patients managing chronic conditions or on hormone therapy typically get labs every 3-6 months. Healthy patients focused on optimization often do a comprehensive panel annually or biannually."
    },
    {
      q: "Can I get labs without a prior visit?",
      a: "A brief visit is required before we can order labs, both to ensure we are ordering the right tests and to have appropriate clinical context for reviewing results."
    }
  ]}
/>
