---
/**
 * Compact membership card sized to sit in the hero right column.
 *
 * Used in place of the hero image for service pages with a SINGLE plan.
 * Multi-plan services (TRT, HRT) keep the hero image and render the
 * full <MembershipPricing /> comparison block deeper in the page.
 */

interface Plan {
  name: string;
  price: string;
  period?: string;
  tagline: string;
  includes: string[];
  cta?: { label: string; href: string };
  note?: string;
}

interface Props {
  eyebrow?: string;
  plan: Plan;
}

const { eyebrow = 'Membership', plan } = Astro.props as Props;

const DEFAULT_CTA = {
  label: 'Start membership',
  href: 'https://mbsmedical.practicebetter.io',
};
const DEFAULT_NOTE = 'Cancel anytime · 10% off annual';

const cta = plan.cta ?? DEFAULT_CTA;
const note = plan.note ?? DEFAULT_NOTE;
---

<article class="hero-plan">
  <span class="hero-plan__eyebrow">{eyebrow}</span>
  <span class="hero-plan__name">{plan.name}</span>

  <div class="hero-plan__price-row">
    <span class="hero-plan__price">{plan.price}</span>
    <span class="hero-plan__period">/ {plan.period ?? 'month'}</span>
  </div>

  <p class="hero-plan__tagline">{plan.tagline}</p>

  <hr class="hero-plan__rule" aria-hidden="true" />

  <ul class="hero-plan__includes" role="list">
    {plan.includes.map(item => (
      <li>
        <span class="hero-plan__bullet" aria-hidden="true">—</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>

  <a
    href={cta.href}
    target={cta.href.startsWith('http') ? '_blank' : undefined}
    rel={cta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
    class="hero-plan__cta"
  >
    {cta.label}
  </a>

  <p class="hero-plan__note">{note}</p>
</article>

<style>
  .hero-plan {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.75rem 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    /* Slight elevation pop so it reads as a separate object, not a flat panel.
       Single tasteful shadow only — keeps with the flat-design rule but
       lets the card float above the cream hero surface. */
    box-shadow: 0 18px 40px rgba(60, 56, 54, 0.07);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }
  .hero-plan:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 50px rgba(60, 56, 54, 0.10);
  }

  .hero-plan__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: 0.625rem;
  }
  .hero-plan__name {
    display: block;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    line-height: 1.15;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .hero-plan__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.625rem;
  }
  .hero-plan__price {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }
  .hero-plan__period {
    font-size: var(--text-sm);
    color: var(--color-secondary);
    font-weight: var(--weight-medium);
    text-transform: lowercase;
  }
  .hero-plan__tagline {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-secondary);
    margin: 0;
    max-width: 36ch;
  }

  .hero-plan__rule {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 1.25rem 0 1rem;
  }

  .hero-plan__includes {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hero-plan__includes li {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-primary);
  }
  .hero-plan__bullet {
    color: var(--color-rust);
    flex-shrink: 0;
    font-weight: var(--weight-bold);
  }

  .hero-plan__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 13px 28px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-primary);
    background-color: var(--color-primary);
    color: #FFFFFF;
    text-decoration: none;
    text-align: center;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .hero-plan__cta:hover {
    background-color: transparent;
    color: var(--color-primary);
  }

  .hero-plan__note {
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-tertiary);
    text-align: center;
    margin: 0.75rem 0 0;
  }

  @media (max-width: 767px) {
    .hero-plan {
      padding: 1.5rem 1.5rem 1.25rem;
    }
  }
</style>
