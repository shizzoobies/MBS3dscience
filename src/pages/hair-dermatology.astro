---
import ServicePage from '../components/ServicePage.astro';
---

<ServicePage
  title="Hair Loss & Dermatology"
  description="Telehealth hair loss treatment and dermatology in Florida. Finasteride, minoxidil, and combination hair loss protocols. Skin condition management."
  eyebrow="hair & dermatology"
  heroTitle="Hair loss has science-backed solutions."
  heroSub="Male pattern baldness, thinning hair, and skin conditions are treatable. We offer clinically proven protocols and manage them as part of your overall health care."
  chipLabel="science-backed"
  chipClass="chip-coral"
  heroSurface="rgba(232,116,97,0.15)"
  heroImage="/images/hero-hair-dermatology.jpg"
  heroVariant="fullwidth"
  stepsAsHero={true}
  values={[
    {
      icon: "○",
      heading: "Proven hair loss treatment",
      body: "Finasteride, minoxidil, and combination protocols with real clinical evidence behind them. Not supplements, not snake oil."
    },
    {
      icon: "▲",
      heading: "Early intervention works",
      body: "The sooner you start treating hair loss, the better the outcomes. We make it easy to start quickly."
    },
    {
      icon: "⬡",
      heading: "Skin condition management",
      body: "Common dermatological conditions managed by your primary provider. Acne, rosacea, seborrheic dermatitis, and more."
    }
  ]}
  features={[
    {
      heading: "Male pattern hair loss: finasteride works",
      body: "Androgenetic alopecia (male pattern baldness) is driven by DHT binding to hair follicles. Finasteride blocks this process and, in clinical trials, halts hair loss in over 80% of men and promotes regrowth in many. Combined with topical minoxidil, the results are significantly better. We evaluate your hair loss, discuss the options, and prescribe what's clinically appropriate for you.",
      chipLabel: "finasteride & minoxidil",
      chipClass: "chip-coral",
      imgAlt: "Hair care product on a clean surface",
      image: "/images/feat-hair-derm-1.jpg"
    },
    {
      heading: "Skin conditions deserve proper management",
      body: "Acne, rosacea, seborrheic dermatitis, and eczema affect quality of life in ways that are easy to underestimate. As your primary provider, we manage common skin conditions, prescribe topical and oral treatments when appropriate, and refer to dermatology when the situation warrants it.",
      chipLabel: "skin conditions",
      chipClass: "chip-sage",
      imgAlt: "Minimalist skincare routine",
      image: "/images/feat-hair-derm-2.jpg",
      flip: true
    }
  ]}
  testimonials={[]}
  steps={[
    {
      heading: "Hair loss evaluation",
      body: "We review your hair loss pattern, timeline, family history, and current medications. Some medications cause hair loss as a side effect and are worth ruling out."
    },
    {
      heading: "Labs if indicated",
      body: "Thyroid, ferritin, DHT, and hormonal levels can contribute to hair loss. We check what's relevant to your situation."
    },
    {
      heading: "Treatment protocol",
      body: "A clear prescription plan with instructions. Follow-up in 3-6 months to assess response and make adjustments."
    }
  ]}
  faq={[
    {
      q: "Does finasteride have side effects?",
      a: "A small percentage of men (around 2-4%) experience sexual side effects including reduced libido or erectile changes. We discuss this honestly before prescribing. Most side effects resolve after stopping the medication."
    },
    {
      q: "How long does hair loss treatment take to show results?",
      a: "You should expect to see initial results at 3-6 months, with the best results at 12 months. Hair loss treatment is a long-term commitment. Stopping treatment typically results in resumed hair loss."
    },
    {
      q: "Do you treat hair loss in women?",
      a: "Yes. Female pattern hair loss and hair thinning in women often have hormonal contributors (thyroid, PCOS, perimenopause). We evaluate and treat these in the context of women's health care."
    },
    {
      q: "Can you treat skin conditions via telehealth?",
      a: "Many common skin conditions can be evaluated and treated via telehealth with photo documentation. We will refer to in-person dermatology when the situation requires direct examination or procedures."
    }
  ]}
/>
