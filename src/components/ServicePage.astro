---
/**
 * Shared service page template.
 * Follows design-system.md page anatomy:
 * hero → value props → zigzag features → testimonials → how it works → faq → cta
 */

import Layout from '../layouts/Layout.astro';
import MembershipPricing from './MembershipPricing.astro';
import HeroMembershipCard from './HeroMembershipCard.astro';
import TestosteroneGraph from './TestosteroneGraph.astro';
import FaqCaduceus from './react/FaqCaduceus.tsx';
import DnaHelix from './react/DnaHelix.tsx';
import LabVial from './react/LabVial.tsx';
import Molecule from './react/Molecule.tsx';
import TrtVial from './react/TrtVial.tsx';

interface MembershipPlan {
  name: string;
  price: string;
  period?: string;
  tagline: string;
  includes: string[];
  cta?: { label: string; href: string };
  featured?: boolean;
  note?: string;
}

interface Feature {
  heading: string;
  body: string;
  flip?: boolean;
  chipLabel?: string;
  chipClass?: string;
  imgAlt?: string;
  imgSurface?: string;
  image?: string;  // optional real image path, falls back to placeholder
  scene?: 'dna' | 'vial' | 'molecule' | 'trt-vial'; // optional free-standing 3D form; replaces the framed image
  variant?: 'editorial' | 'fullwidth'; // default editorial split; 'fullwidth' renders the image as a full-bleed section with text overlaid
}

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heroTitle: string;
  heroSub: string;
  chipLabel: string;
  chipClass: string;           // e.g. 'chip-coral'
  heroSurface?: string;        // default 'var(--surface-peach)'
  heroImage?: string;          // optional real hero image
  values: { icon?: string; heading: string; body: string }[];
  features: Feature[];
  testimonials: { quote: string; attr: string }[];
  steps: { heading: string; body: string }[];
  faq: FaqItem[];
  // Optional: render a "what's covered" chip grid (sub-services / conditions treated)
  subServices?: {
    heading?: string;
    intro?: string;
    surface?: string;          // section bg, defaults to bg-shell
    items: string[];
    disclaimer?: string;       // small muted line below the list
  };
  // Optional: render a membership pricing section right below the hero.
  // Single-plan renders as a horizontal strip (HeroMembershipCard, which
  // uses `eyebrow`); 2+ plans render as side-by-side cards (MembershipPricing,
  // which ignores `eyebrow`).
  pricing?: {
    eyebrow?: string;
    plans: MembershipPlan[];
  };
  // Optional: render a subtle decorative graph behind the "how it works"
  // section. 'testosterone' shows an upward-trending curve representing
  // improving levels across the treatment timeline.
  stepsBackground?: 'testosterone';
  // Hero layout. Default 'editorial' is the asymmetric split with image
  // card on the right. 'fullwidth' renders the heroImage full-bleed with
  // a dark gradient and text overlaid in the left column.
  heroVariant?: 'editorial' | 'fullwidth';
  // When true, the "how it works" section gets a dark image backdrop and
  // absorbs the closing CTA copy (eyebrow + title + sub + pill buttons)
  // at the bottom, replacing the standalone CTA section at end of page.
  stepsAsHero?: boolean;
  // When true, the values 3-up section renders between the first and
  // second feature instead of immediately after the hero, so the
  // text-block values break up consecutive image-heavy feature rows.
  valuesAfterFirstFeature?: boolean;
  // Optional row of three round framed images with labels, rendered
  // after the values block. Uses an ambient drifting-orb background
  // (sage / rust / brass) for subtle motion.
  roundImageTrio?: {
    items: { label: string; image: string }[];
  };
}

const {
  title, description, eyebrow, heroTitle, heroSub,
  chipLabel, chipClass,
  heroSurface = 'var(--color-neutral)',
  heroImage,
  values, features, testimonials, steps, faq,
  subServices,
  pricing,
  stepsBackground,
  heroVariant = 'editorial',
  stepsAsHero = false,
  valuesAfterFirstFeature = false,
  roundImageTrio,
} = Astro.props;

// Strict bg alternation across every section after values (which is
// bg-cream). features start at bg-shell (i=0). Each downstream section
// continues the shell/cream pattern based on its running index, so
// we never end up with two same-color sections butting up against
// each other when a page has a different number of features or
// includes/omits subServices.
let _bgIdx = features.length + (subServices ? 1 : 0);
const testimonialsBg = _bgIdx++ % 2 === 0 ? 'bg-shell' : 'bg-cream';
const stepsBg        = _bgIdx++ % 2 === 0 ? 'bg-shell' : 'bg-cream';
const faqBg          = _bgIdx++ % 2 === 0 ? 'bg-shell' : 'bg-cream';
---

<Layout title={title} description={description}>

  <!-- ============================================================
       HERO — MBS-Test editorial split: rust eyebrow, big serif lowercase
       title on the left; rounded-2xl image card with badge on the right.
       Background tint comes from the heroSurface prop so each service
       page can pick its own accent (alternating across pages).
       ============================================================ -->
  {heroVariant === 'fullwidth' && heroImage ? (
    <section class="section sp-hero sp-hero--fullwidth">
      <img src={heroImage} alt={`${title} at MBS Medical`} class="sp-hero__bg" />
      <div class="sp-hero__overlay" aria-hidden="true"></div>
      <div class="container sp-hero__fw-container">
        <div class="sp-hero__fw-text">
          <span class="editorial-eyebrow sp-hero__fw-eyebrow">{eyebrow}</span>
          <h1 class="sp-hero__fw-title">{heroTitle}</h1>
          <p class="sp-hero__fw-sub">{heroSub}</p>
          <div class="sp-hero__actions">
            <a
              href="https://mbsmedical.practicebetter.io"
              target="_blank"
              rel="noopener noreferrer"
              class="sp-hero__cta sp-hero__fw-cta"
            >
              <span class="sp-hero__cta-rule" aria-hidden="true"></span>
              Begin consultation
            </a>
            <a href="/contact/" class="sp-hero__cta sp-hero__fw-cta sp-hero__cta--ghost">
              Ask a question
            </a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="section sp-hero" style={`background-color: ${heroSurface};`}>
      <div class="container">
        <div class="sp-hero__grid">
          <div class="sp-hero__text">
            <span class="editorial-eyebrow">{eyebrow}</span>
            <h1 class="sp-hero__title">{heroTitle}</h1>
            <p class="sp-hero__sub">{heroSub}</p>
            <div class="sp-hero__actions">
              <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="sp-hero__cta">
                <span class="sp-hero__cta-rule" aria-hidden="true"></span>
                Begin consultation
              </a>
              <a href="/contact/" class="sp-hero__cta sp-hero__cta--ghost">
                Ask a question
              </a>
            </div>
          </div>
          <div class="sp-hero__media">
            {heroImage ? (
              <div class="sp-hero__frame">
                <img src={heroImage} alt={`${title} at MBS Medical`} />
                <span class="sp-hero__badge">{chipLabel}</span>
              </div>
            ) : (
              <div class="sp-hero__frame sp-hero__frame--placeholder" role="img" aria-label={`${title} service`}>
                <span>{title.toLowerCase()} photo</span>
                <span class="sp-hero__badge">{chipLabel}</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}


  {pricing && pricing.plans.length === 1 && (
    <HeroMembershipCard eyebrow={pricing.eyebrow} plan={pricing.plans[0]} />
  )}

  {pricing && pricing.plans.length > 1 && (
    <MembershipPricing plans={pricing.plans} />
  )}


  <!-- ============================================================
       VALUE PROPS — cream surface (skipped here when
       valuesAfterFirstFeature is true; rendered between features
       [0] and [1] below instead)
       ============================================================ -->
  {!valuesAfterFirstFeature && (
    <section class="section bg-cream">
      <div class="container">
        <div class="reveal sp-values">
          {values.map((v, i) => (
            <div class={`reveal card sp-value-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
              <span class="sp-value-bar" aria-hidden="true"></span>
              <h3>{v.heading}</h3>
              <p>{v.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}



  <!-- ============================================================
       FEATURES — zigzag, alternating shell/sand. When
       valuesAfterFirstFeature is true, the values 3-up renders
       between features[0] and features[1].
       ============================================================ -->
  {features.map((f, i) => (
    <Fragment>
    {f.variant === 'fullwidth' && f.image ? (
      <section class={`section sp-feature sp-feature--fullwidth ${f.flip ? 'sp-feature--flip' : ''}`}>
        <img src={f.image} alt={f.imgAlt ?? f.heading} class="sp-feature__bg" />
        <div class="sp-feature__overlay" aria-hidden="true"></div>
        <div class="container sp-feature__fw-container">
          <div class="sp-feature__fw-text">
            <span class="editorial-eyebrow sp-feature__fw-eyebrow">{f.chipLabel ?? chipLabel}</span>
            <h2 class="sp-feature__fw-heading">{f.heading}</h2>
            <p class="sp-feature__fw-body">{f.body}</p>
            <a
              href="https://mbsmedical.practicebetter.io"
              target="_blank"
              rel="noopener noreferrer"
              class="sp-feature__fw-cta"
            >
              Get started
            </a>
          </div>
        </div>
      </section>
    ) : (
      <section class={`section sp-feature ${i % 2 === 0 ? 'bg-shell' : 'bg-cream'}`}>
        <div class="container">
          <div class={`feature-row reveal ${f.flip ? 'feature-row--flip' : ''}`}>
            <div class="feature-row__media">
              {f.scene === 'dna' ? (
                <div class="sp-feature-scene" aria-label={f.imgAlt ?? f.heading}>
                  <DnaHelix client:only="react" />
                </div>
              ) : f.scene === 'vial' ? (
                <div class="sp-feature-scene" aria-label={f.imgAlt ?? f.heading}>
                  <LabVial client:only="react" />
                </div>
              ) : f.scene === 'molecule' ? (
                <div class="sp-feature-scene" aria-label={f.imgAlt ?? f.heading}>
                  <Molecule client:only="react" />
                </div>
              ) : f.scene === 'trt-vial' ? (
                <div class="sp-feature-scene" aria-label={f.imgAlt ?? f.heading}>
                  <TrtVial client:only="react" />
                </div>
              ) : f.image ? (
                <div class="sp-feature-frame">
                  <img src={f.image} alt={f.imgAlt ?? f.heading} />
                </div>
              ) : (
                <div
                  class="sp-feature-frame sp-feature-frame--placeholder"
                  style={f.imgSurface ? `background-color: ${f.imgSurface}` : ''}
                  role="img"
                  aria-label={f.imgAlt ?? f.heading}
                >
                  <span>{(f.imgAlt ?? f.heading).toLowerCase()}</span>
                </div>
              )}
            </div>
            <div class="feature-row__text">
              <span class="editorial-eyebrow">{f.chipLabel ?? chipLabel}</span>
              <h2 class="sp-feature-heading">{f.heading}</h2>
              <p class="sp-feature-body">{f.body}</p>
              <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="sp-feature-cta">
                <span class="sp-feature-cta-rule" aria-hidden="true"></span>
                Get started
              </a>
            </div>
          </div>
        </div>
      </section>
    )}
    {valuesAfterFirstFeature && i === 0 && (
      <section class="section bg-cream">
        <div class="container">
          <div class="reveal sp-values">
            {values.map((v, vi) => (
              <div class={`reveal card sp-value-card ${vi > 0 ? `reveal-delay-${vi}` : ''}`}>
                <span class="sp-value-bar" aria-hidden="true"></span>
                <h3>{v.heading}</h3>
                <p>{v.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
    </Fragment>
  ))}


  <!-- ============================================================
       ROUND IMAGE TRIO — optional, rendered after the feature rows.
       Three round framed images with captions, centered, drifting
       orb ambient like the home mental health section.
       ============================================================ -->
  {roundImageTrio && roundImageTrio.items.length > 0 && (
    <section class="section bg-shell sp-trio">
      <div class="sp-trio__ambient" aria-hidden="true">
        <span class="sp-trio__orb sp-trio__orb--1"></span>
        <span class="sp-trio__orb sp-trio__orb--2"></span>
        <span class="sp-trio__orb sp-trio__orb--3"></span>
      </div>
      <div class="container sp-trio__container">
        <div class="reveal sp-trio__row">
          {roundImageTrio.items.map((item, idx) => (
            <figure class={`sp-trio__item sp-trio__item--${idx + 1}`}>
              <div class="sp-trio__visual">
                <img src={item.image} alt={item.label} class="sp-trio__img" loading="lazy" decoding="async" />
              </div>
              <figcaption class="sp-trio__label">{item.label}</figcaption>
            </figure>
          ))}
        </div>

        {subServices && (
          <details class="reveal sp-sub-details sp-trio__sub">
            <summary class="sp-sub-summary">
              <span class="sp-sub-summary__label">
                <span class={`accent-chip ${chipClass}`}>{chipLabel}</span>
                <span class="sp-sub-summary__heading">{subServices.heading ?? 'what we cover'}</span>
              </span>
              <span class="sp-sub-summary__toggle" aria-hidden="true">+</span>
            </summary>
            {subServices.intro && <p class="sp-sub-intro">{subServices.intro}</p>}
            <ul class="sp-sub-list" role="list">
              {subServices.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
            {subServices.disclaimer && (
              <p class="sp-sub-disclaimer">{subServices.disclaimer}</p>
            )}
          </details>
        )}
      </div>
    </section>
  )}


  <!-- ============================================================
       SUB-SERVICES — chip grid of conditions / treatments covered.
       Only renders as its own section when there's no round image
       trio above it; otherwise it merges into the trio section.
       ============================================================ -->
  {subServices && !(roundImageTrio && roundImageTrio.items.length > 0) && (
    <section class={`section ${subServices.surface ?? (features.length % 2 === 0 ? 'bg-shell' : 'bg-cream')}`}>
      <div class="container">
        <details class="reveal sp-sub-details">
          <summary class="sp-sub-summary">
            <span class="sp-sub-summary__label">
              <span class={`accent-chip ${chipClass}`}>{chipLabel}</span>
              <span class="sp-sub-summary__heading">{subServices.heading ?? 'what we cover'}</span>
            </span>
            <span class="sp-sub-summary__toggle" aria-hidden="true">+</span>
          </summary>
          {subServices.intro && <p class="sp-sub-intro">{subServices.intro}</p>}
          <ul class="sp-sub-list" role="list">
            {subServices.items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
          {subServices.disclaimer && (
            <p class="sp-sub-disclaimer">{subServices.disclaimer}</p>
          )}
        </details>
      </div>
    </section>
  )}


  <!-- ============================================================
       TESTIMONIALS — bg auto-alternates with section above. Skipped
       entirely when the testimonials array is empty.
       ============================================================ -->
  {testimonials && testimonials.length > 0 && (
    <section class={`section ${testimonialsBg}`}>
      <div class="container">
        <div class="reveal" style="margin-bottom: 3rem; text-align: center;">
          <span class="sp-section-eyebrow">Patient stories</span>
          <h2 style="margin-top: 0.75rem; font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 4.5vw, 3rem);">What patients say.</h2>
        </div>
        <div class="sp-testimonials">
          {testimonials.map((t, i) => (
            <div class={`reveal testimonial-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
              <p class="testimonial-quote">{t.quote}</p>
              <p class="testimonial-attr">{t.attr}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- ============================================================
       HOW IT WORKS — bg auto-alternates with section above
       (or, when stepsAsHero, becomes a dark image-backdrop hero
       that also absorbs the closing CTA at its bottom)
       ============================================================ -->
  {stepsAsHero ? (
    <section class={`section sp-steps-hero${stepsBackground ? ' has-bg-graph' : ''}`}>
      <img src="/images/sig-cta-dark.jpg" alt="" class="sp-steps-hero__bg" aria-hidden="true" />
      <div class="sp-steps-hero__overlay" aria-hidden="true"></div>
      {stepsBackground === 'testosterone' && <TestosteroneGraph />}
      <div class="container sp-steps-hero__container">
        <div class="reveal sp-steps-hero__header">
          <span class="label sp-steps-hero__label">how it works</span>
          <h2 class="sp-steps-hero__title">Your path to better health</h2>
        </div>
        <div class="steps-grid sp-steps-hero__steps-grid">
          {steps.map((s, i) => (
            <div class={`reveal step-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
              <h3 style="margin-bottom:0.875rem;">{s.heading}</h3>
              <p style="color:var(--ink-secondary); font-size:var(--text-sm);">{s.body}</p>
            </div>
          ))}
        </div>
        <div class="reveal sp-steps-hero__cta">
          <span class="sp-cta-eyebrow">Ready when you are</span>
          <h2 class="sp-cta-title">Let&rsquo;s build your plan.</h2>
          <p class="sp-cta-sub">Same-week telehealth across Florida. Cash pay, no insurance needed.</p>
          <div class="sp-cta-actions">
            <a
              href="https://mbsmedical.practicebetter.io"
              target="_blank"
              rel="noopener noreferrer"
              class="sp-cta-btn sp-cta-btn--primary"
            >
              book a visit
            </a>
            <a href="/contact/" class="sp-cta-btn sp-cta-btn--ghost">ask a question</a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section
      class={`section ${stepsBg}${stepsBackground ? ' has-bg-graph' : ''}`}
    >
      {stepsBackground === 'testosterone' && <TestosteroneGraph />}
      <div class="container" style={stepsBackground ? 'position: relative; z-index: 1;' : undefined}>
        <div class="reveal" style="text-align:center; margin-bottom:3.5rem;">
          <span class="label">how it works</span>
          <h2 style="margin-top:0.75rem;">Your path to better health</h2>
        </div>
        <div class="steps-grid">
          {steps.map((s, i) => (
            <div class={`reveal step-card ${i > 0 ? `reveal-delay-${i}` : ''}`}>
              <h3 style="margin-bottom:0.875rem;">{s.heading}</h3>
              <p style="color:var(--ink-secondary); font-size:var(--text-sm);">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- ============================================================
       FAQ — bg auto-alternates with section above
       Two-column: title block + Caduceus 3D on the left, accordion
       list on the right. Caduceus container is overflow: visible so
       the model can spin in without being clipped.
       ============================================================ -->
  <section class={`section ${faqBg}`} style="padding-bottom: 2rem;">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-grid__left">
          <div class="reveal faq-grid__heading">
            <h2 class="faq-grid__title">FAQ</h2>
            <p class="faq-grid__sub">
              More questions? <a href="/contact/" style="text-decoration:underline; text-underline-offset:3px;">Contact us.</a>
            </p>
          </div>
          <div class="reveal faq-grid__caduceus" aria-hidden="true">
            <FaqCaduceus client:only="react" />
          </div>
        </div>

        <div class="reveal faq-list faq-grid__list">
          {faq.map(item => (
            <details class="faq-item">
              <summary class="faq-summary">{item.q}</summary>
              <p class="faq-body">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       CTA — rounded dark card (MBS-Test signature)
       Skipped when stepsAsHero is true: the steps section absorbs it.
       ============================================================ -->
  {!stepsAsHero && (
    <section class="section sp-cta-section">
      <div class="container">
        <div class="reveal sp-cta-card">
          <img src="/images/sig-cta-dark.jpg" alt="" class="sp-cta-bg" aria-hidden="true" />
          <span class="sp-cta-deco sp-cta-deco--tr" aria-hidden="true"></span>
          <span class="sp-cta-deco sp-cta-deco--bl" aria-hidden="true"></span>
          <div class="sp-cta-inner">
            <span class="sp-cta-eyebrow">Ready when you are</span>
            <h2 class="sp-cta-title">Let&rsquo;s build your plan.</h2>
            <p class="sp-cta-sub">Same-week telehealth across Florida. Cash pay, no insurance needed.</p>
            <div class="sp-cta-actions">
              <a href="https://mbsmedical.practicebetter.io" target="_blank" rel="noopener noreferrer" class="sp-cta-btn sp-cta-btn--primary">
                book a visit
              </a>
              <a href="/contact/" class="sp-cta-btn sp-cta-btn--ghost">ask a question</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

</Layout>


<style>
  /* Section-level page-load cascade and edge-depth treatments live in
     global.css now so the same premium layering applies to every page,
     including the home page. The scoped overrides for has-bg-graph and
     hero variants below still live here. */

  /* Sections that host a decorative background graph need to be a
     positioning context so the absolutely positioned graph fills them. */
  .section.has-bg-graph {
    position: relative;
    overflow: hidden;
  }

  /* ---- Steps as Hero (merged with closing CTA) ----
     A single section that pairs the "how it works" content with the
     closing CTA. Dark image backdrop sits behind a dark gradient
     overlay, with the animated graph (when stepsBackground is set)
     layered over the overlay but under the content. */
  .sp-steps-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-primary);
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -60px 90px -40px rgba(0, 0, 0, 0.45),
      inset 0 50px 90px -40px rgba(0, 0, 0, 0.30);
  }
  .sp-steps-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.5;
    filter: grayscale(20%) contrast(1.02);
    z-index: 0;
  }
  .sp-steps-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(60, 56, 54, 0.85) 0%,
      rgba(60, 56, 54, 0.65) 45%,
      rgba(60, 56, 54, 0.85) 100%
    );
    z-index: 1;
  }
  .sp-steps-hero__container {
    position: relative;
    z-index: 3;
  }
  .sp-steps-hero__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .sp-steps-hero__label {
    color: rgba(255, 255, 255, 0.62);
  }
  .sp-steps-hero__title {
    color: #ffffff;
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .sp-steps-hero__steps-grid {
    /* Inherits steps-grid layout from global CSS — nothing to override */
  }
  /* Top-align card content so every heading starts at the same height,
     regardless of body copy length. */
  .sp-steps-hero .step-card {
    justify-content: flex-start;
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .sp-steps-hero .step-card:nth-child(2) {
    background-color: rgba(125, 140, 123, 0.86);
  }
  .sp-steps-hero .step-card:nth-child(3) {
    background-color: rgba(60, 56, 54, 0.82);
  }
  .sp-steps-hero .step-card:nth-child(4) {
    background-color: rgba(234, 231, 224, 0.86);
  }
  .sp-steps-hero__cta {
    margin-top: clamp(4rem, 7vw, 6rem);
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  /* The TestosteroneGraph component sits between the overlay and the
     content. `:global` because Astro scopes ServicePage's CSS to a
     different class hash than TestosteroneGraph's. */
  .sp-steps-hero :global(.t-graph) {
    z-index: 2;
    color: var(--color-neutral);
    /* Lift the graph upward so its arc starts and ends higher in the
       section instead of aligning to the vertical center. */
    align-items: flex-start;
    padding-top: clamp(1rem, 2vw, 2rem);
    transform: translateY(-10%);
  }
  .sp-steps-hero :global(.t-line) {
    opacity: 0.38;
  }
  .sp-steps-hero :global(.t-dots circle) {
    fill: #A78428;
    stroke: none;
  }

  /* ---- Round image trio with drifting orb ambient ---- */
  .sp-trio {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .sp-trio__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .sp-trio__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.38;
    will-change: transform;
  }
  .sp-trio__orb--1 {
    width: clamp(320px, 36vw, 520px);
    aspect-ratio: 1;
    background: var(--color-accent);
    top: 8%;
    left: 4%;
    animation: sp-trio-orb-1 16s ease-in-out infinite;
  }
  .sp-trio__orb--2 {
    width: clamp(360px, 40vw, 580px);
    aspect-ratio: 1;
    background: var(--color-rust);
    top: 28%;
    right: 4%;
    animation: sp-trio-orb-2 20s ease-in-out infinite;
  }
  .sp-trio__orb--3 {
    width: clamp(280px, 30vw, 440px);
    aspect-ratio: 1;
    background: #B8956A;
    bottom: 4%;
    left: 36%;
    animation: sp-trio-orb-3 18s ease-in-out infinite;
  }
  @keyframes sp-trio-orb-1 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(60px, 40px); }
  }
  @keyframes sp-trio-orb-2 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(-80px, 60px); }
  }
  @keyframes sp-trio-orb-3 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(40px, -50px); }
  }
  .sp-trio__container {
    position: relative;
    z-index: 1;
  }
  .sp-trio__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  .sp-trio__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    margin: 0;
  }
  .sp-trio__visual {
    position: relative;
    width: clamp(180px, 18vw, 240px);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sp-trio__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.85);
    box-shadow:
      0 16px 28px -16px rgba(60, 56, 54, 0.28),
      0 6px 12px -8px rgba(60, 56, 54, 0.16);
  }
  .sp-trio__label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .sp-trio__sub {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .sp-trio__orb {
      animation: none;
    }
  }

  /* ---- Service hero (full-bleed image variant) ----
     Used when heroVariant === 'fullwidth'. The image fills the section,
     a left-weighted gradient gives the text room to breathe, and the
     existing text classes get overridden for white-on-dark display. */
  .sp-hero--fullwidth {
    padding: 0;
    min-height: 62vh;
    background-color: var(--color-primary);
  }
  .sp-hero--fullwidth::before,
  .sp-hero--fullwidth::after {
    display: none;
  }
  .sp-hero--fullwidth .sp-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .sp-hero--fullwidth .sp-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(60, 56, 54, 0.72) 0%,
      rgba(60, 56, 54, 0.45) 35%,
      rgba(60, 56, 54, 0.10) 65%,
      rgba(60, 56, 54, 0) 100%
    );
    z-index: 1;
  }
  .sp-hero__fw-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 62vh;
    padding-top: 7rem;
    padding-bottom: 4rem;
  }
  .sp-hero__fw-text {
    max-width: 42rem;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  /* Rust eyebrow against a dark photo overlay fails WCAG AA at small
     tracker sizes. Switch to a warm cream that hits ~14:1 contrast. */
  .sp-hero__fw-eyebrow {
    color: var(--color-neutral);
  }
  .sp-hero__fw-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.5rem, 5.4vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }
  .sp-hero__fw-sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.85);
    max-width: 52ch;
    margin: 0;
  }
  /* Convert the editorial-tracker CTAs into proper pill buttons for the
     full-bleed hero. Scoped under `.sp-hero--fullwidth` for specificity so
     these win over the base `.sp-hero__cta` defined below (which sets
     `padding: 0` and keeps the hairline rule visible). */
  .sp-hero--fullwidth .sp-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 17px 38px;
    border-radius: 999px;
    border: 1.5px solid transparent;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
    white-space: nowrap;
  }
  .sp-hero--fullwidth .sp-hero__cta-rule {
    display: none;
  }
  .sp-hero--fullwidth .sp-hero__cta:not(.sp-hero__cta--ghost) {
    background-color: #ffffff;
    color: var(--color-primary);
    border-color: #ffffff;
  }
  .sp-hero--fullwidth .sp-hero__cta:not(.sp-hero__cta--ghost):hover {
    background-color: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }
  .sp-hero--fullwidth .sp-hero__cta.sp-hero__cta--ghost {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.92);
    border-color: rgba(255, 255, 255, 0.55);
  }
  .sp-hero--fullwidth .sp-hero__cta.sp-hero__cta--ghost:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: #ffffff;
    border-color: #ffffff;
  }
  .sp-hero--fullwidth .sp-hero__cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }
  .sp-hero--fullwidth .sp-hero__actions {
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  @media (max-width: 767px) {
    .sp-hero--fullwidth {
      min-height: 60vh;
    }
    .sp-hero__fw-container {
      min-height: 60vh;
      padding-top: 6rem;
      padding-bottom: 3rem;
    }
  }

  /* ---- Service hero (MBS-Test editorial split) ---- */
  .sp-hero {
    /* background-color set inline via heroSurface prop */
    padding-top: 6rem;
    padding-bottom: 1rem;
    /* No min-height — let content drive height. The 92vh that used to be
       here was forcing the hero to stretch the full viewport even when
       the title + intro + image were ~600px, creating dead padding
       below the content. */
    display: block;
    position: relative;
    overflow: hidden;
    /* Edge depth applied to every hero variant: drop shadow under, and
       a layered inset fade on top/bottom/sides so the section reads
       with dimension rather than as a flat band of color. Calibrated
       light here because the editorial hero usually sits on a tinted
       cream background; the fullwidth override below punches harder.
       Hairline borders top/bottom match the framed treatment used on
       the values, testimonials, and faq sections. */
    box-shadow:
      0 24px 48px -26px rgba(60, 56, 54, 0.28),
      inset 0 1px 0 rgba(60, 56, 54, 0.10),
      inset 0 -1px 0 rgba(60, 56, 54, 0.10),
      inset 0 -50px 80px -50px rgba(60, 56, 54, 0.14),
      inset 0 40px 70px -50px rgba(60, 56, 54, 0.08),
      inset 80px 0 80px -90px rgba(60, 56, 54, 0.10),
      inset -80px 0 80px -90px rgba(60, 56, 54, 0.10);
  }
  .sp-hero--fullwidth {
    /* Vignette + light hairline for the dark photo hero (white rgba so
       the hairline reads against the dark backdrop). */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -80px 110px -40px rgba(0, 0, 0, 0.55),
      inset 0 60px 110px -40px rgba(0, 0, 0, 0.35),
      inset 100px 0 120px -80px rgba(0, 0, 0, 0.4),
      inset -100px 0 120px -80px rgba(0, 0, 0, 0.4),
      0 24px 48px -28px rgba(0, 0, 0, 0.35);
  }
  .sp-feature--fullwidth {
    /* Same vignette + light hairline treatment so feature heroes feel
       cohesive with the main hero. */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 rgba(255, 255, 255, 0.10),
      inset 0 -70px 100px -40px rgba(0, 0, 0, 0.5),
      inset 0 50px 100px -40px rgba(0, 0, 0, 0.3),
      inset 90px 0 110px -80px rgba(0, 0, 0, 0.35),
      inset -90px 0 110px -80px rgba(0, 0, 0, 0.35),
      0 22px 42px -28px rgba(0, 0, 0, 0.32);
  }
  .sp-hero::before,
  .sp-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(60,56,54,0.06);
    pointer-events: none;
  }
  .sp-hero::before {
    width: 360px; height: 360px;
    top: 50%; left: -120px;
    transform: translateY(-50%);
    border-style: dashed;
  }
  .sp-hero::after {
    width: 480px; height: 480px;
    bottom: -240px; right: -120px;
  }
  .sp-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    /* Text column wider (7) than image column (5) so the pricing card
       has room to breathe; image stays editorial but doesn't dominate. */
    .sp-hero__grid { grid-template-columns: 7fr 5fr; gap: 3.5rem; }
  }
  .sp-hero__text { display: flex; flex-direction: column; gap: 1.75rem; }
  .sp-hero__title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin: 0;
  }
  .sp-hero__sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
    max-width: 48ch;
    margin: 0;
  }
  .sp-hero__plan {
    margin-top: 0.75rem;
    /* Fill the text column so the card visually anchors to the title above
       instead of floating as a narrower object. */
    width: 100%;
  }
  .sp-hero__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .sp-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 200ms ease;
    background: transparent;
    border: none;
    padding: 0;
  }
  .sp-hero__cta:hover { color: var(--color-rust); }
  .sp-hero__cta-rule {
    display: inline-block;
    width: 48px;
    height: 1px;
    background-color: currentColor;
    transition: width 250ms ease;
  }
  .sp-hero__cta:hover .sp-hero__cta-rule { width: 80px; }
  .sp-hero__cta--ghost { color: var(--color-tertiary); }

  /* Image card with rounded-2xl + small uppercase badge bottom-left */
  .sp-hero__media { position: relative; }
  .sp-hero__frame {
    position: relative;
    width: 100%;
    /* 4:5 portrait was too tall — created big empty vertical space next to
       text+card. 5:6 is closer to square and feels balanced against the
       stacked text column. */
    aspect-ratio: 5/6;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
  }
  .sp-hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }
  .sp-hero__frame:hover img { transform: scale(1.04); }
  .sp-hero__frame--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .sp-hero__badge {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  @media (max-width: 767px) {
    .sp-hero { padding-top: 5rem; padding-bottom: 0.75rem; }
    .sp-hero__frame { aspect-ratio: 16/10; }
    .sp-hero__badge { bottom: 1rem; left: 1rem; }
  }

  /* ---- Feature row (full-bleed image variant) ----
     Used when feature.variant === 'fullwidth'. Same shape as the full-bleed
     hero: image fills the section, dark gradient overlay anchored opposite
     the text column, text in a max-width column with pill CTA. */
  .sp-feature--fullwidth {
    position: relative;
    padding: 0;
    min-height: 50vh;
    overflow: hidden;
    background-color: var(--color-primary);
  }
  .sp-feature--fullwidth .sp-feature__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .sp-feature--fullwidth .sp-feature__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(60, 56, 54, 0.72) 0%,
      rgba(60, 56, 54, 0.45) 35%,
      rgba(60, 56, 54, 0.10) 65%,
      rgba(60, 56, 54, 0) 100%
    );
    z-index: 1;
  }
  .sp-feature--fullwidth.sp-feature--flip .sp-feature__overlay {
    background: linear-gradient(
      260deg,
      rgba(60, 56, 54, 0.72) 0%,
      rgba(60, 56, 54, 0.45) 35%,
      rgba(60, 56, 54, 0.10) 65%,
      rgba(60, 56, 54, 0) 100%
    );
  }
  .sp-feature__fw-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 50vh;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }
  .sp-feature--flip .sp-feature__fw-container {
    justify-content: flex-end;
    padding-right: clamp(2rem, 4vw, 4rem);
  }
  .sp-feature__fw-text {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  /* Flip variant: column sits to the right side of the section but with
     enough horizontal room that the heading and body don't have to
     squish into a narrow column. */
  .sp-feature--flip .sp-feature__fw-text {
    max-width: 34rem;
    margin-right: 0;
  }
  .sp-feature--flip .sp-feature__fw-heading {
    max-width: 20ch;
  }
  .sp-feature--flip .sp-feature__fw-body {
    max-width: 44ch;
  }
  .sp-feature__fw-eyebrow {
    color: var(--color-neutral);
  }
  .sp-feature__fw-heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.018em;
    color: #ffffff;
    margin: 0;
    max-width: 22ch;
  }
  .sp-feature__fw-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.85);
    max-width: 52ch;
    margin: 0;
  }
  .sp-feature__fw-cta {
    align-self: flex-start;
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px 34px;
    border-radius: 999px;
    border: 1.5px solid #ffffff;
    background-color: transparent;
    color: #ffffff;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    white-space: nowrap;
  }
  .sp-feature__fw-cta:hover {
    background-color: #ffffff;
    color: var(--color-primary);
  }
  .sp-feature__fw-cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }
  @media (max-width: 767px) {
    .sp-feature--fullwidth {
      min-height: 42vh;
    }
    .sp-feature__fw-container {
      min-height: 42vh;
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }
  }

  /* ---- Feature row (MBS-Test editorial split with rounded-2xl frame) ---- */
  .sp-feature {
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }
  /* Free-standing 3D scene slot — same footprint as the image frame but no
     visible card, transparent background, rendered by an R3F island. */
  .sp-feature-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background-color: transparent;
    border: 0;
    overflow: visible;
    transform-origin: center center;
    will-change: transform, opacity;
  }
  @media (max-width: 767px) {
    .sp-feature-scene { aspect-ratio: 4/3; }
  }

  /* Wrapper handles only an opacity fade — cheap on the GPU since it
     doesn't force the canvas layer to re-rasterize. The "grow into
     frame" scale animation is owned by each R3F scene component
     (Cluster in Molecule.tsx, etc.), driven by useFrame in 3D space.
     This avoids the well-known choppiness of CSS-transforming a live
     canvas wrapper. */
  .sp-feature-scene {
    opacity: 0.4;
    transition: opacity 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sp-feature-scene.is-focused {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-feature-scene {
      opacity: 1;
      transition: none;
    }
  }
  .sp-feature-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
  }
  .sp-feature-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }
  .sp-feature-frame:hover img { transform: scale(1.04); }
  .sp-feature-frame--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  @media (max-width: 767px) {
    .sp-feature-frame { aspect-ratio: 4/3; }
  }

  .sp-feature-heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    margin: 1.25rem 0 1.25rem;
    max-width: 18ch;
  }
  .sp-feature-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
    max-width: 50ch;
    margin-bottom: 2.25rem;
  }
  .sp-feature-cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .sp-feature-cta:hover { color: var(--color-rust); }
  .sp-feature-cta-rule {
    display: inline-block;
    width: 48px;
    height: 1px;
    background-color: currentColor;
    transition: width 250ms ease;
  }
  .sp-feature-cta:hover .sp-feature-cta-rule { width: 80px; }

  .sp-feature-img {
    border-radius: var(--radius-xl);
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
