---
/**
 * Membership price line for the service-page hero — text-only, no box.
 *
 * Editorial treatment: hairline rule above, rust uppercase eyebrow,
 * plan name + serif-numerals price on one row, tagline beneath, and
 * a hairline-rule "Start membership" link matching the rest of the
 * hero CTA pattern. Reads as part of the typography, not a card
 * sitting on top of the layout.
 */

interface Plan {
  name: string;
  price: string;
  period?: string;
  tagline: string;
  includes: string[];        // kept for API parity; rendered as a single inline credit-roll
  cta?: { label: string; href: string };
  note?: string;
}

interface Props {
  eyebrow?: string;
  plan: Plan;
}

const { eyebrow = 'Membership', plan } = Astro.props as Props;

const DEFAULT_CTA = {
  label: 'Start membership',
  href: 'https://mbsmedical.practicebetter.io',
};
const DEFAULT_NOTE = 'Cancel anytime · 10% off annual';

const cta = plan.cta ?? DEFAULT_CTA;
const note = plan.note ?? DEFAULT_NOTE;
---

<div class="hero-priceline">
  <hr class="hero-priceline__rule" aria-hidden="true" />

  <span class="hero-priceline__eyebrow">{eyebrow}</span>

  <div class="hero-priceline__row">
    <span class="hero-priceline__name">{plan.name}</span>
    <span class="hero-priceline__price">
      {plan.price}<span class="hero-priceline__period">/ {plan.period ?? 'month'}</span>
    </span>
  </div>

  <p class="hero-priceline__tagline">{plan.tagline}</p>

  {plan.includes && plan.includes.length > 0 && (
    <p class="hero-priceline__includes">
      {plan.includes.map((item, i) => (
        <>
          {i > 0 && <span class="hero-priceline__dot" aria-hidden="true">·</span>}
          <span>{item}</span>
        </>
      ))}
    </p>
  )}

  <div class="hero-priceline__foot">
    <a
      href={cta.href}
      target={cta.href.startsWith('http') ? '_blank' : undefined}
      rel={cta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
      class="hero-priceline__cta"
    >
      <span class="hero-priceline__cta-rule" aria-hidden="true"></span>
      {cta.label}
    </a>
    <span class="hero-priceline__note">{note}</span>
  </div>
</div>

<style>
  .hero-priceline {
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    width: 100%;
  }
  .hero-priceline__rule {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 0 1.25rem;
    width: 64px;
  }

  .hero-priceline__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: 0.625rem;
  }

  .hero-priceline__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .hero-priceline__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-primary);
  }
  .hero-priceline__price {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    white-space: nowrap;
  }
  .hero-priceline__period {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-secondary);
    font-weight: var(--weight-medium);
    text-transform: lowercase;
    margin-left: 0.375rem;
    letter-spacing: 0;
  }

  .hero-priceline__tagline {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-secondary);
    margin: 0 0 0.75rem;
    max-width: 52ch;
  }

  .hero-priceline__includes {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    line-height: 1.9;
    margin: 0;
    max-width: 60ch;
  }
  .hero-priceline__includes > span:not(.hero-priceline__dot) {
    display: inline-block;
    white-space: nowrap;
  }
  .hero-priceline__dot {
    display: inline;
    margin: 0 0.5rem;
    color: var(--color-rust);
    font-weight: var(--weight-bold);
    opacity: 0.7;
  }

  .hero-priceline__foot {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
  .hero-priceline__cta {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .hero-priceline__cta:hover { color: var(--color-rust); }
  .hero-priceline__cta-rule {
    display: inline-block;
    width: 48px;
    height: 1px;
    background-color: currentColor;
    transition: width 250ms ease;
  }
  .hero-priceline__cta:hover .hero-priceline__cta-rule { width: 80px; }

  .hero-priceline__note {
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-tertiary);
  }
</style>
